digraph IterationImplementation {
    graph [
        goal="Implement the iteration plan at {{ inputs.plan_path }} and leave the codebase passing dev check",
        default_fidelity="summary:high",
        max_node_visits=80,
        model_stylesheet="
            * { reasoning_effort: high; }
            #read_plan { reasoning_effort: low; }
            #sync_task_list { model: gpt-5.3-codex; reasoning_effort: high; }
            #implement_task { model: gpt-5.3-codex; reasoning_effort: high; }
            #validate_task { model: claude-opus-4-6; reasoning_effort: high; }
            #fix_task { model: gpt-5.3-codex; reasoning_effort: high; }
            #mark_task_done { model: gpt-5.3-codex; reasoning_effort: high; }
            #fix_dev_check { model: gpt-5.3-codex; reasoning_effort: high; }
            #plan_conformance_gate { model: claude-opus-4-6; reasoning_effort: high; }
            #fix_plan_conformance { model: gpt-5.3-codex; reasoning_effort: high; }
            #adr_coherence_gate { model: claude-opus-4-6; reasoning_effort: high; }
            #fix_adr_coherence { model: gpt-5.3-codex; reasoning_effort: high; }
            #claude_review { model: claude-sonnet-4-5; reasoning_effort: high; }
            #codex_review { model: gpt-5.3-codex; reasoning_effort: high; }
            #gemini_review { model: gemini-3.1-pro-preview; reasoning_effort: high; }
            #synthesize_review { model: claude-opus-4-6; reasoning_effort: high; }
            #apply_review_fixes { model: gpt-5.3-codex; reasoning_effort: high; }
            #final_summary { reasoning_effort: low; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    read_plan [
        label="Read Iteration Plan",
        shape=parallelogram,
        script="PLAN_PATH='{{ inputs.plan_path }}'\nif [ ! -f \"$PLAN_PATH\" ]; then\n  echo \"Iteration plan not found: $PLAN_PATH\" >&2\n  exit 1\nfi\nprintf 'PLAN_PATH=%s\\n\\n' \"$PLAN_PATH\"\nline_count=0\nwhile IFS= read -r line && [ \"$line_count\" -lt 320 ]; do\n  printf '%s\\n' \"$line\"\n  line_count=$((line_count + 1))\ndone < \"$PLAN_PATH\""
    ]

    read_failed [
        label="Fail: Plan Missing",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration implementation failed: the plan file could not be read. Pass -I plan_path=docs/iterations/NNN-topic/plan.md and ensure it is committed/pushed for remote sandboxes.' >&2\nexit 1"
    ]

    preflight_sandbox [
        label="Preflight Sandbox Toolchain",
        shape=parallelogram,
        script="set -eu\nif [ ! -x bin/dev ]; then\n  echo \"Missing or non-executable bin/dev\" >&2\n  exit 1\nfi\nPATH=\"$PWD/bin:$PATH\" dev sandbox-check", 
        timeout="600s"
    ]

    preflight_failed [
        label="Fail: Sandbox Preflight",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration implementation failed before coding: the sandbox/toolchain preflight did not pass. Fix the Fabro environment or image, then retry.' >&2\nexit 1"
    ]

    sync_task_list [
        label="Sync Task List",
        shape=parallelogram,
        script="set -eu\nPLAN_PATH='{{ inputs.plan_path }}'\ncase \"$PLAN_PATH\" in\n  */plan.md) ITERATION_DIR=${PLAN_PATH%/plan.md} ;;\n  *) echo \"plan_path must end with /plan.md: $PLAN_PATH\" >&2; exit 1 ;;\nesac\nTODO_PATH=\"$ITERATION_DIR/todo.md\"\nmkdir -p .fabro/tmp\nif [ ! -f \"$TODO_PATH\" ]; then\n  tmp=.fabro/tmp/generated-todo.md\n  {\n    printf '# Implementation TODO\\n\\n'\n    in_plan=0\n    count=0\n    while IFS= read -r line; do\n      case \"$line\" in\n        '## Implementation Plan') in_plan=1; continue ;;\n        '## '*) if [ \"$in_plan\" -eq 1 ]; then break; fi ;;\n      esac\n      if [ \"$in_plan\" -eq 1 ]; then\n        case \"$line\" in\n          [0-9]*'. '*)\n            count=$((count + 1))\n            task=${line#*. }\n            printf -- '- [ ] %03d %s\\n' \"$count\" \"$task\"\n            ;;\n        esac\n      fi\n    done < \"$PLAN_PATH\"\n    if [ \"${count:-0}\" -eq 0 ]; then\n      echo \"No numbered tasks found under ## Implementation Plan in $PLAN_PATH\" >&2\n      exit 1\n    fi\n  } > \"$tmp\"\n  mkdir -p \"$ITERATION_DIR\"\n  mv \"$tmp\" \"$TODO_PATH\"\n  echo \"Created $TODO_PATH from $PLAN_PATH\"\nelse\n  echo \"Using existing $TODO_PATH\"\nfi\nprintf 'PLAN_PATH=%s\\nTODO_PATH=%s\\n' \"$PLAN_PATH\" \"$TODO_PATH\"\nsed -n '1,120p' \"$TODO_PATH\"",
        timeout="120s"
    ]

    pick_next_task [
        label="Pick Next Task",
        shape=parallelogram,
        script="set -eu\nPLAN_PATH='{{ inputs.plan_path }}'\ncase \"$PLAN_PATH\" in\n  */plan.md) ITERATION_DIR=${PLAN_PATH%/plan.md} ;;\n  *) echo \"plan_path must end with /plan.md: $PLAN_PATH\" >&2; exit 1 ;;\nesac\nTODO_PATH=\"$ITERATION_DIR/todo.md\"\nif [ ! -f \"$TODO_PATH\" ]; then\n  echo \"Todo file not found after sync: $TODO_PATH\" >&2\n  exit 1\nfi\nmkdir -p .fabro/tmp\ntask=$(grep -n -m 1 -E '^[[:space:]]*- \\[ \\] ' \"$TODO_PATH\" || true)\nif [ -z \"$task\" ]; then\n  echo \"No unchecked tasks remain in $TODO_PATH.\"\n  exit 1\nfi\nprintf '%s\n' \"$task\" > .fabro/tmp/selected-task.txt\nprintf 'PLAN_PATH=%s\nTODO_PATH=%s\nSELECTED_TASK=%s\n' \"$PLAN_PATH\" \"$TODO_PATH\" \"$task\""
    ]

    all_tasks_done [
        label="Check All Tasks Done",
        shape=parallelogram,
        script="set -eu
PLAN_PATH='{{ inputs.plan_path }}'
case \"$PLAN_PATH\" in
  */plan.md) ITERATION_DIR=${PLAN_PATH%/plan.md} ;;
  *) echo \"plan_path must end with /plan.md: $PLAN_PATH\" >&2; exit 1 ;;
esac
TODO_PATH=\"$ITERATION_DIR/todo.md\"
if [ ! -f \"$TODO_PATH\" ]; then
  echo \"Todo file not found after sync: $TODO_PATH\" >&2
  exit 1
fi
if grep -q -E '^[[:space:]]*- \[ \] ' \"$TODO_PATH\"; then
  echo \"Unchecked tasks remain in $TODO_PATH.\"
  exit 1
fi
echo \"All iteration tasks are checked off in $TODO_PATH. Continuing to whole-iteration gates.\""
    ]

    implement_task [
        label="Implement Selected Task",
        prompt="@prompts/implement_task.md",
        timeout="2400s"
    ]

    validate_task [
        label="Validate Selected Task",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/validate_task.md"
    ]

    task_gate [shape=diamond, label="Task valid?"]

    fix_task [
        label="Fix Selected Task",
        prompt="@prompts/fix_task.md",
        timeout="1800s",
        max_visits=3
    ]

    mark_task_done [
        label="Mark Task Done",
        prompt="@prompts/mark_task_done.md",
        timeout="600s"
    ]

    commit_task [
        label="Commit Completed Task",
        shape=parallelogram,
        script="set -eu\nPLAN_PATH='{{ inputs.plan_path }}'\ncase \"$PLAN_PATH\" in\n  */plan.md) ITERATION_DIR=${PLAN_PATH%/plan.md} ;;\n  *) echo \"plan_path must end with /plan.md: $PLAN_PATH\" >&2; exit 1 ;;\nesac\nTODO_PATH=\"$ITERATION_DIR/todo.md\"\nSELECTED_TASK=$(cat .fabro/tmp/selected-task.txt)\nif git status --short | grep -E '\\.feature$'; then\n  echo 'Refusing to commit locked acceptance feature file changes.' >&2\n  exit 1\nfi\nif [ ! -s \"$TODO_PATH\" ]; then\n  echo \"Todo file is missing or empty: $TODO_PATH\" >&2\n  exit 1\nfi\nif [ -z \"$(git status --short)\" ]; then\n  echo 'No changes to commit for completed task.' >&2\n  exit 1\nfi\ngit add -A\ngit reset -q -- .fabro/tmp 2>/dev/null || true\nif git diff --cached --name-only | grep -E '\\.feature$'; then\n  echo 'Refusing to commit locked acceptance feature file changes.' >&2\n  git reset -q\n  exit 1\nfi\nstat=$(git diff --cached --stat || true)\nfiles=$(git diff --cached --name-only || true)\nsubject=$(printf '%s' \"$SELECTED_TASK\" | sed -E 's/^[0-9]+:[[:space:]]*- \\[ \\] [0-9]*[[:space:]]*//; s/^[0-9]+:[[:space:]]*- \\[x\\] [0-9]*[[:space:]]*//; s/[^A-Za-z0-9._ -]/ /g' | cut -c1-60)\n[ -n \"$subject\" ] || subject='selected task'\nmsg_file=.fabro/tmp/task-commit-message.txt\n{\n  printf 'Implement iteration task: %s\\n\\n' \"$subject\"\n  printf 'Plan: %s\\n' \"$PLAN_PATH\"\n  printf 'Todo: %s\\n' \"$TODO_PATH\"\n  printf 'Selected task: %s\\n\\n' \"$SELECTED_TASK\"\n  printf 'Evidence files changed:\\n%s\\n\\n' \"$files\"\n  printf 'Diff stat:\\n%s\\n' \"$stat\"\n} > \"$msg_file\"\ngit commit -F \"$msg_file\"\nrm -f .fabro/tmp/selected-task.txt .fabro/tmp/task-commit-message.txt\ngit status --short"
    ]

    task_not_ready [
        label="Fail: Task Needs Human Input",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration implementation failed: selected task validation requires human input or exceeded automatic repair budget.' >&2\nexit 1"
    ]

    dev_check [
        label="Run Dev Check",
        shape=parallelogram,
        script="PATH=\"$PWD/bin:$PATH\" dev ci",
        timeout="1800s"
    ]

    fix_dev_check [
        label="Fix Dev Check Failures",
        prompt="@prompts/fix_dev_check.md",
        timeout="2400s",
        max_visits=3
    ]

    plan_conformance_gate [
        label="Plan Conformance Gate",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/plan_conformance_gate.md"
    ]

    plan_gate [
        shape=diamond,
        label="Plan conformant?"
    ]

    snapshot_before_plan_repair [
        label="Snapshot Before Plan Repair",
        shape=parallelogram,
        script="set -eu\nmkdir -p .fabro/tmp\nkind='plan'\ngit diff --binary > \".fabro/tmp/${kind}-repair-before.patch\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-before-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-before-stat.txt\" || true\nprintf 'Repair baseline (%s) captured.\\n' \"$kind\""
    ]

    fix_plan_conformance [
        label="Fix Plan Conformance",
        prompt="@prompts/fix_plan_conformance.md",
        timeout="2400s",
        max_visits=2
    ]

    verify_plan_repair [
        label="Verify Plan Repair",
        shape=parallelogram,
        script="set -eu\nkind='plan'\nbefore=\".fabro/tmp/${kind}-repair-before.patch\"\nafter=\".fabro/tmp/${kind}-repair-after.patch\"\ngit diff --binary > \"$after\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-after-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-after-stat.txt\" || true\nprintf 'Repair baseline (%s) captured in %s\\n' \"$kind\" \"$before\"\nprintf 'Repair after    (%s) captured in %s\\n' \"$kind\" \"$after\"\nprintf 'Changed files after repair:\\n'\ngit diff --name-only\nif cmp -s \"$before\" \"$after\"; then\n  echo \"${kind} repair produced no working-tree diff change since repair started.\" >&2\n  echo \"If no code/config/test changes were required, route to human input or make the repair prompt explicitly justify that case.\" >&2\n  exit 1\nfi\nif git diff --name-only | grep -E '\\.feature$'; then\n  echo \"Repair modified locked acceptance feature files.\" >&2\n  exit 1\nfi"
    ]

    plan_not_ready [
        label="Fail: Needs Human Plan Review",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration implementation failed: plan conformance gate found violations that require human input or exceeded the automatic plan repair budget.' >&2\nexit 1"
    ]

    adr_coherence_gate [
        label="ADR Coherence Gate",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/adr_coherence_gate.md"
    ]

    adr_gate [shape=diamond, label="ADR coherent?"]

    snapshot_before_adr_repair [
        label="Snapshot Before ADR Repair",
        shape=parallelogram,
        script="set -eu\nmkdir -p .fabro/tmp\nkind='adr'\ngit diff --binary > \".fabro/tmp/${kind}-repair-before.patch\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-before-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-before-stat.txt\" || true\nprintf 'Repair baseline (%s) captured.\\n' \"$kind\""
    ]

    fix_adr_coherence [
        label="Fix ADR Coherence",
        prompt="@prompts/fix_adr_coherence.md",
        timeout="2400s",
        max_visits=2
    ]

    verify_adr_repair [
        label="Verify ADR Repair",
        shape=parallelogram,
        script="set -eu\nkind='adr'\nbefore=\".fabro/tmp/${kind}-repair-before.patch\"\nafter=\".fabro/tmp/${kind}-repair-after.patch\"\ngit diff --binary > \"$after\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-after-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-after-stat.txt\" || true\nprintf 'Repair baseline (%s) captured in %s\\n' \"$kind\" \"$before\"\nprintf 'Repair after    (%s) captured in %s\\n' \"$kind\" \"$after\"\nprintf 'Changed files after repair:\\n'\ngit diff --name-only\nif cmp -s \"$before\" \"$after\"; then\n  echo \"${kind} repair produced no working-tree diff change since repair started.\" >&2\n  echo \"If no code/config/test changes were required, route to human input or make the repair prompt explicitly justify that case.\" >&2\n  exit 1\nfi\nif git diff --name-only | grep -E '\\.feature$'; then\n  echo \"Repair modified locked acceptance feature files.\" >&2\n  exit 1\nfi"
    ]

    adr_not_ready [
        label="Fail: Needs Human ADR Review",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration implementation failed: ADR coherence gate found violations that require human input or exceeded the automatic ADR repair budget.' >&2\nexit 1"
    ]

    review_fork [label="Independent Implementation Reviews", shape=component, join_policy="wait_all", max_parallel=3]

    claude_review [
        label="Claude Review",
        shape=tab,
        prompt="@prompts/review.md"
    ]

    codex_review [
        label="Codex/GPT Review",
        shape=tab,
        prompt="@prompts/review.md"
    ]

    gemini_review [
        label="Gemini Review",
        shape=tab,
        prompt="@prompts/review.md"
    ]

    review_merge [label="Merge Reviews", shape=tripleoctagon]

    synthesize_review [
        label="Synthesize Review",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/synthesize_review.md"
    ]

    review_gate [shape=diamond, label="Implementation accepted?"]

    snapshot_before_review_repair [
        label="Snapshot Before Review Repair",
        shape=parallelogram,
        script="set -eu\nmkdir -p .fabro/tmp\nkind='review'\ngit diff --binary > \".fabro/tmp/${kind}-repair-before.patch\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-before-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-before-stat.txt\" || true\nprintf 'Repair baseline (%s) captured.\\n' \"$kind\""
    ]

    apply_review_fixes [
        label="Apply Review Fixes",
        prompt="@prompts/apply_review_fixes.md",
        timeout="2400s",
        max_visits=3
    ]

    verify_review_repair [
        label="Verify Review Repair",
        shape=parallelogram,
        script="set -eu\nkind='review'\nbefore=\".fabro/tmp/${kind}-repair-before.patch\"\nafter=\".fabro/tmp/${kind}-repair-after.patch\"\ngit diff --binary > \"$after\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-after-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-after-stat.txt\" || true\nprintf 'Repair baseline (%s) captured in %s\\n' \"$kind\" \"$before\"\nprintf 'Repair after    (%s) captured in %s\\n' \"$kind\" \"$after\"\nprintf 'Changed files after repair:\\n'\ngit diff --name-only\nif cmp -s \"$before\" \"$after\"; then\n  echo \"${kind} repair produced no working-tree diff change since repair started.\" >&2\n  echo \"If no code/config/test changes were required, route to human input or make the repair prompt explicitly justify that case.\" >&2\n  exit 1\nfi\nif git diff --name-only | grep -E '\\.feature$'; then\n  echo \"Repair modified locked acceptance feature files.\" >&2\n  exit 1\nfi"
    ]

    not_ready [
        label="Fail: Needs Human Review",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration implementation failed: reviewers found blocking issues that require human input or exceeded the automatic repair budget.' >&2\nexit 1"
    ]

    final_artifact_gate [
        label="Final Artifact Gate",
        shape=parallelogram,
        script="set -eu\necho '=== Final Artifact Gate ==='\necho ''\necho 'Checking for implementation artifact evidence...'\necho ''\n\n# Strategy: prefer git base/head comparison over working-tree dirtiness alone,\n# since Fabro may checkpoint changes between nodes.\n\n# 1. Check working tree status first (may be clean if already checkpointed)\nstatus=$(git status --short)\nif [ -n \"$status\" ]; then\n  echo \"Working tree changes still present:\"\n  printf '%s\\n' \"$status\"\n  echo ''\nelse\n  echo \"Working tree is clean (changes may have been checkpointed).\"\n  echo ''\nfi\n\n# 2. Look for recent commits since workflow start (more reliable after checkpoint)\n# Get the base commit (start of workflow) - try common refs\nbase_ref=''\nchanged_files=''\nfor ref in HEAD@{1} HEAD~1 HEAD~2 HEAD~3 origin/main; do\n  if git rev-parse --verify \"$ref\" >/dev/null 2>&1; then\n    base_ref=\"$ref\"\n    break\n  fi\ndone\n\nif [ -n \"$base_ref\" ]; then\n  echo \"Comparing HEAD with $base_ref...\"\n  changed_files=$(git diff --name-only \"$base_ref\" HEAD 2>/dev/null || true)\n  if [ -n \"$changed_files\" ]; then\n    echo \"Files changed since workflow start:\"\n    printf '%s\\n' \"$changed_files\"\n    echo ''\n    echo \"Change summary:\"\n    git diff --stat \"$base_ref\" HEAD || true\n    echo ''\n  else\n    echo \"No differences found between $base_ref and HEAD.\"\n    echo ''\n  fi\nelse\n  echo \"Could not determine base reference for comparison.\"\n  echo ''\nfi\n\n# 3. Check for very recent commits (Fabro checkpoints)\nrecent_commits=$(git log --oneline -5 --format='%h %s')\nif [ -n \"$recent_commits\" ]; then\n  echo \"Recent commits (may include Fabro checkpoints):\"\n  printf '%s\\n' \"$recent_commits\"\n  echo ''\nfi\n\n# 4. Gather all evidence\nevidence=''\nif [ -n \"$status\" ]; then\n  evidence=\"working-tree\"\nfi\nif [ -n \"$changed_files\" ]; then\n  evidence=\"${evidence:+$evidence, }base-head-diff\"\nfi\n\n# 5. Check for locked .feature file changes\nif [ -n \"$status\" ] && printf '%s\\n' \"$status\" | grep -E '\\.feature$'; then\n  echo 'ERROR: Final working tree includes locked acceptance feature changes.' >&2\n  echo 'Acceptance .feature files must not be modified during implementation.' >&2\n  exit 1\nfi\nif [ -n \"$changed_files\" ] && printf '%s\\n' \"$changed_files\" | grep -E '\\.feature$'; then\n  echo 'ERROR: Implementation modified locked acceptance feature files.' >&2\n  echo 'Acceptance .feature files must not be modified during implementation.' >&2\n  exit 1\nfi\n\n# 6. Fail if no evidence of changes\nif [ -z \"$evidence\" ]; then\n  echo 'ERROR: Implementation workflow reached finalization with no artifact evidence.' >&2\n  echo 'No working tree changes, no base-head diff, and no captured checkpoint found.' >&2\n  echo 'Refusing to report success without implementation artifacts.' >&2\n  exit 1\nfi\n\necho \"Final artifact evidence confirmed: $evidence\"\necho 'Final artifact gate passed.'"
    ]

    final_summary [
        label="Final Summary",
        shape=tab,
        prompt="@prompts/final_summary.md"
    ]

    start -> read_plan
    read_plan -> preflight_sandbox [condition="outcome=succeeded"]
    read_plan -> read_failed
    read_failed -> exit

    preflight_sandbox -> sync_task_list [condition="outcome=succeeded"]
    preflight_sandbox -> preflight_failed
    preflight_failed -> exit

    sync_task_list -> all_tasks_done
    all_tasks_done -> dev_check [label="No unchecked tasks", condition="outcome=succeeded"]
    all_tasks_done -> pick_next_task [label="Tasks remain"]
    pick_next_task -> implement_task [label="Task found", condition="outcome=succeeded"]
    pick_next_task -> task_not_ready [label="Could not select task"]
    implement_task -> validate_task
    validate_task -> task_gate
    task_gate -> mark_task_done [label="Valid", condition="context.task_valid=true"]
    task_gate -> fix_task [label="Repair", condition="context.task_repair_available=true"]
    task_gate -> task_not_ready [label="Needs human input"]
    fix_task -> validate_task
    mark_task_done -> commit_task
    commit_task -> sync_task_list
    task_not_ready -> exit

    dev_check -> plan_conformance_gate [label="Dev check passed", condition="outcome=succeeded"]
    dev_check -> fix_dev_check [label="Fix failures"]
    fix_dev_check -> dev_check
    plan_conformance_gate -> plan_gate
    plan_gate -> adr_coherence_gate [label="Conformant", condition="context.plan_conformant=true"]
    plan_gate -> snapshot_before_plan_repair [label="Plan rework", condition="context.plan_rework_available=true"]
    plan_gate -> plan_not_ready [label="Needs human input"]
    snapshot_before_plan_repair -> fix_plan_conformance
    fix_plan_conformance -> verify_plan_repair
    verify_plan_repair -> dev_check
    plan_not_ready -> exit
    adr_coherence_gate -> adr_gate
    adr_gate -> review_fork [label="Coherent", condition="context.adr_coherent=true"]
    adr_gate -> snapshot_before_adr_repair [label="ADR rework", condition="context.adr_rework_available=true"]
    adr_gate -> adr_not_ready [label="Needs human input"]
    snapshot_before_adr_repair -> fix_adr_coherence
    fix_adr_coherence -> verify_adr_repair
    verify_adr_repair -> dev_check
    adr_not_ready -> exit

    review_fork -> claude_review
    review_fork -> codex_review
    review_fork -> gemini_review
    claude_review -> review_merge
    codex_review -> review_merge
    gemini_review -> review_merge
    review_merge -> synthesize_review
    synthesize_review -> review_gate
    review_gate -> final_artifact_gate [label="Accepted", condition="context.implementation_accepted=true"]
    review_gate -> snapshot_before_review_repair [label="Fix", condition="context.review_fixes_available=true"]
    review_gate -> not_ready [label="Needs human input"]
    snapshot_before_review_repair -> apply_review_fixes
    apply_review_fixes -> verify_review_repair
    verify_review_repair -> dev_check
    final_artifact_gate -> final_summary
    final_summary -> exit
    not_ready -> exit
}
