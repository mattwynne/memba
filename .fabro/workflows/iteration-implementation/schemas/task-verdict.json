{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "task", "reason"],
  "properties": {
    "decision": {"type": "string", "enum": ["accept", "revise", "blocked"]},
    "task": {"type": "string", "pattern": "^[\\t ]*- \\[ \\] \\S[^\\r\\n]*$"},
    "reason": {"type": "string", "pattern": "\\S"}
  }
}
