digraph BddPlanImplementation {
    graph [goal="Implement the planned domain scenarios, one at a time; do not publish",
        default_max_retries=0,
        model_stylesheet="* { provider: openai; model: gpt-5.6-sol; reasoning_effort: high; }"]
    start [shape=Mdiamond]
    done [shape=Msquare]
    stop [shape=parallelogram, script="echo 'Plan implementation stopped; work is preserved.' >&2; exit 1"]
    setup [shape=parallelogram, script="mkdir -p .fabro/tmp/bdd-plan && git rev-parse HEAD > .fabro/tmp/bdd-plan/base"]
    navigator [shape=box, backend="api", fidelity="full", thread_id="bdd-plan-navigator", prompt="@prompts/navigator.md"]
    prepare_scenario [shape=parallelogram, script="set -eu; scratch=.fabro/tmp/bdd; archive_root=.fabro/tmp/bdd-plan/scenarios; mkdir -p $archive_root; if test -e $scratch && ! test -d $scratch; then echo 'Cannot prepare scenario: .fabro/tmp/bdd is not a directory.' >&2; exit 1; fi; if test -d $scratch && find $scratch -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then sequence=1; while test -e $archive_root/$sequence; do sequence=$((sequence + 1)); done; mv .fabro/tmp/bdd $archive_root/$sequence; fi; mkdir -p .fabro/tmp/bdd"]
    scenario [import="../bdd-scenario-implementation/workflow.fabro"]

    start -> setup
    setup -> navigator [condition="outcome=succeeded"]
    setup -> stop
    navigator -> prepare_scenario [condition="outcome=succeeded && preferred_label=implement"]
    navigator -> done [condition="outcome=succeeded && preferred_label=done"]
    navigator -> stop
    prepare_scenario -> scenario [condition="outcome=succeeded"]
    prepare_scenario -> stop
    scenario -> navigator
}
