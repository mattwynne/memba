digraph ScenarioDouble {
    graph [default_max_retries=0]
    start [shape=Mdiamond]
    done [shape=Msquare]
    apply [shape=parallelogram, script="@double.sh"]
    completed [shape=parallelogram, script="true"]
    stop [shape=parallelogram, script="exit 1"]
    start -> apply
    apply -> completed [condition="outcome=succeeded"]
    completed -> done
    apply -> stop
}
