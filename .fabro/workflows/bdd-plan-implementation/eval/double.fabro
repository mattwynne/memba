digraph ScenarioDouble {
    graph [default_max_retries=0]
    start [shape=Mdiamond]
    done [shape=Msquare]
    apply [shape=parallelogram, script="devenv shell -- bash -euc 'if [ ! -d acceptance-tests/node_modules/@cucumber/gherkin ]; then npm ci --prefix acceptance-tests --ignore-scripts --no-audit --no-fund; fi; node .fabro/workflows/bdd-plan-implementation/eval/double.cjs'"]
    stop [shape=parallelogram, script="exit 1"]
    start -> apply
    apply -> done [condition="outcome=succeeded"]
    apply -> stop
}
