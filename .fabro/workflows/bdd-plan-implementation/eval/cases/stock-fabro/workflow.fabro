digraph StockFabroCapabilities {
    graph [default_max_retries=0]
    start [shape=Mdiamond]
    done [shape=Msquare]
    failed [shape=parallelogram, script="exit 1"]
    prepare [shape=parallelogram, script="python3 -c 'import json,os; from pathlib import Path; d=Path(\".fabro/tmp/stock-fabro\"); d.mkdir(parents=True); p=d/\"scratch.txt\"; p.write_text(\"initial write\\n\"); (d/\"owner.json\").write_text(json.dumps([os.getuid(),os.getgid(),p.stat().st_uid,p.stat().st_gid])); print(\"initial owner\", p.stat().st_uid, p.stat().st_gid)'"]
    part [import="part.fabro"]
    verify [shape=parallelogram, script="python3 -c 'import json,os; from pathlib import Path; d=Path(\".fabro/tmp/stock-fabro\"); p=d/\"scratch.txt\"; p.write_text(p.read_text()+\"parent write\\n\"); assert p.read_text()==\"initial write\\nimported write\\nparent write\\n\"; expected=json.loads((d/\"owner.json\").read_text()); actual=[os.getuid(),os.getgid(),p.stat().st_uid,p.stat().st_gid]; assert expected==actual and actual[:2]==actual[2:], (expected,actual); print(\"shell writes retained ownership\", actual)'"]
    start -> prepare
    prepare -> part [condition="outcome=succeeded"]
    prepare -> failed
    part -> verify
    verify -> done [condition="outcome=succeeded"]
    verify -> failed
}
