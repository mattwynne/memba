digraph ImportedPart {
    start [shape=Mdiamond]
    done [shape=Msquare]
    write [shape=parallelogram, script="set -eu; python3 -c 'from pathlib import Path; p=Path(\".fabro/tmp/stock-fabro/scratch.txt\"); p.write_text(p.read_text() + \"imported write\\n\")'; echo imported-command-output"]
    passed [shape=parallelogram, script="true"]
    failed [shape=parallelogram, script="exit 1"]
    start -> write
    write -> passed [condition="outcome=succeeded"]
    write -> failed
    passed -> done
}
