digraph PlanValidation {
    graph [
        goal="Rigorously validate the iteration plan at {{ inputs.plan_path }} and mark it validated when it is ready for future implementation",
        default_fidelity="summary:high",
        model_stylesheet="
            * { model: gpt-5.5; reasoning_effort: high; }
            #read_plan { reasoning_effort: low; }
            #gemini_review { model: gemini-3.1-pro-preview; reasoning_effort: high; }
            #claude_review { model: claude-sonnet-4-5; reasoning_effort: high; }
            #codex_review { model: gpt-5.3-codex; reasoning_effort: high; }
            #synthesize { model: gpt-5.5; reasoning_effort: high; }
            #codex_update { model: gpt-5.3-codex; reasoning_effort: high; }
            #read_updated_plan { reasoning_effort: low; }
            #opus_recheck { model: gpt-5.5; reasoning_effort: high; }
            #publish_ready { reasoning_effort: low; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    read_plan [
        label="Read Iteration Plan",
        shape=parallelogram,
        script="PLAN_PATH='{{ inputs.plan_path }}'\nif [ ! -f \"$PLAN_PATH\" ]; then\n  echo \"Plan file not found: $PLAN_PATH\" >&2\n  exit 1\nfi\nprintf 'PLAN_PATH=%s\\n\\n' \"$PLAN_PATH\"\nsed -n '1,260p' \"$PLAN_PATH\""
    ]

    read_failed [
        label="Fail: Plan Missing",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Plan validation failed: the plan file could not be read. Fix plan_path or make the plan visible to the sandbox, then retry.' >&2\nexit 1"
    ]

    fork [label="Independent Model Reviews", shape=component, join_policy="wait_all", max_parallel=3]

    gemini_review [
        label="Gemini Review",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/gemini_review.md"
    ]

    claude_review [
        label="Claude Review",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/claude_review.md"
    ]

    codex_review [
        label="Codex/GPT Review",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/codex_review.md"
    ]

    persist_gemini_review [
        label="Persist Gemini Review",
        shape=parallelogram,
        script="mkdir -p .fabro/workflows/plan-validation/review-output\ncat > .fabro/workflows/plan-validation/review-output/gemini.md <<'FABRO_REVIEW'\n{{ response.gemini_review }}\nFABRO_REVIEW\ntest -s .fabro/workflows/plan-validation/review-output/gemini.md"
    ]

    persist_claude_review [
        label="Persist Claude Review",
        shape=parallelogram,
        script="mkdir -p .fabro/workflows/plan-validation/review-output\ncat > .fabro/workflows/plan-validation/review-output/claude.md <<'FABRO_REVIEW'\n{{ response.claude_review }}\nFABRO_REVIEW\ntest -s .fabro/workflows/plan-validation/review-output/claude.md"
    ]

    persist_codex_review [
        label="Persist Codex Review",
        shape=parallelogram,
        script="mkdir -p .fabro/workflows/plan-validation/review-output\ncat > .fabro/workflows/plan-validation/review-output/codex.md <<'FABRO_REVIEW'\n{{ response.codex_review }}\nFABRO_REVIEW\ntest -s .fabro/workflows/plan-validation/review-output/codex.md"
    ]

    merge [label="Merge Reviews", shape=tripleoctagon]

    collect_reviews [
        label="Collect Review Artifacts",
        shape=parallelogram,
        script="set -eu\nDIR='.fabro/workflows/plan-validation/review-output'\nCOLLECTED='.fabro/workflows/plan-validation/collected-reviews'\nmkdir -p \"$COLLECTED\"\nmissing=0\nfind_review() {\n  reviewer=\"$1\"\n  path=\"$DIR/$reviewer.md\"\n  if [ -s \"$path\" ]; then\n    cat \"$path\"\n    return 0\n  fi\n  for commit in $(git rev-list --all --max-count=300); do\n    if git cat-file -e \"$commit:$path\" 2>/dev/null; then\n      git show \"$commit:$path\"\n      return 0\n    fi\n  done\n  return 1\n}\nfor reviewer in gemini claude codex; do\n  out=\"$COLLECTED/$reviewer.md\"\n  if ! find_review \"$reviewer\" > \"$out\" || [ ! -s \"$out\" ]; then\n    echo \"Missing review artifact for $reviewer\" >&2\n    missing=1\n    continue\n  fi\n  if ! grep -Eq '^[-* ]*Decision:[[:space:]]*(READY|NOT READY)' \"$out\"; then\n    echo \"Review artifact lacks a Decision line: $out\" >&2\n    missing=1\n  fi\ndone\nif [ \"$missing\" -ne 0 ]; then\n  echo 'Plan validation failed: not all parallel reviewer artifacts were collected after fan-in.' >&2\n  exit 1\nfi\necho '=== Collected independent review artifacts ==='\nfor reviewer in gemini claude codex; do\n  file=\"$COLLECTED/$reviewer.md\"\n  echo\n  echo \"--- $reviewer review artifact: $file ---\"\n  sed -n '1,240p' \"$file\"\ndone"
    ]

    synthesize [
        label="Opus Synthesis & Repair Brief",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/synthesize.md"
    ]

    synthesis_gate [shape=diamond, label="Obvious fixes?"]

    codex_update [
        label="Codex Updates Plan",
        prompt="@prompts/apply_fixes.md"
    ]

    read_updated_plan [
        label="Read Updated Plan",
        shape=parallelogram,
        script="PLAN_PATH='{{ inputs.plan_path }}'\nif [ ! -f \"$PLAN_PATH\" ]; then\n  echo \"Plan file not found after Codex update: $PLAN_PATH\" >&2\n  exit 1\nfi\nprintf 'UPDATED PLAN_PATH=%s\\n\\n' \"$PLAN_PATH\"\nsed -n '1,320p' \"$PLAN_PATH\""
    ]

    opus_recheck [
        label="Opus Recheck",
        shape=tab,
        prompt="@prompts/recheck.md"
    ]

    recheck_gate [shape=diamond, label="Plan ready?"]

    publish_ready [
        label="Publish Validated Plan",
        shape=parallelogram,
        script="if [ '{{ inputs.publish }}' = 'false' ]; then\n  echo 'Plan validation would publish READY, but publish=false for eval/test.'\n  exit 0\nfi\n.fabro/workflows/plan-validation/scripts/publish_ready.sh '{{ inputs.plan_path }}'"
    ]

    not_ready [
        label="Fail: Plan Not Ready",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Plan validation failed: the plan is not ready for implementation. See the Opus report for remaining gaps or decisions that need human input.' >&2\nexit 1"
    ]

    start -> read_plan
    read_plan -> fork [condition="outcome=succeeded"]
    read_plan -> read_failed
    read_failed -> exit
    fork -> gemini_review
    fork -> claude_review
    fork -> codex_review
    gemini_review -> persist_gemini_review
    claude_review -> persist_claude_review
    codex_review -> persist_codex_review
    persist_gemini_review -> merge
    persist_claude_review -> merge
    persist_codex_review -> merge
    merge -> collect_reviews
    collect_reviews -> synthesize
    synthesize -> synthesis_gate
    synthesis_gate -> publish_ready [label="Already ready", condition="plan_ready=true"]
    synthesis_gate -> codex_update [label="Apply obvious fixes", condition="plan_needs_fix=true"]
    synthesis_gate -> not_ready [label="Needs human input"]
    codex_update -> read_updated_plan
    read_updated_plan -> opus_recheck
    opus_recheck -> recheck_gate
    recheck_gate -> publish_ready [label="Ready", condition="plan_ready=true"]
    recheck_gate -> codex_update [label="Fix again", condition="plan_needs_fix=true && context.internal.node_visit_count < 3"]
    recheck_gate -> not_ready [label="Not ready"]
    publish_ready -> exit
    not_ready -> exit
}
