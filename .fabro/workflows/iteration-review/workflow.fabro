digraph IterationReview {
    graph [
        goal="Review the completed plan-conforming implementation of {{ inputs.plan_path }} for code polish, ADR conformance, and code-health signals",
        default_fidelity="summary:high",
        max_node_visits=160,
        model_stylesheet="
            * { provider: openai; model: gpt-5.6-sol; reasoning_effort: high; }
            #read_plan { reasoning_effort: low; }
            #fix_dev_check { reasoning_effort: high; }
            #claude_review { provider: openrouter; model: claude-sonnet-5; reasoning_effort: high; }
            #codex_review { provider: openai; model: gpt-5.6-sol; reasoning_effort: high; }
            #gemini_review { provider: openrouter; model: gemini-3.1-pro-preview; reasoning_effort: high; }
            #synthesize_review { provider: openai; model: gpt-5.6-sol; reasoning_effort: high; }
            #apply_review_fixes { reasoning_effort: high; }
            #record_code_health { reasoning_effort: high; }
            #final_summary { reasoning_effort: low; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    read_plan [
        label="Read Iteration Plan",
        shape=parallelogram,
        script="PLAN_PATH='{{ inputs.plan_path }}'\nif [ ! -f \"$PLAN_PATH\" ]; then\n  echo \"Iteration plan not found: $PLAN_PATH\" >&2\n  exit 1\nfi\nprintf 'PLAN_PATH=%s\\n\\n' \"$PLAN_PATH\"\nline_count=0\nwhile IFS= read -r line && [ \"$line_count\" -lt 320 ]; do\n  printf '%s\\n' \"$line\"\n  line_count=$((line_count + 1))\ndone < \"$PLAN_PATH\""
    ]

    read_failed [
        label="Fail: Plan Missing",
        shape=parallelogram,
        script="echo 'Iteration review failed: the plan file could not be read. Pass -I plan_path=docs/iterations/NNN-topic/plan.md and ensure it is committed/pushed for remote sandboxes.' >&2\nexit 1"
    ]

    preflight_sandbox [
        label="Preflight Review Sandbox",
        shape=parallelogram,
        script="bash .fabro/workflows/iteration-review/scripts/preflight_sandbox.sh",
        timeout="600s"
    ]

    preflight_failed [
        label="Fail: Sandbox Preflight",
        shape=parallelogram,
        script="echo 'Iteration review failed before review: the sandbox/toolchain preflight did not pass. Fix the Fabro environment or image, then retry.' >&2\nexit 1"
    ]

    dev_check [
        label="Run Dev Check",
        shape=parallelogram,
        script="PATH=\"$PWD/bin:$PATH\" dev ci",
        timeout="1800s"
    ]

    fix_dev_check [
        label="Fix Dev Check Failures",
        prompt="@prompts/fix_dev_check.md",
        timeout="2400s",
        max_visits=3
    ]

    collect_implementation_evidence [
        label="Collect Implementation Evidence",
        shape=parallelogram,
        script="bash .fabro/workflows/iteration-review/scripts/collect_implementation_evidence.sh '{{ inputs.base_sha }}'",
        timeout="120s"
    ]

    collect_evidence_failed [
        label="Fail: Evidence Collection",
        shape=parallelogram,
        script="echo 'Iteration review failed before gates: implementation evidence could not be collected. Check base_sha visibility, then retry via bin/dev fabro review.' >&2\nexit 1"
    ]

    review_fork [
        label="Fan Out Independent Reviews",
        shape=component,
        max_parallel=3
    ]

    claude_review [
        label="Claude Review",
        shape=tab,
        prompt="@prompts/review.md",
        retry_policy="patient"
    ]
    codex_review [
        label="Sol Review",
        shape=tab,
        prompt="@prompts/review.md",
        retry_policy="patient"
    ]
    gemini_review [
        label="Gemini Review",
        shape=tab,
        prompt="@prompts/review.md",
        retry_policy="patient"
    ]

    review_merge [
        label="Collect Independent Reviews",
        shape=tripleoctagon
    ]

    synthesize_review [
        label="Synthesize Review",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/synthesize_review.md",
        retry_policy="patient",
        allow_partial=true
    ]
    synthesis_unavailable [
        label="Fail: Review Synthesis Unavailable",
        shape=parallelogram,
        script="echo 'Iteration review could not collect usable evidence from every independent reviewer and synthesize it after parallel fan-in. Product review evidence may exist in completed review stages; inspect the run events/artifacts and rerun or manually synthesize rather than treating this as reviewer acceptance or rejection.' >&2\nexit 1"
    ]
    review_gate [shape=diamond, label="Implementation accepted?"]
    snapshot_before_review_repair [
        label="Snapshot Before Review Repair",
        shape=parallelogram,
        script="set -eu\nmkdir -p .fabro/tmp\nkind='review'\nbefore_head=$(git rev-parse HEAD)\nprintf '%s\\n' \"$before_head\" > \".fabro/tmp/${kind}-repair-before-head.txt\"\ngit diff --binary \"$before_head\" > \".fabro/tmp/${kind}-repair-before.patch\"\ngit diff --name-only \"$before_head\" > \".fabro/tmp/${kind}-repair-before-files.txt\"\ngit diff --stat \"$before_head\" > \".fabro/tmp/${kind}-repair-before-stat.txt\" || true\nprintf 'Repair baseline (%s) captured at HEAD %s.\\n' \"$kind\" \"$before_head\""
    ]
    apply_review_fixes [
        label="Apply Review Fixes",
        prompt="@prompts/apply_review_fixes.md",
        timeout="2400s",
        max_visits=3
    ]
    verify_review_repair [
        label="Verify Review Repair",
        shape=parallelogram,
        script="bash .fabro/workflows/iteration-review/scripts/verify_review_repair.sh"
    ]
    not_ready [
        label="Fail: Needs Human Review",
        shape=parallelogram,
        script="echo 'Iteration review failed: reviewers found blocking issues that require human input or exceeded the automatic repair budget.' >&2\nexit 1"
    ]

    record_code_health [
        label="Record Code Health Findings",
        shape=box,
        fidelity="truncate",
        output_schema="routing",
        prompt="@prompts/record_code_health.md"
    ]

    code_health_recording_failed [
        label="Fail: Code Health Recording",
        shape=parallelogram,
        script="echo 'Iteration review accepted the implementation, but judgement-worthy code-health findings were not recorded in docs/code-health.md. Inspect the Record Code Health Findings stage and rerun review or record the findings manually before finalizing.' >&2\nexit 1"
    ]

    final_artifact_gate [
        label="Final Artifact Gate",
        shape=parallelogram,
        script="bash .fabro/workflows/iteration-review/scripts/final_artifact_gate.sh '{{ inputs.plan_path }}' '{{ inputs.base_sha }}'"
    ]

    publish_polish_to_main [
        label="Publish Review Polish to Main",
        shape=parallelogram,
        script="bash .fabro/workflows/iteration-review/scripts/publish_polish_to_main.sh '{{ inputs.plan_path }}'",
        timeout="300s"
    ]

    final_artifact_failed [
        label="Fail: Final Artifact Gate",
        shape=parallelogram,
        script="echo 'Iteration review accepted the implementation, but final artifact policy failed. Check feature-file plan permissions and review-polish diffs, then rerun review.' >&2\nexit 1"
    ]

    publish_failed [
        label="Fail: Publish Review Polish",
        shape=parallelogram,
        script="echo 'Iteration review accepted the implementation, but could not publish green review polish to main. Check push credentials, branch protection, and whether origin/main moved with conflicts.' >&2\nexit 1"
    ]

    finalize_iteration_status [
        label="Finalize Iteration Status",
        shape=parallelogram,
        script="bash .fabro/workflows/iteration-review/scripts/finalize_iteration_status.sh '{{ inputs.plan_path }}'",
        timeout="300s",
        goal_gate=true
    ]

    finalize_failed [
        label="Fail: Finalize Iteration Status",
        shape=parallelogram,
        script="echo 'Iteration review succeeded but could not mark the iteration merged. Rerun review after resolving push/status conflicts.' >&2\nexit 1"
    ]

    final_summary [
        label="Final Summary",
        shape=tab,
        prompt="@prompts/final_summary.md"
    ]

    start -> read_plan
    read_plan -> preflight_sandbox [condition="outcome=succeeded"]
    read_plan -> read_failed
    read_failed -> exit

    preflight_sandbox -> dev_check [condition="outcome=succeeded"]
    preflight_sandbox -> preflight_failed
    preflight_failed -> exit

    dev_check -> collect_implementation_evidence [label="Dev check passed", condition="outcome=succeeded"]
    dev_check -> fix_dev_check [label="Fix failures"]
    fix_dev_check -> dev_check
    collect_implementation_evidence -> review_fork [condition="outcome=succeeded"]
    collect_implementation_evidence -> collect_evidence_failed
    collect_evidence_failed -> exit

    review_fork -> claude_review
    review_fork -> codex_review
    review_fork -> gemini_review
    claude_review -> review_merge
    codex_review -> review_merge
    gemini_review -> review_merge
    review_merge -> synthesize_review [condition="outcome=succeeded"]
    review_merge -> synthesis_unavailable [label="Reviewer evidence unavailable"]
    synthesize_review -> review_gate [condition="outcome=succeeded"]
    synthesize_review -> synthesis_unavailable [label="Synthesis unavailable"]
    synthesis_unavailable -> exit
    review_gate -> record_code_health [label="Accepted", condition="context.implementation_accepted=true"]
    review_gate -> snapshot_before_review_repair [label="Fix", condition="context.review_fixes_available=true"]
    review_gate -> not_ready [label="Needs human input"]
    snapshot_before_review_repair -> apply_review_fixes
    apply_review_fixes -> verify_review_repair
    verify_review_repair -> dev_check

    record_code_health -> final_artifact_gate [condition="context.code_health_recording_ok=true"]
    record_code_health -> code_health_recording_failed [label="Code-health recording failed"]
    code_health_recording_failed -> exit
    final_artifact_gate -> publish_polish_to_main [condition="outcome=succeeded"]
    final_artifact_gate -> final_artifact_failed
    final_artifact_failed -> exit
    publish_polish_to_main -> finalize_iteration_status [condition="outcome=succeeded"]
    publish_polish_to_main -> publish_failed
    publish_failed -> exit
    finalize_iteration_status -> final_summary [condition="outcome=succeeded"]
    finalize_iteration_status -> finalize_failed
    finalize_failed -> exit
    final_summary -> exit
    not_ready -> exit
}
