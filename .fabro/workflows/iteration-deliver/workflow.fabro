digraph IterationDeliver {
    graph [
        goal="Deliver or validate-only the iteration plan at {{ inputs.plan_path }} by orchestrating child runs while enforcing the implementation WIP limit",
        default_fidelity="summary:high",
        model_stylesheet="
            * { model: gpt-5.5; reasoning_effort: high; }
            #orchestrate { reasoning_effort: high; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    orchestrate [
        label="Orchestrate Child Runs",
        shape=box,
        output_schema="routing",
        output_retries=2,
        prompt="@prompts/orchestrate.md",
        timeout="7200s"
    ]

    start -> orchestrate -> exit
}
