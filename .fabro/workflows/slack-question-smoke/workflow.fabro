digraph SlackQuestionSmoke {
    graph [goal="Test a native agent question through Fabro's Slack interviewer; do not change code or resume delivery"]
    start [shape=Mdiamond, label="Start"]
    evidence [shape=parallelogram, label="Read validator finding", script="bash .fabro/workflows/iteration-clarification/scripts/read_blocker.sh '{{ inputs.failed_run_id }}' '{{ inputs.plan_path }}'"]
    converse [shape=box, label="Talk with Matt", prompt="@prompts/converse.md"]
    exit [shape=Msquare, label="End without changing delivery"]
    start -> evidence -> converse -> exit
}
