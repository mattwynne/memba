<div class="min-h-screen bg-base-200 text-ink">
  <header class="border-b border-line bg-paper px-5 py-4">
    <div class="mx-auto flex max-w-5xl items-center">
      <span class="inline-flex items-center gap-2" aria-label="Memba">
        <.sprig class="size-6 text-sage-600" />
        <span class="text-lg font-semibold tracking-tight text-ink lowercase">memba</span>
      </span>
    </div>
  </header>

  <main
    id="person-email-address-verification"
    class="flex justify-center px-6 py-14 sm:py-20"
    data-status={@status}
  >
    <section
      id="person-email-address-verification-card"
      class="w-full max-w-md rounded-3xl border border-line bg-paper p-8 text-center shadow-sm"
      aria-labelledby="person-email-address-verification-title"
    >
      <div
        class={["mx-auto mb-5 grid size-12 place-items-center rounded-full border", @icon_tone]}
        aria-hidden="true"
      >
        <.icon name={@icon} class="size-6 bg-current" />
      </div>

      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">
        Email verification
      </p>

      <h1
        id="person-email-address-verification-title"
        class="mt-3 text-2xl font-semibold tracking-tight text-ink"
      >
        {@heading}
      </h1>

      <p class="mt-4 text-base leading-7 text-ink-2">
        {@message}
      </p>
    </section>
  </main>
</div>
