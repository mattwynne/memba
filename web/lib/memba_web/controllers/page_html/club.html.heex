<Layouts.club_site
  flash={@flash}
  club_name={@selected_club.name}
  current_identity={@current_identity}
>
  <div class="space-y-8">
    <section
      id="member-club-home"
      data-club-id={@selected_club.club_id}
      class="overflow-hidden rounded-3xl border border-[var(--club-site-line)] bg-[var(--club-site-paper)] p-8 shadow-sm"
    >
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--club-site-accent)]">
        {@selected_club.name}
      </p>
      <div class="mt-3 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h1 class="text-4xl font-semibold tracking-tight text-[var(--club-site-ink)]">
            Hello, {(@current_member && @current_member.name) || "member"}.
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--club-site-muted)]">
            Welcome to your club space. What the club's been saying, and who's around right now.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a
            id="member-compose-shortcut"
            href="#member-send-message"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--club-site-accent)] px-5 py-3 text-sm font-semibold text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"
          >
            <.icon name="hero-paper-airplane" class="size-5" /> Send club message
          </a>
          <a
            id="back-to-my-clubs-link"
            href={~p"/"}
            class="inline-flex items-center justify-center rounded-full border border-[var(--club-site-line)] bg-[var(--club-site-paper)] px-5 py-3 text-sm font-semibold text-[var(--club-site-ink)] transition duration-200 hover:-translate-y-0.5 hover:bg-white"
          >
            Back to my clubs
          </a>
        </div>
      </div>
    </section>

    <section
      id="member-send-message"
      class="rounded-3xl border border-[var(--club-site-line)] bg-[var(--club-site-paper)] p-8 shadow-sm"
    >
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--club-site-accent)]">
            New message
          </p>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--club-site-ink)]">
            Send a club message
          </h2>
          <p class="mt-3 leading-7 text-[var(--club-site-muted)]">
            Write once — every active member gets it.
          </p>

          <div
            id="member-compose-recipient-summary"
            data-active-member-count={@active_member_count}
            class="mt-6 flex gap-3 rounded-2xl border border-[var(--club-site-line)] bg-[var(--club-site-bg)] p-4"
          >
            <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-full bg-[var(--club-site-paper)] text-[var(--club-site-accent)]">
              <.icon name="hero-users" class="size-5" />
            </span>
            <p class="text-sm leading-6 text-[var(--club-site-muted)]">
              This goes to
              <strong class="text-[var(--club-site-ink)]">
                {@active_member_count} active members
              </strong>
              of {@selected_club.name}. Everyone with a current membership. They'll all receive your messages.
            </p>
          </div>
        </div>

        <.form
          for={@message_form}
          id="member-message-form"
          action={~p"/?#{[club_id: @selected_club.club_id]}"}
          method="post"
          class="grid gap-4"
        >
          <.input
            field={@message_form[:sender_id]}
            id="member-message-sender-select"
            label="From"
            type="select"
            aria-label="Message sender"
            options={@member_options}
            required
          />
          <.input
            field={@message_form[:subject]}
            id="member-message-subject-input"
            label="Subject"
            aria-label="Message subject"
            placeholder="What's this about?"
            required
          />
          <.input
            field={@message_form[:body]}
            id="member-message-body-input"
            label="Message"
            type="textarea"
            aria-label="Message body"
            placeholder="Write your note to the club…"
            rows="7"
            required
          />
          <div>
            <button
              id="member-send-message-button"
              type="submit"
              aria-label="Send club message"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--club-site-accent)] px-6 py-3 text-sm font-semibold text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"
            >
              <.icon name="hero-paper-airplane" class="size-5" /> Send to all members
            </button>
          </div>
        </.form>
      </div>
    </section>

    <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
      <section
        id="club-messages"
        class="rounded-3xl border border-[var(--club-site-line)] bg-[var(--club-site-paper)] p-8 shadow-sm"
      >
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--club-site-accent)]">
          Recent updates
        </p>
        <h2 class="mt-2 flex items-center gap-2 text-2xl font-semibold text-[var(--club-site-ink)]">
          <.icon name="hero-envelope" class="size-5" /> Recent club messages
        </h2>

        <div id="member-message-list" class="mt-6 divide-y divide-[var(--club-site-line)]">
          <p
            :if={@messages == []}
            id="member-message-list-empty"
            class="py-4 text-sm text-[var(--club-site-muted)]"
          >
            No messages yet. When someone sends a note to the club, it'll show up here.
          </p>
          <article
            :for={message <- @messages}
            id={"member-message-#{message.message_id}"}
            data-testid="club-message-row"
            data-message-id={message.message_id}
            data-message-subject={message.subject}
            class="py-4"
          >
            <a
              data-testid="club-message-link"
              href={"/messages/#{message.message_id}?club_id=#{@selected_club.club_id}"}
              class="group flex items-start gap-4 rounded-2xl p-3 transition duration-200 hover:-translate-y-0.5 hover:bg-[var(--club-site-bg)]"
            >
              <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-[var(--club-site-bg)] text-sm font-semibold text-[var(--club-site-accent)] ring-1 ring-[var(--club-site-line)]">
                <.icon name="hero-envelope" class="size-5" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-semibold text-[var(--club-site-muted)]">
                  {Map.get(@member_names_by_id, message.sender_id, "Club member")}
                </span>
                <span class="mt-1 block font-semibold text-[var(--club-site-ink)] group-hover:underline">
                  {message.subject}
                </span>
                <span class="mt-2 block whitespace-pre-wrap text-sm leading-6 text-[var(--club-site-muted)]">
                  {message.body}
                </span>
              </span>
              <span class="mt-1 text-[var(--club-site-muted)]">
                <.icon name="hero-chevron-right" class="size-5" />
              </span>
            </a>
          </article>
        </div>
      </section>

      <section
        id="club-members"
        class="rounded-3xl border border-[var(--club-site-line)] bg-[var(--club-site-paper)] p-8 shadow-sm"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--club-site-accent)]">
              People
            </p>
            <h2 class="mt-2 flex items-center gap-2 text-2xl font-semibold text-[var(--club-site-ink)]">
              <.icon name="hero-users" class="size-5" /> Active members
            </h2>
          </div>
          <span class="rounded-full border border-[var(--club-site-line)] px-3 py-1 text-sm font-semibold text-[var(--club-site-muted)]">
            {@active_member_count}
          </span>
        </div>

        <div class="mt-6 rounded-2xl border border-[var(--club-site-line)] bg-[var(--club-site-bg)] p-5">
          <div class="flex items-center gap-4">
            <div class="flex -space-x-2">
              <span
                :for={member <- Enum.take(@members, 6)}
                class="flex size-10 items-center justify-center rounded-full border-2 border-[var(--club-site-paper)] bg-[var(--club-site-paper)] text-xs font-semibold text-[var(--club-site-accent)] shadow-sm"
              >
                {member.initials}
              </span>
              <span
                :if={@active_member_count > 6}
                class="flex size-10 items-center justify-center rounded-full border-2 border-[var(--club-site-paper)] bg-[var(--club-site-accent)] text-xs font-semibold text-white shadow-sm"
              >
                +{@active_member_count - 6}
              </span>
            </div>
            <div>
              <strong class="text-[var(--club-site-ink)]">
                {@active_member_count} active members
              </strong>
              <p class="mt-1 text-sm text-[var(--club-site-muted)]">
                Everyone with a current membership. They'll all receive your messages.
              </p>
            </div>
          </div>
        </div>

        <div id="member-list" class="mt-4 divide-y divide-[var(--club-site-line)]">
          <p
            :if={@members == []}
            id="member-list-empty"
            class="py-4 text-sm text-[var(--club-site-muted)]"
          >
            No active members yet.
          </p>
          <div
            :for={member <- @members}
            id={"club-member-#{member.id}"}
            data-testid="club-member-row"
            data-member-id={member.id}
            data-member-name={member.name}
            class="flex items-center gap-4 py-4"
          >
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[var(--club-site-bg)] text-xs font-semibold text-[var(--club-site-accent)] ring-1 ring-[var(--club-site-line)]">
              {member.initials}
            </span>
            <span>
              <span class="block font-semibold text-[var(--club-site-ink)]">{member.name}</span>
              <span class="mt-1 block text-sm text-[var(--club-site-muted)]">{member.email}</span>
            </span>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layouts.club_site>
