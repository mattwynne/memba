<Layouts.club_site
  flash={@flash}
  club_name={@selected_club.name}
  current_identity={@current_identity}
>
  <div
    id="member-club-home"
    data-live-view="member-dashboard"
    data-club-id={@selected_club.club_id}
    class="mx-auto max-w-3xl space-y-8"
  >
    <section
      id="member-dashboard-hero"
      class="border-b border-[var(--club-site-line)] pb-8"
    >
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--club-site-muted)]">
        {@selected_club.name}
      </p>
      <h1 class="mt-2 text-4xl font-semibold leading-tight tracking-tight text-[var(--club-site-ink)] sm:text-5xl">
        Hello, {first_name(@current_member)}.
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-7 text-[var(--club-site-muted)]">
        What the club's been saying, and who's around right now.
      </p>
    </section>

    <section
      id="member-dashboard-cta"
      class="rounded-3xl bg-[var(--club-site-accent)] p-6 text-white shadow-sm"
    >
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold tracking-tight text-white">Got something to share?</h2>
          <p class="mt-1 text-sm leading-6 text-white/75">
            Write once — every active member gets it.
          </p>
        </div>

        <.link
          id="member-send-message-link"
          href={~p"/messages/new?club_id=#{@selected_club.club_id}"}
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-[var(--club-site-accent)] shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-white/95 hover:shadow-md"
        >
          <.icon name="hero-paper-airplane" class="size-5" /> Send club message
        </.link>
      </div>
    </section>

    <section id="club-messages">
      <div class="flex items-center justify-between gap-4">
        <h2 class="flex items-center gap-2 text-base font-semibold text-[var(--club-site-ink)]">
          <.icon name="hero-envelope" class="size-5 text-[var(--club-site-accent)]" />
          Recent club messages
        </h2>
      </div>

      <div id="member-message-list" class="mt-4 space-y-2">
        <div
          :if={@message_rows == []}
          id="member-message-list-empty"
          class="rounded-3xl border border-dashed border-[var(--club-site-line)] bg-[var(--club-site-paper)] px-6 py-8 text-center shadow-sm"
        >
          <div class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-[var(--club-site-bg)] text-[var(--club-site-muted)] ring-1 ring-[var(--club-site-line)]">
            <.icon name="hero-envelope" class="size-6" />
          </div>
          <h3 class="mt-4 text-base font-semibold text-[var(--club-site-ink)]">
            No messages yet
          </h3>
          <p class="mx-auto mt-1 max-w-sm text-sm leading-6 text-[var(--club-site-muted)]">
            When someone sends a note to the club, it'll show up here.
          </p>
          <.link
            id="member-message-empty-send-link"
            href={~p"/messages/new?club_id=#{@selected_club.club_id}"}
            class="mt-5 inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-[var(--club-site-line)] bg-[var(--club-site-paper)] px-5 py-3 text-sm font-semibold text-[var(--club-site-ink)] shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-white"
          >
            <.icon name="hero-paper-airplane" class="size-4" /> Send the first one
          </.link>
        </div>

        <article
          :for={message_row <- @message_rows}
          id={"member-message-#{message_row.message_id}"}
          data-testid="club-message-row"
          data-message-id={message_row.message_id}
          data-message-subject={message_row.subject}
          class="rounded-2xl border border-[var(--club-site-line)] bg-[var(--club-site-paper)] shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[var(--club-site-muted)]/40 hover:shadow-md"
        >
          <.link
            data-testid="club-message-link"
            href={~p"/messages/#{message_row.message_id}?club_id=#{@selected_club.club_id}"}
            class="grid gap-4 p-4 sm:grid-cols-[2.25rem_1fr_auto] sm:items-start"
          >
            <span
              data-testid="message-sender-initials"
              class="flex size-9 shrink-0 items-center justify-center rounded-full bg-[var(--club-site-bg)] text-xs font-bold text-[var(--club-site-accent)] ring-1 ring-[var(--club-site-line)]"
            >
              {message_row.sender_initials}
            </span>

            <span class="min-w-0">
              <span
                data-testid="message-sender-name"
                class="block text-xs font-medium text-[var(--club-site-muted)]"
              >
                {message_row.sender_name}
              </span>

              <span class="mt-1 block truncate text-base font-semibold tracking-tight text-[var(--club-site-ink)]">
                {message_row.subject}
              </span>

              <span
                :if={message_row.has_receipt_glance?}
                data-testid="message-receipt-glance"
                class="mt-3 flex flex-wrap items-center gap-2 text-xs font-medium text-[var(--club-site-muted)]"
              >
                <span
                  class="flex h-1.5 w-20 overflow-hidden rounded-full bg-[var(--club-site-bg)] ring-1 ring-inset ring-[var(--club-site-line)]"
                  aria-hidden="true"
                >
                  <span
                    :for={segment <- message_row.receipt_segments}
                    data-testid="message-receipt-segment"
                    data-receipt-status={segment.status}
                    data-receipt-label={segment.status_label}
                    data-receipt-count={segment.count}
                    data-receipt-percentage={segment.width_percentage}
                    class={["block h-full", status_bg_class(segment.status)]}
                    style={receipt_segment_width(segment)}
                  />
                </span>
                <span>{message_row.receipt_glance_copy}</span>
              </span>
            </span>

            <span class="flex items-start justify-between gap-3 sm:justify-end">
              <span
                :if={message_row.sent_at_label}
                data-testid="message-sent-at"
                class="text-xs font-medium tabular-nums text-[var(--club-site-muted)]"
              >
                {message_row.sent_at_label}
              </span>
              <span class="text-[var(--club-site-muted)]">
                <.icon name="hero-chevron-right" class="size-5" />
              </span>
            </span>
          </.link>
        </article>
      </div>
    </section>

    <section id="club-members">
      <div class="flex items-center justify-between gap-4">
        <h2 class="flex items-center gap-2 text-base font-semibold text-[var(--club-site-ink)]">
          <.icon name="hero-users" class="size-5 text-[var(--club-site-accent)]" /> Active members
        </h2>
      </div>

      <div
        id="active-members-card"
        data-active-member-count={@active_member_count}
        data-active-members-state={
          if @active_member_count <= 1, do: "first-member", else: "active-members"
        }
        class="mt-4 rounded-3xl border border-[var(--club-site-line)] bg-[var(--club-site-paper)] p-5 shadow-sm"
      >
        <div
          :if={@active_member_count <= 1}
          id="active-members-empty-state"
          class="text-center"
        >
          <div id="active-members-empty-avatar" class="flex justify-center">
            <span
              :for={member <- Enum.take(@members, 1)}
              id={"club-member-#{member.id}"}
              data-testid="club-member-row"
              data-member-id={member.id}
              data-member-name={member.name}
              class="flex size-12 items-center justify-center rounded-2xl border border-[var(--club-site-line)] bg-[var(--club-site-bg)] text-sm font-bold text-[var(--club-site-accent)] shadow-sm"
              title={member.name}
            >
              {member.initials}
            </span>
            <span
              :if={@members == []}
              class="flex size-12 items-center justify-center rounded-2xl bg-[var(--club-site-bg)] text-[var(--club-site-muted)] ring-1 ring-[var(--club-site-line)]"
              aria-hidden="true"
            >
              <.icon name="hero-users" class="size-6" />
            </span>
          </div>
          <h3 class="mt-4 text-base font-semibold text-[var(--club-site-ink)]">
            You're the first one here
          </h3>
          <p class="mx-auto mt-1 max-w-sm text-sm leading-6 text-[var(--club-site-muted)]">
            As members join and renew, you'll see them listed here.
          </p>
        </div>

        <div
          :if={@active_member_count > 1}
          class="flex flex-col gap-5 sm:flex-row sm:items-center"
        >
          <div id="active-members-avatar-stack" class="flex">
            <span
              :for={member <- Enum.take(@members, 6)}
              id={"club-member-#{member.id}"}
              data-testid="club-member-row"
              data-member-id={member.id}
              data-member-name={member.name}
              class="-ml-2 flex size-10 items-center justify-center rounded-full border-2 border-[var(--club-site-paper)] bg-[var(--club-site-bg)] text-xs font-bold text-[var(--club-site-accent)] shadow-sm first:ml-0"
              title={member.name}
            >
              {member.initials}
            </span>
            <span
              :if={@active_member_count > 6}
              class="-ml-2 flex size-10 items-center justify-center rounded-full border-2 border-[var(--club-site-paper)] bg-[var(--club-site-accent)] text-xs font-semibold text-white shadow-sm"
            >
              +{@active_member_count - 6}
            </span>
          </div>

          <div class="min-w-0 flex-1">
            <strong class="block text-base font-semibold text-[var(--club-site-ink)]">
              {active_member_count_label(@active_member_count)}
            </strong>
            <p
              id="active-members-card-copy"
              class="mt-1 text-sm leading-6 text-[var(--club-site-muted)]"
            >
              Everyone with a current membership. They'll all receive your messages.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layouts.club_site>
