<% club_id_source = assigns[:club_id_source] || "host" %>
<% requested_section = assigns[:active_section] || "conversations" %>
<% selected_group_access = assigns[:selected_group_access] || :participating_member %>
<% active_section = selected_group_active_section(selected_group_access, requested_section) %>
<% selected_group_route_id = assigns[:selected_group_route_id] %>
<% {your_groups, other_groups} = split_member_group_rail(@groups) %>
<% participating_group? = participating_group?(selected_group_access) %>
<% ordinary_non_member? = ordinary_group_non_member?(selected_group_access) %>
<% outside_admin? = outside_group_admin?(selected_group_access) %>

<Layouts.club_site
  flash={@flash}
  club_name={@selected_club.name}
  current_identity={@current_identity}
  member_name={@current_member && @current_member.name}
  wide
>
  <div
    id="member-club-home"
    data-live-view="member-dashboard"
    data-club-id={@selected_club.club_id}
    data-selected-group-id={@selected_group.group_id}
    data-explicit-group-route={to_string(not is_nil(selected_group_route_id))}
    phx-hook="RememberGroupSelection"
    class="club-groups"
  >
    <div class="app-split">
      <nav id="member-group-rail" class="group-rail" aria-label="Groups">
        <div id="member-group-rail-your" class="group-rail__section">
          <div class="group-rail__label">Your groups</div>
          <.link
            :for={group <- your_groups}
            id={"member-group-link-#{group.group_id}"}
            patch={
              member_section_path(
                "conversations",
                @selected_club,
                club_id_source,
                group.group_id
              )
            }
            class={member_group_rail_item_class(group, @selected_group)}
            data-testid="member-group-link"
            data-group-id={group.group_id}
            aria-current={member_group_aria_current(group, @selected_group)}
          >
            <span class="group-rail__name">{group.name}</span>
          </.link>
        </div>

        <div :if={other_groups != []} id="member-group-rail-other" class="group-rail__section">
          <div class="group-rail__label">Other groups</div>
          <.link
            :for={group <- other_groups}
            id={"member-group-link-#{group.group_id}"}
            patch={
              member_section_path(
                "conversations",
                @selected_club,
                club_id_source,
                group.group_id
              )
            }
            class={member_group_rail_item_class(group, @selected_group)}
            data-testid="member-group-link"
            data-group-id={group.group_id}
            aria-current={member_group_aria_current(group, @selected_group)}
            title="You're not in this group"
          >
            <span class="group-rail__name">{group.name}</span>
            <.icon name="hero-lock-closed" class="group-rail__lock" aria-hidden="true" />
            <span class="visually-hidden">(not a member)</span>
          </.link>
        </div>

        <div :if={@current_member_can_manage_members?} class="group-rail__divider" />
        <.link
          :if={@current_member_can_manage_members?}
          id="member-new-group-link"
          navigate={member_new_group_path(@selected_club, club_id_source)}
          class="group-rail__item group-rail__add"
        >
          <.icon name="hero-plus" class="size-4" aria-hidden="true" />
          <span class="group-rail__name">New group</span>
        </.link>
      </nav>

      <div
        id="member-group-content"
        data-group-id={@selected_group.group_id}
        class="group-content"
      >
        <header
          id="member-group-header"
          class="group-head"
          data-group-id={@selected_group.group_id}
          aria-labelledby="member-group-name"
        >
          <div class="group-head__top">
            <div class="min-w-0">
              <h1 id="member-group-name" class="group-head__name">
                {@selected_group.name}
              </h1>
              <div
                id="member-group-metadata"
                class="group-head__meta"
                aria-label="Group details"
              >
                <span :if={custom_group?(@selected_group)}>Private group</span>
                <span
                  :if={not is_nil(@selected_group.active_member_count)}
                  id="member-group-member-count"
                >
                  {group_member_count_label(@selected_group.active_member_count)}
                </span>
                <span :if={not participating_group?}>You're not a member</span>
                <span
                  :if={participating_group? && custom_group?(@selected_group)}
                  class="group-head__you"
                >
                  <.icon name="hero-check" class="size-3" aria-hidden="true" /> You're a member
                </span>
                <.link
                  :if={@selected_group.email_address}
                  id="member-group-email-address"
                  class="group-head__addr"
                  href={"mailto:#{@selected_group.email_address}"}
                >
                  {@selected_group.email_address}
                </.link>
              </div>
            </div>
          </div>
        </header>

        <MemberDashboardGroupTabs.group_tabs
          :if={not ordinary_non_member?}
          active_tab={active_section}
          show_conversations={participating_group?}
          conversations_path={
            member_section_path(
              "conversations",
              @selected_club,
              club_id_source,
              selected_group_route_id
            )
          }
          members_path={
            member_section_path(
              "members",
              @selected_club,
              club_id_source,
              selected_group_route_id
            )
          }
        >
          <:conversations_action>
            <.button
              id="member-section-action-new-message"
              href={
                member_compose_path(
                  @selected_club,
                  club_id_source,
                  selected_group_route_id
                )
              }
              variant="primary"
              size="sm"
              data-section-action="conversations"
            >
              New message
            </.button>
          </:conversations_action>
          <:members_action :if={@can_add_custom_group_members?}>
            <.button
              id="member-section-action-add-group-member"
              type="button"
              variant="primary"
              size="sm"
              data-section-action="members"
              phx-click="open_custom_group_member_picker"
              aria-expanded={to_string(@custom_group_member_picker_open?)}
              aria-controls="custom-group-member-picker"
            >
              Add member
            </.button>
          </:members_action>
          <:members_action :if={
            not @can_add_custom_group_members? && participating_group? &&
              @current_member_can_manage_members?
          }>
            <.button
              id="member-section-action-invite-member"
              href={
                member_invitation_path(
                  @selected_club,
                  club_id_source,
                  selected_group_route_id
                )
              }
              variant="primary"
              size="sm"
              data-section-action="members"
            >
              Invite member
            </.button>
          </:members_action>
        </MemberDashboardGroupTabs.group_tabs>

        <section
          :if={ordinary_non_member?}
          id="member-group-access-guidance"
          class="access"
          aria-labelledby="member-group-access-title"
        >
          <div class="access__icon">
            <.icon name="hero-lock-closed" class="size-6" aria-hidden="true" />
          </div>
          <h2 id="member-group-access-title" class="access__title">
            {@selected_group.name} is a private group
          </h2>
          <p class="access__copy">
            Only people in {@selected_group.name} can read its conversations, get its emails,
            or see who's in it. You're a member of {@selected_club.name}, but not of {@selected_group.name}.
          </p>
          <p class="access__copy">
            Think you should be? Ask the club admins.
          </p>
          <p class="access__admin">
            Email the admins:
            <.link
              id="member-group-admin-email"
              href={"mailto:#{@club_admin_email_address}"}
            >
              {@club_admin_email_address}
            </.link>
          </p>
        </section>

        <div
          :if={participating_group?}
          id="member-section-panel-conversations"
          class="section-panel"
          data-panel="conversations"
          role="tabpanel"
          aria-labelledby="member-section-tab-conversations"
          tabindex="0"
          hidden={not active_member_section?(active_section, "conversations")}
        >
          <section id="club-messages">
            <.conversation_list rows={
              dashboard_conversation_rows(
                @message_rows,
                @selected_club,
                club_id_source,
                selected_group_route_id
              )
            }>
              <:empty_action>
                <.button
                  id="member-message-empty-send-link"
                  href={
                    member_compose_path(
                      @selected_club,
                      club_id_source,
                      selected_group_route_id
                    )
                  }
                  variant="secondary"
                >
                  <.icon name="hero-paper-airplane" class="size-4" /> Send the first message
                </.button>
              </:empty_action>
            </.conversation_list>
          </section>
        </div>

        <div
          :if={not ordinary_non_member?}
          id="member-section-panel-members"
          class="section-panel"
          data-panel="members"
          role="tabpanel"
          aria-labelledby="member-section-tab-members"
          tabindex="0"
          hidden={not active_member_section?(active_section, "members")}
        >
          <section id="club-members">
            <.outside_group_admin_notice
              :if={outside_admin? && @can_add_self_to_custom_group?}
              group_name={@selected_group.name}
            >
              <:add_self_action>
                <.button
                  id="member-group-add-self"
                  type="button"
                  size="sm"
                  data-custom-group-member-action="add-self"
                >
                  Add yourself to {@selected_group.name}
                </.button>
              </:add_self_action>
            </.outside_group_admin_notice>
            <.custom_group_member_picker
              :if={@can_add_custom_group_members? && @custom_group_member_picker_open?}
              club_name={@selected_club.name}
              group_name={@selected_group.name}
              candidates={@custom_group_member_candidates}
              query={@custom_group_member_picker_query}
              search_form={@custom_group_member_picker_form}
            >
              <:candidate_action :let={candidate}>
                <.button
                  id={"custom-group-member-candidate-add-#{candidate.id}"}
                  type="button"
                  variant="primary"
                  size="sm"
                  class="btn-outline"
                  data-custom-group-member-action="add"
                  data-membership-id={candidate.membership_id}
                  data-person-id={candidate.id}
                >
                  Add
                </.button>
              </:candidate_action>
            </.custom_group_member_picker>
            <.custom_group_membership_guidance
              :if={@can_add_custom_group_members?}
              club_name={@selected_club.name}
              group_name={@selected_group.name}
              viewer_access={selected_group_access}
            />
            <.member_list
              rows={@members}
              active_member_count={@active_member_count}
              current_member={@current_member}
              group_name={@selected_group.name}
            />
          </section>
        </div>
      </div>
    </div>
  </div>
</Layouts.club_site>
