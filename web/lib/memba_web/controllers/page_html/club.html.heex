<% club_id_source = assigns[:club_id_source] || "host" %>
<% active_section = assigns[:active_section] || "conversations" %>
<% selected_group_route_id = assigns[:selected_group_route_id] %>

<Layouts.club_site
  flash={@flash}
  club_name={@selected_club.name}
  current_identity={@current_identity}
  member_name={@current_member && @current_member.name}
  wide
>
  <div
    id="member-club-home"
    data-live-view="member-dashboard"
    data-club-id={@selected_club.club_id}
    data-selected-group-id={@selected_group.group_id}
    data-explicit-group-route={to_string(not is_nil(selected_group_route_id))}
    phx-hook="RememberGroupSelection"
    class="club-groups"
  >
    <div class="app-split">
      <nav id="member-group-rail" class="group-rail" aria-label="Groups">
        <div class="group-rail__label">Your groups</div>
        <.link
          :for={group <- @groups}
          id={"member-group-link-#{group.group_id}"}
          patch={
            member_section_path(
              "conversations",
              @selected_club,
              club_id_source,
              group.group_id
            )
          }
          class={member_group_rail_item_class(group, @selected_group)}
          data-testid="member-group-link"
          data-group-id={group.group_id}
          aria-current={member_group_aria_current(group, @selected_group)}
        >
          <span class="group-rail__name">{group.name}</span>
        </.link>
      </nav>

      <div
        id="member-group-content"
        data-group-id={@selected_group.group_id}
        class="group-content"
      >
        <header
          id="member-group-header"
          class="group-head"
          data-group-id={@selected_group.group_id}
          aria-labelledby="member-group-name"
        >
          <div class="group-head__top">
            <div class="min-w-0">
              <h1 id="member-group-name" class="group-head__name">
                {@selected_group.name}
              </h1>
              <div
                id="member-group-metadata"
                class="group-head__meta"
                aria-label="Group details"
              >
                <span id="member-group-member-count">
                  {group_member_count_label(@selected_group.active_member_count)}
                </span>
                <.link
                  :if={@selected_group.email_address}
                  id="member-group-email-address"
                  class="group-head__addr"
                  href={"mailto:#{@selected_group.email_address}"}
                >
                  {@selected_group.email_address}
                </.link>
              </div>
            </div>
            <div class="group-head__actions">
              <.button
                id="member-section-action-new-message"
                href={
                  member_compose_path(
                    @selected_club,
                    club_id_source,
                    selected_group_route_id
                  )
                }
                variant="primary"
                size="sm"
                data-section-action="conversations"
              >
                New message
              </.button>
            </div>
          </div>
        </header>

        <div id="member-section-tabs" class="section-tabs">
          <div
            id="member-section-tabs-list"
            class="section-tabs__list"
            role="tablist"
            aria-label="Club home sections"
            aria-orientation="horizontal"
            phx-hook=".SectionTabs"
          >
            <.link
              id="member-section-tab-conversations"
              patch={
                member_section_path(
                  "conversations",
                  @selected_club,
                  club_id_source,
                  selected_group_route_id
                )
              }
              class={member_section_tab_class(active_section, "conversations")}
              data-tab="conversations"
              role="tab"
              aria-selected={member_section_aria_selected(active_section, "conversations")}
              aria-controls="member-section-panel-conversations"
              tabindex={member_section_tab_index(active_section, "conversations")}
            >
              Conversations
            </.link>
            <.link
              id="member-section-tab-members"
              patch={
                member_section_path(
                  "members",
                  @selected_club,
                  club_id_source,
                  selected_group_route_id
                )
              }
              class={member_section_tab_class(active_section, "members")}
              data-tab="members"
              role="tab"
              aria-selected={member_section_aria_selected(active_section, "members")}
              aria-controls="member-section-panel-members"
              tabindex={member_section_tab_index(active_section, "members")}
            >
              Members
            </.link>
          </div>
          <div id="member-section-tabs-action" class="section-tabs__action">
            <.button
              :if={
                active_member_section?(active_section, "members") and
                  @current_member_can_manage_members?
              }
              id="member-section-action-invite-member"
              href={
                member_invitation_path(
                  @selected_club,
                  club_id_source,
                  selected_group_route_id
                )
              }
              variant="primary"
              size="sm"
              data-section-action="members"
            >
              Invite member
            </.button>
          </div>
        </div>

        <div
          id="member-section-panel-conversations"
          class="section-panel"
          data-panel="conversations"
          role="tabpanel"
          aria-labelledby="member-section-tab-conversations"
          tabindex="0"
          hidden={not active_member_section?(active_section, "conversations")}
        >
          <section id="club-messages">
            <.conversation_list
              rows={
                dashboard_conversation_rows(
                  @message_rows,
                  @selected_club,
                  club_id_source,
                  selected_group_route_id
                )
              }
            >
              <:empty_action>
                <.button
                  id="member-message-empty-send-link"
                  href={
                    member_compose_path(
                      @selected_club,
                      club_id_source,
                      selected_group_route_id
                    )
                  }
                  variant="secondary"
                >
                  <.icon name="hero-paper-airplane" class="size-4" /> Send the first message
                </.button>
              </:empty_action>
            </.conversation_list>
          </section>
        </div>

        <div
          id="member-section-panel-members"
          class="section-panel"
          data-panel="members"
          role="tabpanel"
          aria-labelledby="member-section-tab-members"
          tabindex="0"
          hidden={not active_member_section?(active_section, "members")}
        >
          <section id="club-members">
            <.member_list
              rows={@members}
              active_member_count={@active_member_count}
              current_member={@current_member}
            />
          </section>
        </div>
      </div>
    </div>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".SectionTabs">
    export default {
      mounted() {
        this.handleKeydown = event => {
          if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return

          const tabs = Array.from(this.el.querySelectorAll("[role='tab']"))
          const currentIndex = tabs.indexOf(event.target)

          if (currentIndex === -1) return

          let nextIndex

          switch (event.key) {
            case "ArrowRight":
              nextIndex = (currentIndex + 1) % tabs.length
              break
            case "ArrowLeft":
              nextIndex = (currentIndex - 1 + tabs.length) % tabs.length
              break
            case "Home":
              nextIndex = 0
              break
            case "End":
              nextIndex = tabs.length - 1
              break
            default:
              return
          }

          event.preventDefault()
          tabs[nextIndex].click()
          tabs[nextIndex].focus()
        }

        this.el.addEventListener("keydown", this.handleKeydown)
      },

      destroyed() {
        this.el.removeEventListener("keydown", this.handleKeydown)
      }
    }
  </script>
</Layouts.club_site>
