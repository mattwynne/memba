<div class="min-h-screen overflow-hidden bg-cream text-ink">
  <Layouts.site_header />

  <main>
    <section class="relative px-4 pb-16 pt-14 sm:px-6 sm:pt-24 lg:px-8 lg:pb-28">
      <div class="absolute left-1/2 top-0 -z-0 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-apricot-soft/70 blur-3xl lg:left-auto lg:right-0 lg:translate-x-1/3">
      </div>
      <div class="absolute -left-32 top-44 -z-0 h-80 w-80 rounded-full bg-sage-100/80 blur-3xl">
      </div>

      <div class="relative z-10 mx-auto grid max-w-7xl min-w-0 items-center gap-14 lg:grid-cols-[1.02fr_0.98fr]">
        <div class="min-w-0 max-w-3xl">
          <p class="max-w-[22rem] text-xs font-semibold uppercase tracking-[0.18em] text-sage-600 sm:max-w-none sm:text-sm sm:tracking-[0.22em]">
            Private member websites for volunteer-run groups
          </p>
          <h1 class="mt-5 max-w-[12ch] text-balance text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-ink sm:max-w-none sm:text-7xl sm:tracking-[-0.055em] lg:text-8xl">
            Volunteering shouldn’t feel like work.
          </h1>
          <p class="mt-7 max-w-3xl text-pretty text-lg leading-8 text-ink-2 sm:text-xl">
            Memba helps small non-profit groups, clubs, societies, and associations share member messages in one private place.
          </p>
          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <a
              href={~p"/get-started"}
              class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-sage-600 px-7 py-4 text-base font-semibold text-cream shadow-lg shadow-sage-800/10 transition duration-200 hover:-translate-y-0.5 hover:bg-sage-700 hover:shadow-xl sm:w-auto"
            >
              Request access for your group
            </a>
            <a
              href="#features"
              class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-line-strong bg-paper px-7 py-4 text-base font-semibold text-ink transition duration-200 hover:-translate-y-0.5 hover:border-sage-300 hover:bg-white sm:w-auto"
            >
              See what members can do
            </a>
          </div>
          <p class="mt-8 text-sm font-medium text-ink-3">
            Built for volunteer organizers, not full-time administrators.
          </p>
        </div>

        <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
          <div class="absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-sage-200/70 via-apricot-soft/80 to-paper blur-2xl">
          </div>

          <div class="relative rounded-[2rem] border border-line bg-paper p-4 shadow-2xl shadow-ink/10">
            <div class="rounded-[1.5rem] border border-line bg-cream p-5">
              <div class="flex items-center justify-between border-b border-line pb-5">
                <div>
                  <p class="text-sm font-semibold text-sage-700">
                    Kootenay Mountaineering Club
                  </p>
                  <p class="mt-1 text-xs text-ink-3">Private member space</p>
                </div>
                <span class="rounded-full bg-success-soft px-3 py-1 text-xs font-semibold text-success">
                  Members only
                </span>
              </div>

              <div class="mt-5 rounded-2xl bg-paper p-4 shadow-sm ring-1 ring-line">
                <p class="text-xs font-medium uppercase tracking-[0.18em] text-ink-3">
                  Latest member message
                </p>
                <h2 class="mt-3 text-xl font-semibold text-ink">Saturday trail day</h2>
                <p class="mt-2 text-sm leading-6 text-ink-2">
                  Meet at the trailhead at 9am. Bring gloves, lunch, and a thermos.
                </p>
              </div>

              <div class="mt-5 grid gap-3 sm:grid-cols-3">
                <div class="rounded-2xl bg-paper p-4 shadow-sm ring-1 ring-line">
                  <p class="text-xs font-medium uppercase tracking-[0.18em] text-ink-3">
                    Members
                  </p>
                  <p class="mt-3 text-3xl font-semibold text-ink">198</p>
                </div>
                <div class="rounded-2xl bg-paper p-4 shadow-sm ring-1 ring-line">
                  <p class="text-xs font-medium uppercase tracking-[0.18em] text-ink-3">
                    Messages
                  </p>
                  <p class="mt-3 text-3xl font-semibold text-ink">14</p>
                </div>
                <div class="rounded-2xl bg-paper p-4 shadow-sm ring-1 ring-line">
                  <p class="text-xs font-medium uppercase tracking-[0.18em] text-ink-3">
                    Updated
                  </p>
                  <p class="mt-3 text-3xl font-semibold text-apricot-deep">Today</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="border-y border-line bg-paper/70 px-6 py-16 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">Product</p>
          <h2 class="mt-3 text-4xl font-semibold tracking-tight text-ink">
            What Memba can help with today.
          </h2>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <article class="rounded-3xl border border-line bg-paper p-7 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
            <p class="text-sm font-semibold text-sage-700">01</p>
            <h3 class="mt-4 text-xl font-semibold text-ink">A private place for members</h3>
            <p class="mt-3 leading-7 text-ink-2">
              Members sign in to read group messages and see member-only information away from the public internet.
            </p>
          </article>
          <article class="rounded-3xl border border-line bg-paper p-7 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
            <p class="text-sm font-semibold text-sage-700">02</p>
            <h3 class="mt-4 text-xl font-semibold text-ink">One message to current members</h3>
            <p class="mt-3 leading-7 text-ink-2">
              Write a note once. Memba sends it to everyone with a current membership in the group.
            </p>
          </article>
          <article class="rounded-3xl border border-line bg-paper p-7 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
            <p class="text-sm font-semibold text-sage-700">03</p>
            <h3 class="mt-4 text-xl font-semibold text-ink">Clear delivery details</h3>
            <p class="mt-3 leading-7 text-ink-2">
              After sending, check whether each member’s email is delivered, still sending, or not delivered.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>
</div>
