<Layouts.app flash={@flash}>
  <section id="get-started" class="space-y-8">
    <div class="space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">
        Get started
      </p>
      <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Memba is invite-only right now.
      </h1>
      <p class="text-lg leading-8 text-ink-2">
        We’re working with a small number of clubs while we shape the product.
      </p>
    </div>

    <div class="rounded-3xl border border-line bg-paper p-6 shadow-sm sm:p-8">
      <h2 class="text-2xl font-semibold text-ink">Want to try Memba with your club?</h2>
      <p class="mt-4 leading-7 text-ink-2">
        Send us a short note with your name, your club, and what you’re hoping to improve.
      </p>
      <a
        id="contact-us-link"
        href="mailto:hello@memba.io?subject=Trying%20Memba%20with%20my%20club"
        class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-sage-600 px-6 py-3 text-sm font-semibold text-cream shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-sage-700 hover:shadow-md"
      >
        Contact us
      </a>
    </div>

    <p class="text-sm leading-6 text-ink-3">
      We use an email link for now instead of an open web form to keep spam down.
    </p>
  </section>
</Layouts.app>
