<Layouts.app flash={@flash}>
  <section id="get-started" class="space-y-8">
    <div class="space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">
        Request access
      </p>
      <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Ask us to set up Memba for your group.
      </h1>
      <p class="text-lg leading-8 text-ink-2">
        We review each request before creating a group space, so Memba stays safe for members.
      </p>
    </div>

    <div
      :if={@request_submitted?}
      id="get-started-request-acknowledgement"
      class="rounded-3xl border border-sage-200 bg-sage-50 p-6 shadow-sm sm:p-8"
    >
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sage-700">
        Request received
      </p>
      <h2 class="mt-3 text-2xl font-semibold text-ink">
        Thanks — we’ll read your request.
      </h2>
      <p class="mt-4 leading-7 text-ink-2">
        We’ll email you if Memba looks like a good fit for your group. Nothing has been created yet:
        no group space, membership, or sign-in access.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start">
      <div class="rounded-3xl border border-line bg-paper p-6 shadow-sm sm:p-8">
        <h2 class="text-2xl font-semibold text-ink">
          Want to use Memba with your club or group?
        </h2>
        <p class="mt-4 leading-7 text-ink-2">
          Tell us a little about your group. Memba staff will review your request before any group,
          membership, or sign-in access is created.
        </p>
        <ul class="mt-6 space-y-3 text-sm leading-6 text-ink-2">
          <li class="flex gap-3">
            <span class="mt-2 size-2 rounded-full bg-sage-600"></span>
            <span>Tell us who should be the first organizer.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-2 size-2 rounded-full bg-sage-600"></span>
            <span>
              Name the club, society, association, or group you want to bring onto Memba.
            </span>
          </li>
          <li class="flex gap-3">
            <span class="mt-2 size-2 rounded-full bg-sage-600"></span>
            <span>Share what you want Memba to help with.</span>
          </li>
        </ul>
      </div>

      <.form
        for={@request_form}
        action={~p"/get-started"}
        method="post"
        id="get-started-request-form"
        aria-label="Request Memba access"
        class="rounded-3xl border border-line bg-white p-6 shadow-sm sm:p-8"
      >
        <div class="space-y-5">
          <div
            :if={@signed_in_requester}
            id="get-started-signed-in-requester"
            data-testid="get-started-signed-in-requester"
            data-person-id={@signed_in_requester.person_id}
            class="rounded-2xl border border-sage-200 bg-sage-50 p-4"
          >
            <p class="text-sm font-semibold text-sage-800">
              You’re signed in, so we’ll use these details for your request.
            </p>
            <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
              <div>
                <dt class="font-medium text-ink-3">Name</dt>
                <dd class="mt-1 text-ink">{@signed_in_requester.name}</dd>
              </div>
              <div>
                <dt class="font-medium text-ink-3">Email</dt>
                <dd class="mt-1 text-ink">{@signed_in_requester.email}</dd>
              </div>
            </dl>
          </div>

          <%= unless @signed_in_requester do %>
            <.input
              field={@request_form[:requester_name]}
              id="get-started-requester-name"
              label="Your name"
              autocomplete="name"
              required
            />
            <.input
              field={@request_form[:requester_email]}
              id="get-started-requester-email"
              label="Email address"
              type="email"
              autocomplete="email"
              required
            />
          <% end %>

          <.input
            field={@request_form[:requested_club_name]}
            id="get-started-club-name"
            label="Group or club name"
            autocomplete="organization"
            required
          />
          <.input
            field={@request_form[:note]}
            id="get-started-note"
            label="What would you like Memba to help with?"
            type="textarea"
            rows="5"
            placeholder="Example: We want one reliable way to email all current members."
            required
          />
        </div>

        <.button
          id="get-started-request-submit"
          type="submit"
          variant="primary"
          class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-sage-600 px-6 py-3 text-sm font-semibold text-cream shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-sage-700 hover:shadow-md"
        >
          Request access
        </.button>

        <p class="mt-4 text-sm leading-6 text-ink-3">
          We’ll use these details only to review your Memba request.
        </p>
      </.form>
    </div>
  </section>
</Layouts.app>
