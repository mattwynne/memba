<Layouts.app flash={@flash}>
  <section class="space-y-8">
    <div class="space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">
        Terms of Service
      </p>
      <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Terms of Service
      </h1>
      <p class="text-sm text-ink-3">Last updated: 31 May 2026</p>
    </div>

    <div class="space-y-6 leading-8 text-ink-2">
      <p>
        These terms govern your use of Memba, a service provided by Red Donkey Technology Corp. By using Memba, you agree to use it lawfully and responsibly.
      </p>

      <div>
        <h2 class="text-xl font-semibold text-ink">Your responsibilities</h2>
        <p class="mt-2">
          You are responsible for the accuracy of the information you add to Memba and for ensuring that you have permission to contact the people whose details you store or message through the service.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-ink">Service availability</h2>
        <p class="mt-2">
          We aim to provide a reliable service, but we cannot promise that Memba will be uninterrupted or error-free at all times.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-ink">Changes</h2>
        <p class="mt-2">
          We may update these terms as the service develops. When we make material changes, we will take reasonable steps to make them clear.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-ink">Contact</h2>
        <p class="mt-2">
          For questions about these terms, contact Red Donkey Technology Corp through <a
            href="https://donkey.red"
            class="font-semibold text-sage-700 underline decoration-sage-300 underline-offset-4 hover:text-sage-800"
          >
            donkey.red
          </a>.
        </p>
      </div>
    </div>
  </section>
</Layouts.app>
