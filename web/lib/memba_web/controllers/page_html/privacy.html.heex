<Layouts.app flash={@flash}>
  <section class="space-y-8">
    <div class="space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">Privacy Policy</p>
      <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Privacy Policy
      </h1>
      <p class="text-sm text-ink-3">Last updated: 31 May 2026</p>
    </div>

    <div class="space-y-6 leading-8 text-ink-2">
      <p>
        Memba stores information that clubs need to manage membership and communicate with members. We treat that information with care.
      </p>

      <div>
        <h2 class="text-xl font-semibold text-ink">Information we process</h2>
        <p class="mt-2">
          Memba may process club, member, contact, message, and delivery information entered by club operators or generated while sending messages.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-ink">How we use information</h2>
        <p class="mt-2">
          We use information to provide the service, maintain membership records, send messages, report delivery status, improve reliability, and protect the service from misuse.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-ink">Sharing</h2>
        <p class="mt-2">
          We do not sell member data. We may share information with service providers when needed to operate Memba, such as hosting, email delivery, monitoring, and support providers.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-ink">Contact</h2>
        <p class="mt-2">
          For privacy questions, contact Red Donkey Technology Corp through <a
            href="https://donkey.red"
            class="font-semibold text-sage-700 underline decoration-sage-300 underline-offset-4 hover:text-sage-800"
          >
            donkey.red
          </a>.
        </p>
      </div>
    </div>
  </section>
</Layouts.app>
