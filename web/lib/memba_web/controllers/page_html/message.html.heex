<Layouts.club_site
  flash={@flash}
  club_name={@selected_club.name}
  current_identity={@current_identity}
>
  <div
    id="member-message-detail"
    data-club-id={@selected_club.club_id}
    data-message-id={@message.message_id}
    class="space-y-8"
  >
    <a
      id="back-to-club-home-link"
      href={~p"/?#{[club_id: @selected_club.club_id]}"}
      class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--club-site-accent)] transition hover:text-[var(--club-site-ink)]"
    >
      <.icon name="hero-arrow-left" class="size-4" /> Club home
    </a>

    <section class="overflow-hidden rounded-3xl border border-[var(--club-site-line)] bg-[var(--club-site-paper)] p-8 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--club-site-accent)]">
        Club message
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--club-site-ink)]">
        {@message.subject}
      </h1>
      <p id="member-message-meta" class="mt-4 text-sm font-medium text-[var(--club-site-muted)]">
        From <span class="text-[var(--club-site-ink)]">{@sender_name}</span>
        · to <span class="text-[var(--club-site-ink)]">{@member_receipt_count}</span>
        member{if(@member_receipt_count == 1, do: "", else: "s")}
      </p>
      <p
        id="member-message-body"
        class="mt-8 whitespace-pre-wrap rounded-2xl border border-[var(--club-site-line)] bg-[var(--club-site-bg)] p-6 leading-7 text-[var(--club-site-ink)]"
      >
        {@message.body}
      </p>
    </section>

    <section
      id="member-receipts-section"
      class="rounded-3xl border border-[var(--club-site-line)] bg-[var(--club-site-paper)] p-8 shadow-sm"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--club-site-accent)]">
            Receipts
          </p>
          <h2 class="mt-2 flex items-center gap-2 text-2xl font-semibold text-[var(--club-site-ink)]">
            <.icon name="hero-users" class="size-5" /> Everyone addressed
          </h2>
        </div>
        <p
          id="member-receipts-summary"
          data-receipt-count={@member_receipt_count}
          class="rounded-full border border-[var(--club-site-line)] px-3 py-1 text-sm font-semibold text-[var(--club-site-muted)]"
        >
          {@member_receipt_count} member{if(@member_receipt_count == 1, do: "", else: "s")}
        </p>
      </div>

      <div id="member-receipts" class="mt-6 space-y-4">
        <p
          :if={@member_receipts == []}
          id="member-receipts-empty"
          class="rounded-2xl border border-dashed border-[var(--club-site-line)] bg-[var(--club-site-bg)] p-5 text-sm text-[var(--club-site-muted)]"
        >
          No addressed members are projected for this message yet.
        </p>

        <section
          :for={group <- @member_receipt_groups}
          id={"member-receipt-group-#{String.replace(group.status, " ", "-")}"}
          data-testid="member-receipt-group"
          data-receipt-status={group.status}
          class="overflow-hidden rounded-2xl border border-[var(--club-site-line)] bg-[var(--club-site-bg)]"
        >
          <header class="flex items-center justify-between gap-4 border-b border-[var(--club-site-line)] bg-[var(--club-site-paper)] px-5 py-4">
            <h3 class="flex items-center gap-2 font-semibold text-[var(--club-site-ink)]">
              <.icon name={group.status_icon} class="size-5 text-[var(--club-site-accent)]" />
              <span>{group.status_label}</span>
            </h3>
            <span
              data-testid="receipt-group-count"
              class="rounded-full bg-[var(--club-site-bg)] px-3 py-1 text-sm font-semibold text-[var(--club-site-muted)]"
            >
              {group.count}
            </span>
          </header>

          <div
            id={"member-receipts-#{String.replace(group.status, " ", "-")}"}
            class="divide-y divide-[var(--club-site-line)]"
          >
            <div
              :for={receipt <- group.receipts}
              id={"member-receipt-#{receipt.recipient_id}"}
              data-testid="member-receipt"
              data-recipient-id={receipt.recipient_id}
              data-recipient-name={receipt.recipient_name}
              data-receipt-status={receipt.status}
              class="flex flex-col gap-2 px-5 py-4 sm:flex-row sm:items-center sm:justify-between"
            >
              <p class="font-semibold text-[var(--club-site-ink)]">{receipt.recipient_name}</p>
              <p
                data-testid="receipt-status"
                data-receipt-status={receipt.status}
                class="inline-flex items-center gap-2 rounded-full bg-[var(--club-site-paper)] px-3 py-1 text-sm font-semibold text-[var(--club-site-muted)] ring-1 ring-[var(--club-site-line)]"
              >
                <.icon
                  name={receipt.status_icon}
                  data-testid="receipt-status-icon"
                  data-icon-name={receipt.status_icon}
                  class="size-4 text-[var(--club-site-accent)]"
                />
                <span>{receipt.status_label}</span>
              </p>
            </div>
          </div>
        </section>
      </div>
    </section>
  </div>
</Layouts.club_site>
