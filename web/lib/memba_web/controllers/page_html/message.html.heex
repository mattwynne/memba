<Layouts.club_site
  flash={@flash}
  club_name={@selected_club.name}
  current_identity={@current_identity}
>
  <div
    id="member-message-detail"
    data-live-view="member-message-detail"
    data-club-id={@selected_club.club_id}
    data-message-id={@message.message_id}
    class="mx-auto max-w-3xl"
  >
    <.link
      id="back-to-club-home-link"
      href={~p"/?#{[club_id: @selected_club.club_id]}"}
      class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--club-site-muted)] transition duration-200 hover:text-[var(--club-site-ink)]"
    >
      <.icon name="hero-arrow-left" class="size-4" /> Club home
    </.link>

    <section class="mt-5 border-b border-[var(--club-site-line)] pb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--club-site-muted)]">
        Club message
      </p>
      <h1 class="mt-2 text-4xl font-semibold leading-tight tracking-tight text-[var(--club-site-ink)] sm:text-5xl">
        {@message.subject}
      </h1>
      <p id="member-message-meta" class="mt-4 text-sm leading-6 text-[var(--club-site-muted)]">
        From <span class="font-semibold text-[var(--club-site-ink)]">{@sender_name}</span>
        · to
        <span class="font-semibold text-[var(--club-site-ink)]">
          {@member_email_delivery_count}
        </span>
        member{if(@member_email_delivery_count == 1, do: "", else: "s")}
      </p>
      <p
        id="member-message-body"
        class="mt-6 whitespace-pre-wrap text-base leading-8 text-[var(--club-site-muted)]"
      >
        {@message.body}
      </p>
    </section>

    <section id="member-receipt-summary" class="mt-8">
      <div class="rounded-3xl border border-[var(--club-site-line)] bg-[var(--club-site-paper)] p-5 shadow-sm sm:p-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <h2 class="flex items-center gap-2 text-base font-semibold text-[var(--club-site-ink)]">
            <.icon name="hero-users" class="size-5 text-[var(--club-site-accent)]" /> Who got this
          </h2>
          <p
            id="member-receipts-summary"
            data-receipt-count={@member_email_delivery_count}
            class="w-fit rounded-full border border-[var(--club-site-line)] bg-[var(--club-site-bg)] px-3 py-1 text-sm font-semibold text-[var(--club-site-muted)]"
          >
            {@member_email_delivery_count} member{if(@member_email_delivery_count == 1,
              do: "",
              else: "s"
            )}
          </p>
        </div>

        <div
          id="member-receipt-summary-bar"
          class="mt-5 flex h-3.5 overflow-hidden rounded-full bg-slate-100 ring-1 ring-inset ring-[var(--club-site-line)]"
          aria-hidden="true"
        >
          <span
            :for={status <- @member_email_delivery_summary}
            data-testid="member-receipt-summary-bar-segment"
            data-receipt-status={status.status}
            data-receipt-count={status.count}
            data-receipt-percentage={status.percentage}
            class={["block h-full", status_bg_class(status.status)]}
            style={receipt_bar_width(status)}
          />
        </div>

        <div id="member-receipt-summary-legend" class="mt-5 grid gap-3 sm:grid-cols-2">
          <div
            :for={status <- @member_email_delivery_summary}
            data-testid="member-receipt-summary-status"
            data-receipt-status={status.status}
            data-receipt-count={status.count}
            data-receipt-percentage={status.percentage}
            class="flex items-center gap-3 rounded-2xl border border-[var(--club-site-line)] bg-[var(--club-site-bg)] px-4 py-3"
          >
            <span class={["size-2.5 rounded-[0.2rem]", status_bg_class(status.status)]} />
            <span class="min-w-0 flex-1 text-sm text-[var(--club-site-muted)]">
              <span class="block font-semibold text-[var(--club-site-ink)]">
                {status.status_label}
              </span>
              <span class="block text-xs">{status.description}</span>
            </span>
            <span class="font-mono text-sm font-semibold text-[var(--club-site-ink)]">
              {status.count}
            </span>
            <span class="font-mono text-xs font-semibold text-[var(--club-site-muted)]">
              {status.percentage}%
            </span>
          </div>
        </div>
      </div>
    </section>

    <section id="member-receipts-section" class="mt-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-base font-semibold text-[var(--club-site-ink)]">Everyone, by status</h2>
          <p class="mt-1 text-sm text-[var(--club-site-muted)]">
            Receipt groups are ordered by opened, delivered, sending, then delivery problems.
          </p>
        </div>
      </div>

      <div id="member-receipts" class="mt-5 space-y-3">
        <p
          :if={@member_email_delivery_groups == []}
          id="member-receipts-empty"
          class="rounded-2xl border border-dashed border-[var(--club-site-line)] bg-[var(--club-site-paper)] p-5 text-sm text-[var(--club-site-muted)]"
        >
          No addressed members are projected for this message yet.
        </p>

        <section
          :for={group <- @member_email_delivery_groups}
          id={"member-receipt-group-#{status_slug(group.status)}"}
          data-testid="member-receipt-group"
          data-receipt-status={group.status}
          class="overflow-hidden rounded-2xl border border-[var(--club-site-line)] bg-[var(--club-site-paper)] shadow-sm"
        >
          <header>
            <button
              type="button"
              id={"member-receipt-group-toggle-#{status_slug(group.status)}"}
              phx-click="toggle_receipt_group"
              phx-value-status={group.status}
              aria-expanded={
                to_string(receipt_group_expanded?(@expanded_receipt_groups, group.status))
              }
              aria-controls={"member-receipts-#{status_slug(group.status)}"}
              class="flex w-full items-center gap-3 px-5 py-4 text-left transition duration-200 hover:bg-[var(--club-site-bg)]"
            >
              <span class={[
                "grid size-9 shrink-0 place-items-center rounded-xl ring-1 ring-inset",
                status_tint_class(group.status)
              ]}>
                <.icon name={group.status_icon} class="size-5" />
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="font-semibold text-[var(--club-site-ink)]">{group.status_label}</h3>
                <p class="mt-0.5 text-sm text-[var(--club-site-muted)]">{group.description}</p>
              </div>
              <div class="flex items-center gap-3">
                <span
                  data-testid="receipt-group-count"
                  class="font-mono text-sm font-semibold text-[var(--club-site-ink)]"
                >
                  {group.count}
                </span>
                <span
                  data-testid="receipt-group-percentage"
                  class="font-mono text-xs font-semibold text-[var(--club-site-muted)]"
                >
                  {group.percentage}%
                </span>
                <.icon
                  name={
                    if(receipt_group_expanded?(@expanded_receipt_groups, group.status),
                      do: "hero-chevron-up",
                      else: "hero-chevron-down"
                    )
                  }
                  class="size-4 text-[var(--club-site-muted)]"
                />
              </div>
            </button>
          </header>

          <div
            :if={receipt_group_expanded?(@expanded_receipt_groups, group.status)}
            id={"member-receipts-#{status_slug(group.status)}"}
            class="divide-y divide-[var(--club-site-line)] border-t border-[var(--club-site-line)] px-5 py-1"
          >
            <div
              :for={receipt <- group.receipts}
              id={"member-receipt-#{receipt.recipient_id}"}
              data-testid="member-receipt"
              data-recipient-id={receipt.recipient_id}
              data-recipient-name={receipt.recipient_name}
              data-receipt-status={receipt.status}
              class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="flex min-w-0 items-center gap-3">
                <span class={[
                  "grid size-8 shrink-0 place-items-center rounded-full text-xs font-bold ring-1 ring-inset",
                  status_tint_class(receipt.status)
                ]}>
                  {receipt_recipient_initial(receipt.recipient_name)}
                </span>
                <p class="truncate font-medium text-[var(--club-site-ink)]">
                  {receipt.recipient_name}
                </p>
              </div>
              <p
                data-testid="receipt-status"
                data-receipt-status={receipt.status}
                class={[
                  "inline-flex w-fit items-center gap-2 rounded-full px-3 py-1 text-sm font-semibold ring-1 ring-inset",
                  status_tint_class(receipt.status)
                ]}
              >
                <.icon
                  name={receipt.status_icon}
                  data-testid="receipt-status-icon"
                  data-icon-name={receipt.status_icon}
                  class={["size-4", status_text_class(receipt.status)]}
                />
                <span>{receipt.status_label}</span>
              </p>
            </div>
          </div>
        </section>
      </div>
    </section>
  </div>
</Layouts.club_site>
