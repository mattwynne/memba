<Layouts.club_site
  flash={@flash}
  club_name={@selected_club.name}
  current_identity={@current_identity}
  member_name={@current_member && @current_member.name}
>
  <div
    id="member-message-detail"
    data-live-view="member-message-detail"
    data-club-id={@selected_club.club_id}
    data-message-id={@message.message_id}
    data-reply-state={@reply_state}
    class="mx-auto max-w-3xl"
  >
    <.link
      id="back-to-club-home-link"
      href={member_club_home_path(@selected_club, Map.get(@route_params, "club_id_source"))}
      class="inline-flex items-center gap-2 text-sm font-semibold text-ink-2 transition duration-200 hover:text-base-content"
    >
      <.icon name="hero-arrow-left" class="size-4" /> Club home
    </.link>

    <section class="mt-5 border-b border-base-300 pb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-2">
        Club conversation
      </p>
      <div id="member-message-heading-row" class="detail-head mt-2">
        <div class="detail-head__main">
          <h1
            id="member-message-subject"
            class="text-4xl font-semibold leading-tight tracking-tight text-base-content sm:text-5xl"
          >
            {@message.subject}
          </h1>
        </div>

        <label
          id="member-conversation-follow-control"
          data-following={to_string(@following_conversation)}
          data-can-follow={to_string(@can_follow_conversation)}
          class="follow-toggle"
        >
          <input
            id="member-conversation-follow-toggle"
            type="checkbox"
            class="toggle toggle-primary toggle-sm"
            checked={@following_conversation}
            phx-change={
              if(@following_conversation,
                do: "unfollow_conversation",
                else: "follow_conversation"
              )
            }
            aria-label="Follow this conversation"
          />
          <span class="follow-toggle__text">
            <strong>{if(@following_conversation, do: "Following", else: "Not following")}</strong>
            <span>
              {if(@following_conversation,
                do: "Emailed on new replies",
                else: "Not emailed on replies"
              )}
            </span>
          </span>
        </label>
      </div>
      <p id="member-message-meta" class="mt-4 text-sm leading-6 text-ink-2">
        From <span class="font-semibold text-base-content">{@sender_name}</span>
        · sent to
        <span class="font-semibold text-base-content">
          {@member_email_delivery_count}
        </span>
        member{if(@member_email_delivery_count == 1, do: "", else: "s")}
      </p>
    </section>

    <section
      id="member-conversation"
      data-message-count={Enum.count(@conversation_entries)}
      class="mt-8 space-y-5"
    >
      <% {original_entries, reply_entries} = split_conversation_entries(@conversation_entries) %>

      <div id="member-conversation-original" class="space-y-4">
        <.conversation_entry_card :for={entry <- original_entries} entry={entry} />
      </div>

      <section
        id="member-message-reply-composer"
        class="rounded-3xl border border-primary/20 bg-primary/5 p-5 shadow-sm sm:p-6"
      >
        <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h2 class="flex items-center gap-2 text-base font-semibold text-base-content">
              <.icon name="hero-chat-bubble-left-right" class="size-5 text-primary" />
              Reply to this conversation
            </h2>
            <p class="mt-1 text-sm leading-6 text-ink-2">
              Your reply inherits the subject and is emailed to current followers except you.
            </p>
          </div>
          <p
            :if={@current_member}
            id="member-message-reply-from"
            data-sender-id={@current_member.id}
            class="w-fit rounded-full border border-base-300 bg-base-100 px-3 py-1 text-sm font-semibold text-ink-2"
          >
            Replying as <span class="text-base-content">{@current_member.name}</span>
          </p>
        </div>

        <p
          :if={@reply_state == :posted}
          id="member-message-reply-success"
          class="mt-4 rounded-2xl border border-success/20 bg-success-soft px-4 py-3 text-sm font-semibold text-success"
        >
          Your reply is being sent.
        </p>

        <p
          :if={@reply_state == :failed}
          id="member-message-reply-error"
          data-reply-error={inspect(@reply_error)}
          class="mt-4 rounded-2xl border border-error/20 bg-error-soft px-4 py-3 text-sm font-semibold text-error"
        >
          Your reply was not sent. Please try again.
        </p>

        <.form
          for={@reply_form}
          id="member-message-reply-form"
          phx-submit="post_reply"
          class="mt-5 grid gap-4"
        >
          <.input
            field={@reply_form[:body]}
            id="member-message-reply-body-input"
            label="Reply"
            type="textarea"
            placeholder="Write your reply to the club."
            rows="5"
            class="min-h-32 w-full resize-y rounded-lg border border-base-300 bg-base-100 px-4 py-3 text-base-content placeholder:text-ink-2 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/15"
          />
          <p
            :if={@reply_body_error}
            id="member-message-reply-body-error"
            class="text-sm font-semibold text-error"
          >
            {@reply_body_error}
          </p>

          <div class="flex flex-col gap-3 sm:flex-row">
            <.button
              id="member-message-reply-submit-button"
              type="submit"
              variant="primary"
              size="lg"
              disabled={is_nil(@current_member)}
            >
              <.icon name="hero-paper-airplane" class="size-4" /> Post reply
            </.button>
          </div>
        </.form>
      </section>

      <div id="member-conversation-replies" class="space-y-4">
        <.conversation_entry_card :for={entry <- reply_entries} entry={entry} />
      </div>
    </section>

    <section id="member-receipt-summary" class="mt-8">
      <div class="rounded-3xl border border-base-300 bg-base-100 p-5 shadow-sm sm:p-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <h2 class="flex items-center gap-2 text-base font-semibold text-base-content">
            <.icon name="hero-users" class="size-5 text-primary" /> Message delivery
          </h2>
          <p
            id="member-receipts-summary"
            data-receipt-count={@member_email_delivery_count}
            class="w-fit rounded-full border border-base-300 bg-base-200 px-3 py-1 text-sm font-semibold text-ink-2"
          >
            {@member_email_delivery_count} member{if(@member_email_delivery_count == 1,
              do: "",
              else: "s"
            )}
          </p>
        </div>

        <div
          id="member-receipt-summary-bar"
          class="mt-5 flex h-3.5 overflow-hidden rounded-full bg-base-200 ring-1 ring-inset ring-base-300"
          aria-hidden="true"
        >
          <span
            :for={status <- @member_email_delivery_summary}
            data-testid="member-receipt-summary-bar-segment"
            data-receipt-status={status.status}
            data-receipt-count={status.count}
            data-receipt-percentage={status.percentage}
            class={["block h-full", status_bg_class(status.status)]}
            style={receipt_bar_width(status)}
          />
        </div>

        <div id="member-receipt-summary-legend" class="mt-5 grid gap-3 sm:grid-cols-2">
          <div
            :for={status <- @member_email_delivery_summary}
            data-testid="member-receipt-summary-status"
            data-receipt-status={status.status}
            data-receipt-count={status.count}
            data-receipt-percentage={status.percentage}
            class="flex items-center gap-3 rounded-2xl border border-base-300 bg-base-200 px-4 py-3"
          >
            <span class={["size-2.5 rounded-[0.2rem]", status_bg_class(status.status)]} />
            <span class="min-w-0 flex-1 text-sm text-ink-2">
              <span class="block font-semibold text-base-content">
                {status.status_label}
              </span>
              <span class="block text-xs">{status.description}</span>
            </span>
            <span class="font-mono text-sm font-semibold text-base-content">
              {status.count}
            </span>
            <span class="font-mono text-xs font-semibold text-ink-2">
              {status.percentage}%
            </span>
          </div>
        </div>
      </div>
    </section>

    <section id="member-receipts-section" class="mt-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-base font-semibold text-base-content">
            Members by delivery status
          </h2>
          <p class="mt-1 text-sm text-ink-2">
            Delivered messages are shown first. Messages still sending or not delivered are grouped below.
          </p>
        </div>
      </div>

      <div id="member-receipts" class="mt-5 space-y-3">
        <p
          :if={@member_email_delivery_groups == []}
          id="member-receipts-empty"
          class="rounded-2xl border border-dashed border-base-300 bg-base-100 p-5 text-sm text-ink-2"
        >
          Memba has not prepared the delivery list for this message yet. Check again in a moment.
        </p>

        <section
          :for={group <- @member_email_delivery_groups}
          id={"member-receipt-group-#{status_slug(group.status)}"}
          data-testid="member-receipt-group"
          data-receipt-status={group.status}
          class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm"
        >
          <header>
            <.button
              type="button"
              id={"member-receipt-group-toggle-#{status_slug(group.status)}"}
              phx-click="toggle_receipt_group"
              phx-value-status={group.status}
              aria-expanded={
                to_string(receipt_group_expanded?(@expanded_receipt_groups, group.status))
              }
              aria-controls={"member-receipts-#{status_slug(group.status)}"}
              variant="ghost"
              class="h-auto min-h-0 w-full justify-start gap-3 rounded-none px-5 py-4 text-left font-normal normal-case hover:bg-base-200"
            >
              <span class={[
                "grid size-9 shrink-0 place-items-center rounded-xl ring-1 ring-inset",
                status_tint_class(group.status)
              ]}>
                <.icon name={group.status_icon} class="size-5" />
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="font-semibold text-base-content">{group.status_label}</h3>
                <p class="mt-0.5 text-sm text-ink-2">{group.description}</p>
              </div>
              <div class="flex items-center gap-3">
                <span
                  data-testid="receipt-group-count"
                  class="font-mono text-sm font-semibold text-base-content"
                >
                  {group.count}
                </span>
                <span
                  data-testid="receipt-group-percentage"
                  class="font-mono text-xs font-semibold text-ink-2"
                >
                  {group.percentage}%
                </span>
                <.icon
                  name={
                    if(receipt_group_expanded?(@expanded_receipt_groups, group.status),
                      do: "hero-chevron-up",
                      else: "hero-chevron-down"
                    )
                  }
                  class="size-4 text-ink-2"
                />
              </div>
            </.button>
          </header>

          <div
            :if={receipt_group_expanded?(@expanded_receipt_groups, group.status)}
            id={"member-receipts-#{status_slug(group.status)}"}
            class="divide-y divide-base-300 border-t border-base-300 px-5 py-1"
          >
            <div
              :for={receipt <- group.receipts}
              id={"member-receipt-#{receipt.recipient_id}"}
              data-testid="member-receipt"
              data-recipient-id={receipt.recipient_id}
              data-recipient-name={receipt.recipient_name}
              data-receipt-status={receipt.status}
              class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="flex min-w-0 items-center gap-3">
                <span class={[
                  "grid size-8 shrink-0 place-items-center rounded-full text-xs font-bold ring-1 ring-inset",
                  status_tint_class(receipt.status)
                ]}>
                  {receipt_recipient_initial(receipt.recipient_name)}
                </span>
                <p class="truncate font-medium text-base-content">
                  {receipt.recipient_name}
                </p>
              </div>
              <span class="inline-flex w-fit items-center gap-2">
                <.icon
                  name={receipt.status_icon}
                  data-testid="receipt-status-icon"
                  data-icon-name={receipt.status_icon}
                  class={["size-4", status_text_class(receipt.status)]}
                />
                <.status_badge
                  data-testid="receipt-status"
                  data-receipt-status={receipt.status}
                  aria-label={"Delivery status for #{receipt.recipient_name}: #{receipt.status_label}"}
                  label={receipt.status_label}
                  tone={receipt.status_tone}
                />
              </span>
            </div>
          </div>
        </section>
      </div>
    </section>
  </div>
</Layouts.club_site>
