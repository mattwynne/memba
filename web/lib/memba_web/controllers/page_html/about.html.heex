<Layouts.app flash={@flash}>
  <section class="space-y-8">
    <div class="space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">About Memba</p>
      <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Membership software for clubs that run on trust.
      </h1>
      <p class="text-lg leading-8 text-ink-2">
        Memba helps volunteer-run clubs keep accurate member records and send important messages with confidence.
      </p>
    </div>

    <div class="space-y-5 leading-8 text-ink-2">
      <p>
        Clubs depend on people who give their time freely. Memba is designed to make their work calmer: fewer spreadsheets, fewer mysteries, and fewer missed messages.
      </p>
      <p>
        The product is built by Red Donkey Technology Corp. We focus on simple, reliable tools for small organisations that need clarity more than clutter.
      </p>
      <p>
        If you would like to learn more about the company, visit <a
          href="https://donkey.red"
          class="font-semibold text-sage-700 underline decoration-sage-300 underline-offset-4 hover:text-sage-800"
        >
          donkey.red
        </a>.
      </p>
    </div>
  </section>
</Layouts.app>
