<%= if @current_identity do %>
  <div id="signed-in-home" class="min-h-screen bg-cream text-ink">
    <header class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-6 lg:px-8">
      <a href={~p"/"} class="transition duration-200 hover:opacity-80" aria-label="Memba home">
        <.logo />
      </a>

      <nav class="flex items-center gap-3 text-sm font-medium" aria-label="Signed-in navigation">
        <span class="hidden text-ink-2 sm:inline">Signed in as {@current_identity_email}</span>
        <%= if @current_identity_staff? do %>
          <a
            id="admin-home-link"
            href={~p"/admin/clubs"}
            class="rounded-full border border-sage-600 bg-sage-600 px-5 py-2.5 font-semibold text-cream shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-sage-700 hover:shadow-md"
          >
            Memba staff
          </a>
        <% end %>
        <.form for={%{}} action={~p"/auth"} method="delete" id="home-sign-out-form">
          <button
            id="home-sign-out-button"
            type="submit"
            class="rounded-full border border-line-strong bg-paper px-5 py-2.5 font-semibold text-ink transition duration-200 hover:-translate-y-0.5 hover:bg-white"
          >
            Sign out
          </button>
        </.form>
      </nav>
    </header>

    <main class="px-6 pb-20 pt-10 lg:px-8">
      <section class="mx-auto max-w-7xl">
        <% club_count = length(@current_identity_clubs) %>
        <% club_noun = if club_count == 1, do: "club", else: "clubs" %>

        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">
            Your memberships
          </p>
          <h1 class="mt-3 text-5xl font-semibold tracking-tight text-ink sm:text-6xl">
            Your clubs
          </h1>
          <p class="mt-5 text-lg leading-8 text-ink-2">
            You’re a member of {club_count} {club_noun}. Choose one of the clubs below to visit their website.
          </p>
        </div>

        <%= if @current_identity_clubs == [] do %>
          <div
            id="my-clubs-empty"
            class="mt-10 rounded-3xl border border-line bg-paper p-8 shadow-sm"
          >
            <h2 class="text-xl font-semibold text-ink">No clubs yet</h2>
            <p class="mt-3 leading-7 text-ink-2">
              We did not find any active club memberships for this email address.
            </p>
          </div>
        <% else %>
          <div id="my-clubs" class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            <a
              :for={club <- @current_identity_clubs}
              id={"my-club-link-#{club.club_id}"}
              data-testid="my-club-link"
              aria-label={"Visit #{club.name}"}
              href={~p"/?#{[club_id: club.club_id]}"}
              class="group block rounded-3xl border border-line bg-paper p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg focus:outline-none focus:ring-4 focus:ring-sage-200"
            >
              <article id={"my-club-#{club.club_id}"}>
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sage-600">
                      Active member
                    </p>
                    <h2 class="mt-3 text-2xl font-semibold text-ink">{club.name}</h2>
                  </div>
                  <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-sage-100 text-sage-700 transition duration-200 group-hover:bg-sage-200">
                    <.sprig class="h-6 w-6" />
                  </div>
                </div>

                <span class="mt-6 inline-flex items-center justify-center rounded-full bg-sage-600 px-5 py-3 text-sm font-semibold text-cream shadow-sm transition duration-200 group-hover:-translate-y-0.5 group-hover:bg-sage-700 group-hover:shadow-md">
                  Visit club
                </span>
              </article>
            </a>
          </div>
        <% end %>

        <%= if @current_identity_staff? do %>
          <section class="mt-10 rounded-3xl border border-sage-200 bg-sage-50 p-8">
            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-700">
                  Memba staff
                </p>
                <h2 class="mt-2 text-2xl font-semibold text-ink">Memba staff access</h2>
                <p class="mt-2 text-ink-2">
                  Memba staff can open the Memba staff area.
                </p>
              </div>
              <a
                href={~p"/admin/clubs"}
                class="inline-flex items-center justify-center rounded-full border border-sage-600 bg-paper px-5 py-3 text-sm font-semibold text-sage-700 transition duration-200 hover:-translate-y-0.5 hover:bg-white"
              >
                Open Memba staff area
              </a>
            </div>
          </section>
        <% end %>
      </section>
    </main>
  </div>
<% else %>
  <div class="min-h-screen overflow-hidden bg-cream text-ink">
    <header class="relative z-20 mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-8">
      <a href={~p"/"} class="transition duration-200 hover:opacity-80" aria-label="Memba home">
        <.logo />
      </a>

      <nav
        class="hidden items-center gap-8 text-sm font-medium text-ink-2 md:flex"
        aria-label="Main navigation"
      >
        <a href="#features" class="transition hover:text-ink">Product</a>
        <a href={~p"/about"} class="transition hover:text-ink">About</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          href={~p"/auth"}
          class="hidden rounded-full border border-line-strong bg-paper px-5 py-2.5 text-sm font-semibold text-ink transition duration-200 hover:-translate-y-0.5 hover:bg-white sm:inline-flex"
        >
          Sign in
        </a>
        <a
          href={~p"/get-started"}
          class="rounded-full border border-sage-600 bg-sage-600 px-5 py-2.5 text-sm font-semibold text-cream shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-sage-700 hover:shadow-md"
        >
          Get started
        </a>
      </div>
    </header>

    <main>
      <section class="relative px-6 pb-20 pt-16 sm:pt-24 lg:px-8 lg:pb-28">
        <div class="absolute left-1/2 top-0 -z-0 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-apricot-soft/70 blur-3xl lg:left-auto lg:right-0 lg:translate-x-1/3">
        </div>
        <div class="absolute -left-32 top-44 -z-0 h-80 w-80 rounded-full bg-sage-100/80 blur-3xl">
        </div>

        <div class="relative z-10 mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-[1.02fr_0.98fr]">
          <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.22em] text-sage-600">
              Membership software for clubs
            </p>
            <h1 class="mt-5 text-balance text-6xl font-semibold leading-[0.95] tracking-[-0.055em] text-ink sm:text-7xl lg:text-8xl">
              Volunteering shouldn’t feel like work.
            </h1>
            <p class="mt-7 max-w-3xl text-pretty text-lg leading-8 text-ink-2 sm:text-xl">
              Membership software for clubs and societies run by volunteers. Renewals, events, and messages — in one place.
            </p>
            <div class="mt-10 flex flex-col gap-4 sm:flex-row">
              <a
                href={~p"/get-started"}
                class="inline-flex min-h-12 items-center justify-center rounded-full bg-sage-600 px-7 py-4 text-base font-semibold text-cream shadow-lg shadow-sage-800/10 transition duration-200 hover:-translate-y-0.5 hover:bg-sage-700 hover:shadow-xl"
              >
                Get started
              </a>
              <a
                href="#features"
                class="inline-flex min-h-12 items-center justify-center rounded-full border border-line-strong bg-paper px-7 py-4 text-base font-semibold text-ink transition duration-200 hover:-translate-y-0.5 hover:border-sage-300 hover:bg-white"
              >
                See it in action →
              </a>
            </div>
            <p class="mt-8 text-sm font-medium text-ink-3">
              Built for clubs run by volunteers, not full-time administrators.
            </p>
          </div>

          <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
            <div class="absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-sage-200/70 via-apricot-soft/80 to-paper blur-2xl">
            </div>

            <div class="relative rounded-[2rem] border border-line bg-paper p-4 shadow-2xl shadow-ink/10">
              <div class="rounded-[1.5rem] border border-line bg-cream p-5">
                <div class="flex items-center justify-between border-b border-line pb-5">
                  <div>
                    <p class="text-sm font-semibold text-sage-700">
                      Kootenay Mountaineering Club
                    </p>
                    <p class="mt-1 text-xs text-ink-3">Member noticeboard</p>
                  </div>
                  <span class="rounded-full bg-success-soft px-3 py-1 text-xs font-semibold text-success">
                    Members only
                  </span>
                </div>

                <div class="mt-5 rounded-2xl bg-paper p-4 shadow-sm ring-1 ring-line">
                  <p class="text-xs font-medium uppercase tracking-[0.18em] text-ink-3">
                    Latest club note
                  </p>
                  <h2 class="mt-3 text-xl font-semibold text-ink">Saturday trail day</h2>
                  <p class="mt-2 text-sm leading-6 text-ink-2">
                    Meet at the trailhead at 9am. Bring gloves, lunch, and a thermos.
                  </p>
                </div>

                <div class="mt-5 grid gap-3 sm:grid-cols-3">
                  <div class="rounded-2xl bg-paper p-4 shadow-sm ring-1 ring-line">
                    <p class="text-xs font-medium uppercase tracking-[0.18em] text-ink-3">
                      Members
                    </p>
                    <p class="mt-3 text-3xl font-semibold text-ink">198</p>
                  </div>
                  <div class="rounded-2xl bg-paper p-4 shadow-sm ring-1 ring-line">
                    <p class="text-xs font-medium uppercase tracking-[0.18em] text-ink-3">
                      Messages
                    </p>
                    <p class="mt-3 text-3xl font-semibold text-ink">14</p>
                  </div>
                  <div class="rounded-2xl bg-paper p-4 shadow-sm ring-1 ring-line">
                    <p class="text-xs font-medium uppercase tracking-[0.18em] text-ink-3">
                      Updated
                    </p>
                    <p class="mt-3 text-3xl font-semibold text-apricot-deep">Today</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="border-y border-line bg-paper/70 px-6 py-16 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">Product</p>
            <h2 class="mt-3 text-4xl font-semibold tracking-tight text-ink">
              Three things, done quietly.
            </h2>
          </div>

          <div class="mt-10 grid gap-5 md:grid-cols-3">
            <article class="rounded-3xl border border-line bg-paper p-7 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
              <p class="text-sm font-semibold text-sage-700">01</p>
              <h3 class="mt-4 text-xl font-semibold text-ink">Plan and run events</h3>
              <p class="mt-3 leading-7 text-ink-2">
                Members add themselves in one tap. Waitlists and reminders, handled.
              </p>
            </article>
            <article class="rounded-3xl border border-line bg-paper p-7 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
              <p class="text-sm font-semibold text-sage-700">02</p>
              <h3 class="mt-4 text-xl font-semibold text-ink">Renewals without chasing</h3>
              <p class="mt-3 leading-7 text-ink-2">
                Memba sends the reminder and the receipt. You see who's renewed.
              </p>
            </article>
            <article class="rounded-3xl border border-line bg-paper p-7 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
              <p class="text-sm font-semibold text-sage-700">03</p>
              <h3 class="mt-4 text-xl font-semibold text-ink">Notes to your members</h3>
              <p class="mt-3 leading-7 text-ink-2">
                Message the whole club. Replies come back to you, not a reply-all.
              </p>
            </article>
          </div>
        </div>
      </section>
    </main>
  </div>
<% end %>
