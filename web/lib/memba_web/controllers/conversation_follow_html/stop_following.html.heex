<Layouts.app flash={@flash}>
  <section id="conversation-stop-follow-result" data-status={@status} class="mx-auto max-w-2xl">
    <div class="rounded-3xl border border-line bg-paper p-8 shadow-sm">
      <%= case @status do %>
        <% :success -> %>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">
            Conversation notifications
          </p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink">
            You’ve stopped following this conversation
          </h1>
          <p class="mt-4 leading-8 text-ink-2">
            We won’t email you new replies to this conversation. If you sign in and visit the conversation later, you can follow it again from Memba.
          </p>
          <a
            :if={@conversation_url}
            id="conversation-stop-follow-view-conversation-link"
            href={@conversation_url}
            class="mt-6 inline-flex rounded-full bg-sage-600 px-5 py-3 text-sm font-semibold text-cream transition duration-200 hover:-translate-y-0.5 hover:bg-sage-700"
          >
            View the conversation
          </a>
        <% :failure -> %>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">
            Conversation notifications
          </p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink">
            This stop-follow link isn’t valid
          </h1>
          <p class="mt-4 leading-8 text-ink-2">
            We couldn’t update conversation notifications from this link. Sign in to Memba to manage the conversation from your club site.
          </p>
      <% end %>
    </div>
  </section>
</Layouts.app>
