<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" href={~p"/images/favicon.svg"} type="image/svg+xml" />
    <.live_title default="Memba" suffix=" · Memba" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <% git_commit = git_commit_footer_link() %>
    {@inner_content}
    <%= unless hide_public_footer?(assigns) do %>
      <footer class="border-t border-line bg-paper px-6 py-8 text-sm text-ink-2 lg:px-8">
        <div class="mx-auto flex max-w-7xl flex-col gap-4">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <p>
              © {Date.utc_today().year}
              <a href="https://donkey.red" class="transition hover:text-ink">
                Red Donkey Technology Corp
              </a>
            </p>
            <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer navigation">
              <a href={~p"/about"} class="transition hover:text-ink">About</a>
              <a href={~p"/terms"} class="transition hover:text-ink">Terms</a>
              <a href={~p"/privacy"} class="transition hover:text-ink">Privacy</a>
              <a href="mailto:hello@memba.io" class="transition hover:text-ink">Contact</a>
            </nav>
          </div>
          <div class="flex flex-col gap-2 text-ink-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="inline-flex items-center gap-1.5">
              Built with <.icon name="hero-heart-mini" class="size-4 bg-ink-3" aria-hidden="true" />
              in Nelson, BC.
            </p>
            <%= if git_commit do %>
              <p>
                Commit
                <a href={git_commit.url} class="font-mono transition hover:text-ink">
                  {git_commit.short_sha}
                </a>
              </p>
            <% end %>
          </div>
        </div>
      </footer>
    <% end %>
  </body>
</html>
