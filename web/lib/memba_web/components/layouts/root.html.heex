<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" href={~p"/images/favicon.svg"} type="image/svg+xml" />
    <.live_title default="Memba" suffix=" · Memba" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
    <footer class="border-t border-line bg-paper px-6 py-8 text-sm text-ink-2 lg:px-8">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p>
          © {Date.utc_today().year} Red Donkey Technology Corp
        </p>
        <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer navigation">
          <a href="https://donkey.red" class="transition hover:text-ink">donkey.red</a>
          <a href={~p"/about"} class="transition hover:text-ink">About</a>
          <a href={~p"/terms"} class="transition hover:text-ink">Terms</a>
          <a href={~p"/privacy"} class="transition hover:text-ink">Privacy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
