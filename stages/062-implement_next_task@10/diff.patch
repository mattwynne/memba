index 0000000..7d4ae2d
--- /dev/null
+++ b/web/lib/memba_web/controllers/club_member_invitation_html/profile.html.heex
@@ -0,0 +1,49 @@
+<Layouts.app flash={@flash}>
+  <section
+    id="club-member-profile-completion"
+    data-club-id={club_id(@club)}
+    class="space-y-8"
+  >
+    <div class="space-y-4">
+      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">
+        Member invitation
+      </p>
+      <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
+        Tell us your name
+      </h1>
+      <p class="text-lg leading-8 text-ink-2">
+        You’re accepting an invitation to join {club_name(@club)}. We’ll use your name and {@email} to create your member profile before your membership starts.
+      </p>
+    </div>
+
+    <.form
+      for={@form}
+      action={~p"/invitations/club-members/profile"}
+      method="post"
+      id="club-member-profile-completion-form"
+      aria-label="Complete your profile"
+      class="rounded-3xl border border-line bg-paper p-6 shadow-sm"
+    >
+      <.input
+        name={@form[:name].name}
+        value={@form[:name].value}
+        errors={@form_errors.name}
+        id="club-member-profile-name-input"
+        type="text"
+        label="Your name"
+        autocomplete="name"
+        placeholder="Robin Example"
+        required
+      />
+
+      <.button
+        id="complete-club-member-profile-button"
+        type="submit"
+        variant="primary"
+        class="mt-4 btn btn-primary"
+      >
+        Join {club_name(@club)}
+      </.button>
+    </.form>
+  </section>
+</Layouts.app>
