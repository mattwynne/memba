     "sent" => %{label: "Sending", icon: "hero-clock"},
@@ -16,6 +17,13 @@ defmodule MembaWeb.MemberReceiptPresentation do
     "opened" => %{label: "Opened", icon: "hero-envelope-open"}
   }
 
+  @descriptions %{
+    "opened" => "read it",
