+      )
+      |> where([membership, _person], membership.club_id == ^club_id)
+      |> where([membership, _person], membership.active == true)
+      |> where([_membership, person], person.email == ^email)
+      |> Repo.exists?()
+    else
+      :error -> false
+      {:error, :invalid_email} -> false
+    end
+  end
