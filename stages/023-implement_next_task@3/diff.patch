@@ -423,6 +423,82 @@ h1, h2, h3, h4 {
   display: none;
 }
 
+/* ============================================================
+   Conversation detail head and follow toggle.
+
+   Ported from the design-system member-conversation mirror so
+   the Phoenix app can use the same detail-head / follow-toggle
+   vocabulary as the static wireframe.
+   ============================================================ */
+.detail-head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 14px;
+}
+
+.detail-head__main {
+  min-width: min(100%, 28rem);
+  flex: 1 1 0;
+}
+
+.follow-toggle {
+  flex: none;
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  padding: 7px 10px;
+  border: 1px solid var(--color-line);
+  border-radius: 999px;
+  background: var(--color-paper);
+  color: var(--color-ink);
+  cursor: pointer;
+  box-shadow: 0 1px 2px rgb(21 32 28 / 0.05);
+  transition:
+    background-color 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    border-color 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    box-shadow 120ms cubic-bezier(0.22, 0.61, 0.36, 1);
+}
+
+.follow-toggle:hover,
+.follow-toggle:focus-within {
+  border-color: var(--color-sage-200);
+  background: var(--color-sage-50);
+  box-shadow: 0 2px 8px rgb(21 32 28 / 0.08);
+}
+
+.follow-toggle:focus-within {
+  outline: 2px solid var(--color-sage-300);
+  outline-offset: 2px;
+}
+
+.follow-toggle input {
+  flex: none;
+}
+
+.follow-toggle__text {
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+  line-height: 1.1;
+}
+
+.follow-toggle__text strong {
+  color: var(--color-ink);
+  font-size: 13px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+}
+
+.follow-toggle__text span {
+  color: var(--color-ink-3);
+  font-size: 11.5px;
+  font-weight: 500;
+  white-space: nowrap;
+}
+
 @media (max-width: 640px) {
   .app-frame {
     padding: 12px;
