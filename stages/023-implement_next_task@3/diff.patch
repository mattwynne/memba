diff --git a/web/assets/css/app.css b/web/assets/css/app.css
index 73dd3e5..d10ffc6 100644
--- a/web/assets/css/app.css
+++ b/web/assets/css/app.css
@@ -423,6 +423,180 @@ h1, h2, h3, h4 {
   display: none;
 }
 
+/* ============================================================
+   Club-home conversation list.
+
+   Ported from the design-system club-home Conversations panel so
+   the Phoenix app can use the same conversation / conversation__*
+   / avatar-stack vocabulary as the static wireframe.
+   ============================================================ */
+.conversation-list {
+  display: flex;
+  flex-direction: column;
+  gap: 9px;
+}
+
+.conversation {
+  display: grid;
+  grid-template-columns: 38px minmax(0, 1fr);
+  align-items: start;
+  gap: 12px;
+  padding: 14px;
+  border: 1px solid var(--color-line);
+  border-radius: 14px;
+  background: var(--color-paper);
+  color: inherit;
+  text-decoration: none;
+  box-shadow: 0 1px 2px rgb(21 32 28 / 0.05);
+  transition:
+    border-color 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    box-shadow 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    transform 120ms cubic-bezier(0.22, 0.61, 0.36, 1);
+}
+
+.conversation:hover {
+  border-color: var(--color-sage-200);
+  box-shadow: 0 2px 8px rgb(21 32 28 / 0.08);
+  transform: translateY(-1px);
+}
+
+.conversation:focus-visible {
+  outline: 2px solid var(--color-sage-300);
+  outline-offset: 2px;
+}
+
+.conversation__avatar {
+  width: 38px;
+  height: 38px;
+  border-radius: 999px;
+  background: var(--color-sage-200);
+  color: var(--color-sage-800);
+  display: grid;
+  place-items: center;
+  flex: none;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.42);
+}
+
+.conversation__body {
+  min-width: 0;
+}
+
+.conversation__head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.conversation__subject {
+  min-width: 0;
+  color: var(--color-ink);
+  display: block;
+  flex: 1 1 auto;
+  font-size: 15px;
+  font-weight: 700;
+  letter-spacing: -0.018em;
+  line-height: 1.25;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.conversation__date {
+  flex: none;
+  color: var(--color-ink-3);
+  font-size: 12px;
+  font-weight: 600;
+  line-height: 1.3;
+  white-space: nowrap;
+  font-variant-numeric: tabular-nums;
+}
+
+.conversation__preview {
+  display: -webkit-box;
+  margin-top: 6px;
+  color: var(--color-ink-2);
+  font-size: 13px;
+  font-weight: 500;
+  line-height: 1.45;
+  overflow: hidden;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 1;
+  line-clamp: 1;
+}
+
+.conversation__participants {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 9px;
+  margin-top: 10px;
+}
+
+.conversation__replies {
+  color: var(--color-ink-2);
+  font-size: 12.5px;
+  font-weight: 500;
+  line-height: 1.35;
+}
+
+.conversation__replies strong {
+  color: var(--color-ink);
+  font-weight: 700;
+}
+
+.avatar-stack {
+  display: inline-flex;
+  align-items: center;
+  flex: none;
+}
+
+.avatar-stack > span,
+.avatar-stack > .avatar {
+  width: 24px;
+  height: 24px;
+  margin-left: -6px;
+  border-radius: 999px;
+  background: var(--color-sage-100);
+  color: var(--color-sage-800);
+  display: grid;
+  place-items: center;
+  flex: none;
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  box-shadow:
+    0 0 0 2px var(--color-paper),
+    inset 0 0 0 1px rgb(255 255 255 / 0.36);
+}
+
+.avatar-stack > span:first-child,
+.avatar-stack > .avatar:first-child {
+  margin-left: 0;
+}
+
+.avatar-stack > .avatar > div {
+  width: 24px;
+  height: 24px;
+  min-height: 24px;
+}
+
+.avatar-stack > .avatar span {
+  font-size: 10px;
+  font-weight: 700;
+}
+
+.avatar-stack > .is-more {
+  background: var(--color-base-200);
+  color: var(--color-ink-2);
+  font-family: var(--font-mono);
+  font-size: 10px;
+  letter-spacing: -0.02em;
+}
+
 /* ============================================================
    Club-home member list.
 
