+
+  @primary_key {:membership_id, :binary_id, autogenerate: false}
+  schema "membership_memberships" do
+    field :club_id, :binary_id
+    field :person_id, :binary_id
+    field :active, :boolean
+
+    timestamps(type: :utc_datetime_usec)
