+        |> select([club], %{
+          club_id: club.club_id,
+          name: club.name,
+          slug: club.slug
+        })
+        |> Repo.all()
+        |> Map.new(&{&1.club_id, &1})
+      end
+    else
+      %{}
+    end
+  end
+
+  @doc """
