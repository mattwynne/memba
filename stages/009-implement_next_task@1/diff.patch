diff --git a/web/assets/css/app.css b/web/assets/css/app.css
index 369b644..148e8c8 100644
--- a/web/assets/css/app.css
+++ b/web/assets/css/app.css
@@ -131,3 +131,217 @@ body {
 h1, h2, h3, h4 {
   letter-spacing: -0.02em;
 }
+
+/* ============================================================
+   Member app shell components.
+
+   Ported from the design-system member-app shell so the Phoenix
+   app can use the same app-frame / app-card / app-bar vocabulary
+   as the static wireframes.
+   ============================================================ */
+.app-frame {
+  min-height: 100vh;
+  margin: 0;
+  padding: 24px;
+  background: var(--color-sage-700);
+  color: var(--color-ink);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 14px;
+}
+
+.app-card {
+  width: min(100%, 880px);
+  background: var(--color-paper);
+  border: 1px solid rgb(255 255 255 / 0.24);
+  border-radius: 22px;
+  box-shadow: 0 18px 60px rgb(21 32 28 / 0.28);
+  overflow: hidden;
+}
+
+.app-bar {
+  min-height: 64px;
+  padding: 14px 22px;
+  background: var(--color-sage-800);
+  color: var(--color-cream);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+}
+
+.app-bar__brand {
+  min-width: 0;
+  display: flex;
+  align-items: center;
+}
+
+.app-bar__club {
+  color: #fff;
+  font-size: 16px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  line-height: 1.15;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.app-bar__id {
+  flex: none;
+}
+
+.app-bar__me {
+  border: 0;
+  border-radius: 999px;
+  background: rgb(255 255 255 / 0.1);
+  color: #fff;
+  font: inherit;
+  padding: 4px 8px 4px 4px;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  cursor: pointer;
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
+  transition:
+    background-color 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    box-shadow 120ms cubic-bezier(0.22, 0.61, 0.36, 1);
+}
+
+.app-bar__me:hover,
+.app-bar__me:focus-visible {
+  background: rgb(255 255 255 / 0.16);
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2);
+}
+
+.app-bar__me:focus-visible {
+  outline: 2px solid rgb(255 255 255 / 0.72);
+  outline-offset: 2px;
+}
+
+.app-bar__avatar {
+  width: 30px;
+  height: 30px;
+  border-radius: 999px;
+  background: rgb(255 255 255 / 0.16);
+  color: #fff;
+  display: grid;
+  place-items: center;
+  flex: none;
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15);
+}
+
+.app-bar__who {
+  max-width: 18ch;
+  color: rgb(255 255 255 / 0.92);
+  font-size: 13px;
+  font-weight: 600;
+  line-height: 1;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.app-menu {
+  min-width: 190px;
+  margin-top: 8px;
+  padding: 8px;
+  border: 1px solid var(--color-line);
+  border-radius: 14px;
+  background: var(--color-paper);
+  color: var(--color-ink);
+  box-shadow: 0 14px 40px rgb(21 32 28 / 0.18);
+  z-index: 20;
+}
+
+.app-menu--id {
+  right: 0;
+}
+
+.app-menu__status {
+  padding: 7px 8px 10px;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.app-menu__signout {
+  width: 100%;
+  border: 0;
+  border-radius: 9px;
+  background: transparent;
+  color: var(--color-ink);
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: flex-start;
+  font: inherit;
+  font-size: 13px;
+  font-weight: 600;
+  padding: 9px 10px;
+  text-align: left;
+  transition:
+    background-color 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    color 120ms cubic-bezier(0.22, 0.61, 0.36, 1);
+}
+
+.app-menu__signout:hover,
+.app-menu__signout:focus-visible {
+  background: var(--color-sage-50);
+  color: var(--color-sage-700);
+}
+
+.app-menu__signout:focus-visible {
+  outline: 2px solid var(--color-sage-300);
+  outline-offset: 2px;
+}
+
+.app-foot {
+  color: rgb(246 245 234 / 0.78);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  font-size: 12px;
+  font-weight: 500;
+}
+
+.app-foot a {
+  color: #fff;
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.app-foot a:hover,
+.app-foot a:focus-visible {
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+
+.app-foot__mark {
+  width: 15px;
+  height: 15px;
+  display: block;
+}
+
+@media (max-width: 640px) {
+  .app-frame {
+    padding: 12px;
+  }
+
+  .app-card {
+    border-radius: 18px;
+  }
+
+  .app-bar {
+    padding: 12px 14px;
+  }
+
+  .app-bar__who {
+    display: none;
+  }
+}
diff --git a/web/test/memba_web/app_shell_css_test.exs b/web/test/memba_web/app_shell_css_test.exs
new file mode 100644
index 0000000..826c02c
--- /dev/null
+++ b/web/test/memba_web/app_shell_css_test.exs
@@ -0,0 +1,29 @@
+defmodule MembaWeb.AppShellCssTest do
+  use ExUnit.Case, async: true
+
+  @app_css Path.expand("../../assets/css/app.css", __DIR__)
+
+  test "app stylesheet defines the shared member app shell classes" do
+    css = File.read!(@app_css)
+
+    for selector <- [
+          ".app-frame",
+          ".app-card",
+          ".app-bar",
+          ".app-bar__brand",
+          ".app-bar__club",
+          ".app-bar__id",
+          ".app-bar__me",
+          ".app-bar__avatar",
+          ".app-bar__who",
+          ".app-menu",
+          ".app-menu--id",
+          ".app-menu__status",
+          ".app-menu__signout",
+          ".app-foot",
+          ".app-foot__mark"
+        ] do
+      assert css =~ selector
+    end
+  end
+end
