+/* ============================================================
+   Conversation detail messages and reply composer.
+
+   Ported from the design-system member-conversation mirror so
+   the Phoenix app can use the same page-title / message /
+   composer vocabulary as the static wireframe.
+   ============================================================ */
+.page-title {
+  color: var(--color-ink);
+  font-size: 28px;
+  font-weight: 700;
+  letter-spacing: -0.024em;
+  line-height: 1.12;
+  margin: 4px 0 0;
+}
+
+.message {
+  display: flex;
+  align-items: flex-start;
+  gap: 13px;
+  padding: 16px;
+  border: 1px solid var(--color-line);
+  border-radius: 14px;
+  background: var(--color-paper);
+  color: var(--color-ink);
+  box-shadow: 0 1px 2px rgb(21 32 28 / 0.05);
+}
+
+.message > .flex {
+  width: 100%;
+}
+
+.message + .message {
+  margin-top: 9px;
+}
+
+.message--original {
+  border-color: var(--color-sage-200);
+  background: var(--color-sage-50);
+  box-shadow:
+    0 1px 2px rgb(21 32 28 / 0.05),
+    inset 0 0 0 1px rgb(255 255 255 / 0.42);
+}
+
+.message__avatar {
+  width: 38px;
+  height: 38px;
+  border-radius: 999px;
+  background: var(--color-sage-200);
+  color: var(--color-sage-800);
+  display: grid;
+  place-items: center;
+  flex: none;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.42);
+}
+
+.message__body {
+  min-width: 0;
+}
+
+.message__head {
+  min-height: 30px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.message__name {
+  min-width: 0;
+  color: var(--color-ink);
+  font-size: 14px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  line-height: 1.25;
+}
+
+.message__time {
+  flex: none;
+  color: var(--color-ink-3);
+  font-size: 12.5px;
+  font-weight: 500;
+  line-height: 1.35;
+  white-space: nowrap;
+  font-variant-numeric: tabular-nums;
+}
+
+.message__text {
+  margin: 5px 0 0;
+  color: var(--color-ink-2);
+  font-size: 15px;
+  font-weight: 500;
+  line-height: 1.6;
+  white-space: pre-wrap;
+}
+
+.message__menu {
+  margin-left: auto;
+  flex: none;
+}
+
+.message__kebab {
+  width: 30px;
+  height: 30px;
+  border: 0;
+  border-radius: 999px;
+  background: transparent;
+  color: var(--color-ink-3);
+  cursor: pointer;
+  display: grid;
+  place-items: center;
+  padding: 0;
+  transition:
+    background-color 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    color 120ms cubic-bezier(0.22, 0.61, 0.36, 1);
+}
+
+.message__kebab:hover,
+.message__kebab:focus-visible {
+  background: var(--color-base-200);
+  color: var(--color-ink);
+}
+
+.message__kebab:focus-visible {
+  outline: 2px solid var(--color-sage-300);
+  outline-offset: 2px;
+}
+
+.message__kebab svg {
+  width: 18px;
+  height: 18px;
+}
+
+.message-menu {
+  min-width: 180px;
+  margin-top: 8px;
+  padding: 6px;
+  border: 1px solid var(--color-line);
+  border-radius: 12px;
+  background: var(--color-paper);
+  color: var(--color-ink);
+  box-shadow: 0 14px 40px rgb(21 32 28 / 0.18);
+  z-index: 20;
+}
+
+.message-menu a {
+  color: inherit;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  border-radius: 9px;
+  padding: 8px 10px;
+  font-size: 13px;
+  font-weight: 600;
+  text-decoration: none;
+  transition:
+    background-color 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    color 120ms cubic-bezier(0.22, 0.61, 0.36, 1);
+}
+
+.message-menu a:hover,
+.message-menu a:focus-visible {
+  background: var(--color-sage-50);
+  color: var(--color-sage-700);
+}
+
+.message-menu a:focus-visible {
+  outline: 2px solid var(--color-sage-300);
+  outline-offset: 2px;
+}
+
+.message-menu svg {
+  width: 16px;
+  height: 16px;
+  flex: none;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 2;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.composer {
+  margin: 18px 0 0;
+  padding: 16px;
+  border: 1px solid var(--color-line);
+  border-radius: 14px;
+  background: var(--color-paper);
+  color: var(--color-ink);
+  box-shadow: 0 1px 2px rgb(21 32 28 / 0.05);
+}
+
+.composer__head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 8px 12px;
+  margin-bottom: 12px;
+}
+
+.composer__title {
+  color: var(--color-ink);
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 15px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  line-height: 1.25;
+}
+
+.composer__title svg {
+  width: 18px;
+  height: 18px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 2;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.composer__as {
+  color: var(--color-ink-3);
+  font-size: 13px;
+  font-weight: 500;
+  line-height: 1.35;
+}
+
+.composer__as strong {
+  color: var(--color-ink-2);
+  font-weight: 600;
+}
+
+.composer textarea {
+  width: 100%;
+  resize: vertical;
+}
+
+.composer__actions {
+  display: flex;
+  justify-content: flex-end;
+  margin-top: 12px;
+}
+
+.composer__note,
+.composer__error {
+  margin: 0 0 10px;
+  font-size: 13px;
+  font-weight: 600;
+  line-height: 1.4;
+}
+
+.composer__note {
+  color: var(--color-ink-2);
+}
+
+.composer__error {
+  color: var(--color-error);
+}
+
 /* ============================================================
    Delivery details page.
 
