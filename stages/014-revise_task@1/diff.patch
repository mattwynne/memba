+      Map.get(row, :sender_id),
+      Map.get(row, :originator_id),
+      Map.get(row, :latest_replier_id)
+      | participant_ids
+    ]
+    |> Enum.reject(&is_nil/1)
+    |> Enum.uniq()
+    |> Enum.map(&{:person, &1})
+  end
+
   defp fallback_interests(club_id) do
