diff --git a/web/test/features/step_definitions/member_profile_steps.exs b/web/test/features/step_definitions/member_profile_steps.exs
index adb63a9..5c39722 100644
--- a/web/test/features/step_definitions/member_profile_steps.exs
+++ b/web/test/features/step_definitions/member_profile_steps.exs
@@ -53,6 +53,44 @@ defmodule Memba.Cucumber.MemberProfileSteps do
     context
   end
 
+  step "{word} submits the older change to {string}",
+       %{args: [person_name, draft_name]} = context do
+    %{person_id: person_id} =
+      context
+      |> Map.fetch!(:people)
+      |> Map.fetch!(person_name)
+
+    edit =
+      context
+      |> Map.fetch!(:member_profile_name_edits)
+      |> Map.fetch!(person_name)
+
+    assert {:ok, command} =
+             PersonCommands.prepare_rename(
+               %{person_id: person_id},
+               %{name: draft_name, expected_name: edit.expected_name}
+             )
+
+    dispatch_result = CommandDispatch.dispatch(command)
+
+    authoritative_current_name =
+      case dispatch_result do
+        {:error, {:name_changed, current_name}} -> current_name
+        _other -> nil
+      end
+
+    update_context_map(
+      context,
+      :member_profile_name_edits,
+      person_name,
+      Map.merge(edit, %{
+        draft_name: draft_name,
+        authoritative_current_name: authoritative_current_name,
+        dispatch_result: dispatch_result
+      })
+    )
+  end
+
   defp email_for(context, person_name) do
     normalized_name =
       person_name
diff --git a/web/test/memba/membership/person_command_dispatch_test.exs b/web/test/memba/membership/person_command_dispatch_test.exs
index bab9bd3..cbb0864 100644
--- a/web/test/memba/membership/person_command_dispatch_test.exs
+++ b/web/test/memba/membership/person_command_dispatch_test.exs
@@ -176,4 +176,35 @@ defmodule Memba.Membership.PersonCommandDispatchTest do
 
     assert [%{normalized_email: "alice@example.com", is_primary: true}] = email_addresses
   end
+
+  test "returns the authoritative current name when dispatching a stale conditional rename" do
+    person_id = Memba.ID.generate(:person)
+    actor_context = %{person_id: person_id}
+
+    assert {:ok, create_command} =
+             PersonCommands.prepare_create(%{
+               person_id: person_id,
+               name: "Alice Smith",
+               email: "alice@example.com"
+             })
+
+    assert :ok = CommandDispatch.dispatch(create_command, consistency: :strong)
+
+    assert {:ok, winning_command} =
+             PersonCommands.prepare_rename(
+               actor_context,
+               %{name: "Alice Jones", expected_name: "Alice Smith"}
+             )
+
+    assert :ok = CommandDispatch.dispatch(winning_command)
+
+    assert {:ok, stale_command} =
+             PersonCommands.prepare_rename(
+               actor_context,
+               %{name: "Alice Brown", expected_name: "Alice Smith"}
+             )
+
+    assert {:error, {:name_changed, "Alice Jones"}} =
+             CommandDispatch.dispatch(stale_command)
+  end
 end
