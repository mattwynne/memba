+             |> then(&EventStore.stream_forward(MembershipApp, &1))
+             |> Enum.map(& &1.data)
+             |> Enum.filter(fn
+               %event_module{group_id: ^custom_group_id, person_id: ^returning_person_id}
+               when event_module in [GroupMemberAdded, GroupMemberRemoved] ->
+                 true
+
+               _event ->
+                 false
+             end)
+  end
