+function memberReceiptStatusForEventType(eventType) {
+  switch (eventType) {
+    case "delivered":
+      return "delivered";
+
+    case "opened":
+      return "opened";
+
+    case "delayed":
+    case "bounced":
+    case "spam_complaint":
+      return "delivery problem";
+
+    default:
+      throw new Error(`Unsupported browser receipt projection status event: ${eventType}`);
+  }
+}
