diff --git a/web/assets/css/app.css b/web/assets/css/app.css
index 413f223..5a979ef 100644
--- a/web/assets/css/app.css
+++ b/web/assets/css/app.css
@@ -336,6 +336,93 @@ h1, h2, h3, h4 {
   display: block;
 }
 
+/* ============================================================
+   Club-home section tabs.
+
+   Ported from the design-system club-home section spine so the
+   Phoenix app uses the same section-tabs / section-tab /
+   section-tabs__action / section-panel vocabulary as the
+   static wireframe.
+   ============================================================ */
+.section-tabs {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 14px;
+  padding: 10px;
+  border: 1px solid var(--color-line);
+  border-radius: 16px;
+  background: var(--color-paper);
+  box-shadow: 0 1px 2px rgb(21 32 28 / 0.05);
+}
+
+.section-tabs__list {
+  min-width: 0;
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  overflow-x: auto;
+  scrollbar-width: none;
+}
+
+.section-tabs__list::-webkit-scrollbar {
+  display: none;
+}
+
+.section-tab {
+  appearance: none;
+  border: 0;
+  border-radius: 999px;
+  background: transparent;
+  color: var(--color-ink-3);
+  cursor: pointer;
+  flex: none;
+  font: inherit;
+  font-size: 13px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  line-height: 1;
+  padding: 9px 13px;
+  transition:
+    background-color 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    color 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    box-shadow 120ms cubic-bezier(0.22, 0.61, 0.36, 1);
+  white-space: nowrap;
+}
+
+.section-tab:hover,
+.section-tab:focus-visible {
+  background: var(--color-sage-50);
+  color: var(--color-sage-700);
+}
+
+.section-tab:focus-visible {
+  outline: 2px solid var(--color-sage-300);
+  outline-offset: 2px;
+}
+
+.section-tab.is-active {
+  background: var(--color-sage-600);
+  color: var(--color-sage-50);
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
+}
+
+.section-tabs__action {
+  flex: none;
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  min-width: max-content;
+}
+
+.section-panel {
+  display: block;
+}
+
+.section-panel[hidden] {
+  display: none;
+}
+
 @media (max-width: 640px) {
   .app-frame {
     padding: 12px;
@@ -352,4 +439,14 @@ h1, h2, h3, h4 {
   .app-bar__who {
     display: none;
   }
