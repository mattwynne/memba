+  """
+  def dispatch_claimed_delivery(%EmailDeliveryProjection{} = delivery) do
+    case deliver_to_provider(delivery) do
+      :ok -> mark_delivery_sent(delivery)
+      {:error, reason} -> mark_delivery_failed(delivery, reason)
+    end
+  end
