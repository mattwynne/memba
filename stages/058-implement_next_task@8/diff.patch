+  defp validate_token_hash(changeset) do
+    case get_field(changeset, :token_hash) do
+      nil ->
+        changeset
+
+      token_hash when is_binary(token_hash) and byte_size(token_hash) == 32 ->
+        changeset
+
+      _token_hash ->
+        add_error(changeset, :token_hash, "must be a SHA-256 digest")
+    end
+  end
