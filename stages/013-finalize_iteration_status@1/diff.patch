diff --git a/.github/workflows/continuous-delivery.yml b/.github/workflows/continuous-delivery.yml
new file mode 100644
index 0000000..0b303ef
--- /dev/null
+++ b/.github/workflows/continuous-delivery.yml
@@ -0,0 +1,66 @@
+name: Continuous delivery
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: continuous-delivery-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  dev-check:
+    name: dev check
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - name: Check out repository
+        uses: actions/checkout@v4
+
+      - name: Install Nix
+        uses: cachix/install-nix-action@v31
+        with:
+          extra_nix_config: |
+            access-tokens = github.com=${{ github.token }}
+
+      - name: Use devenv binary cache
+        uses: cachix/cachix-action@v16
+        with:
+          name: devenv
+
+      - name: Install devenv
+        run: nix profile install nixpkgs#devenv
+
+      - name: Install Hex and Rebar
+        run: |
+          devenv shell -- mix local.hex --force
+          devenv shell -- mix local.rebar --force
+
+      - name: Run dev check
+        run: ./bin/dev check
+
+  deploy:
+    name: deploy to Fly.io
+    runs-on: ubuntu-latest
+    needs: dev-check
+    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
+    concurrency:
+      group: fly-deploy-production
+      cancel-in-progress: false
+    steps:
+      - name: Check out repository
+        uses: actions/checkout@v4
+
+      - name: Set up flyctl
+        uses: superfly/flyctl-actions/setup-flyctl@master
+
+      - name: Deploy
+        run: flyctl deploy --remote-only
+        env:
+          FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
