+    person =
+      insert_membership_person!(
+        name: "Alice Applicant",
+        email: "alice@example.com"
+      )
+
+    conn =
+      conn
+      |> init_test_session(%{IdentityAuth.identity_session_key() => "alice@example.com"})
+      |> get(~p"/get-started")
+
+    response = html_response(conn, 200)
