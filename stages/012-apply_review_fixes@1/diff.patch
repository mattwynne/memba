+  defp assert_tab_click_js(operations, section) do
+    selected_tab = "#member-section-tab-#{section}"
+    selected_panel = "#member-section-panel-#{section}"
+    selected_action = "#member-section-tabs-action [data-action='#{section}']"
+
+    assert [
+             [
+               "remove_class",
+               %{"names" => ["is-active"], "to" => "#member-section-tabs-list .section-tab"}
+             ],
+             ["add_class", %{"names" => ["is-active"], "to" => ^selected_tab}],
+             [
+               "set_attr",
+               %{
+                 "attr" => ["aria-selected", "false"],
+                 "to" => "#member-section-tabs-list .section-tab"
+               }
+             ],
+             [
+               "set_attr",
+               %{"attr" => ["aria-selected", "true"], "to" => ^selected_tab}
+             ]
+             | _
+           ] = operations
+
+    assert ["hide", %{"time" => 0, "to" => ".section-panel"}] in operations
+    assert ["set_attr", %{"attr" => ["hidden", ""], "to" => ".section-panel"}] in operations
+    assert ["remove_attr", %{"attr" => "hidden", "to" => selected_panel}] in operations
+    assert ["show", %{"display" => "block", "time" => 0, "to" => selected_panel}] in operations
+
+    assert ["hide", %{"time" => 0, "to" => "#member-section-tabs-action [data-action]"}] in operations
+
+    assert [
+             "set_attr",
+             %{"attr" => ["hidden", ""], "to" => "#member-section-tabs-action [data-action]"}
+           ] in operations
+
+    assert ["remove_attr", %{"attr" => "hidden", "to" => selected_action}] in operations
+
+    assert [
+             "show",
+             %{"display" => "inline-flex", "time" => 0, "to" => selected_action}
+           ] in operations
+
+    refute "toggle_class" in operation_names(operations)
+    refute "push" in operation_names(operations)
+  end
+
+  defp js_operations(html, selector) do
+    html
+    |> attribute(selector, "phx-click")
+    |> Jason.decode!()
+  end
+
+  defp operation_names(operations) do
+    Enum.map(operations, fn [name, _options] -> name end)
+  end
+
   defp html_has_selector?(html, selector) do
     html
     |> LazyHTML.from_fragment()
