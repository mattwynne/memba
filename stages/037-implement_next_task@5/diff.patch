   display: none;
 }
 
+/* ============================================================
+   Club-home member list.
+
+   Ported from the design-system club-home Members panel so the
+   Phoenix app uses the same member-list / member-row vocabulary
+   as the static wireframe.
+   ============================================================ */
+.member-list {
+  display: flex;
+  flex-direction: column;
+  gap: 9px;
+}
+
+.member-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 14px;
+  border: 1px solid var(--color-line);
+  border-radius: 14px;
+  background: var(--color-paper);
+  color: inherit;
+  text-decoration: none;
+  box-shadow: 0 1px 2px rgb(21 32 28 / 0.05);
+  transition:
+    border-color 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    box-shadow 120ms cubic-bezier(0.22, 0.61, 0.36, 1),
+    transform 120ms cubic-bezier(0.22, 0.61, 0.36, 1);
+}
+
+.member-row:hover {
+  border-color: var(--color-sage-200);
+  box-shadow: 0 2px 8px rgb(21 32 28 / 0.08);
+  transform: translateY(-1px);
+}
+
+.member-row:focus-visible {
+  outline: 2px solid var(--color-sage-300);
+  outline-offset: 2px;
+}
+
+.member-row__avatar {
+  width: 38px;
+  height: 38px;
+  border-radius: 999px;
+  background: var(--color-sage-200);
+  color: var(--color-sage-800);
+  display: grid;
+  place-items: center;
+  flex: none;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.42);
+}
+
+.member-row__body {
+  min-width: 0;
+  flex: 1 1 auto;
+}
+
+.member-row__name {
+  color: var(--color-ink);
+  font-size: 14px;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+  line-height: 1.25;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.member-row__meta {
+  color: var(--color-ink-3);
+  font-size: 12.5px;
+  font-weight: 500;
+  line-height: 1.35;
+  margin-top: 2px;
+}
+
+.member-row__role {
+  flex: none;
+  margin-left: auto;
+  white-space: nowrap;
+}
+
