diff --git a/web/assets/css/app.css b/web/assets/css/app.css
index df06538..bbbbf27 100644
--- a/web/assets/css/app.css
+++ b/web/assets/css/app.css
@@ -499,6 +499,311 @@ h1, h2, h3, h4 {
   white-space: nowrap;
 }
 
+/* ============================================================
+   Delivery details page.
+
+   Ported from the design-system delivery-details mirror so the
+   Phoenix app uses the same delivery-summary / delivery-bar /
+   delivery-legend / delivery-group / recipient / deliv-*
+   vocabulary as the static wireframe.
+   ============================================================ */
+.delivery-title {
+  color: var(--color-ink);
+  font-size: 20px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  line-height: 1.2;
+  margin: 4px 0;
+}
+
+.delivery-meta {
+  color: var(--color-ink-3);
+  font-size: 13px;
+  line-height: 1.5;
+  margin: 0 0 22px;
+}
+
+.delivery-summary {
+  background: var(--color-paper);
+  border: 1px solid var(--color-line);
+  border-radius: 16px;
+  padding: 16px;
+  box-shadow: 0 1px 2px rgb(21 32 28 / 0.05);
+}
+
+.delivery-summary__head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.delivery-summary__title {
+  color: var(--color-ink);
+  font-size: 15px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  margin: 0;
+}
+
+.delivery-summary__count {
+  color: var(--color-ink);
+  flex: none;
+  font-family: var(--font-mono);
+  font-size: 13px;
+  font-weight: 600;
+}
+
+.delivery-bar {
+  display: flex;
+  height: 12px;
+  border-radius: 999px;
+  overflow: hidden;
+  margin-top: 14px;
+  background: var(--color-base-200);
+  box-shadow: inset 0 0 0 1px var(--color-line);
+}
+
+.delivery-bar > span {
+  display: block;
+  height: 100%;
+}
+
+.delivery-legend {
+  margin-top: 14px;
+  display: flex;
+  flex-direction: column;
+  gap: 9px;
+}
+
+.delivery-legend__item {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 10px 12px;
+  border: 1px solid var(--color-line);
+  border-radius: 11px;
+  background: var(--color-base-100);
+}
+
+.delivery-legend__sw {
+  width: 10px;
+  height: 10px;
+  border-radius: 3px;
+  flex: none;
+}
+
+.delivery-legend__txt {
+  flex: 1;
+  min-width: 0;
+}
+
+.delivery-legend__lab {
+  display: block;
+  color: var(--color-ink);
+  font-size: 13px;
+  font-weight: 600;
+}
+
+.delivery-legend__desc {
+  display: block;
+  color: var(--color-ink-3);
+  font-size: 11.5px;
+  margin-top: 1px;
+}
+
+.delivery-legend__n {
+  color: var(--color-ink);
+  font-family: var(--font-mono);
+  font-size: 13px;
+  font-weight: 600;
+}
+
+.delivery-group {
+  background: var(--color-paper);
+  border: 1px solid var(--color-line);
+  border-radius: 14px;
+  overflow: hidden;
+  box-shadow: 0 1px 2px rgb(21 32 28 / 0.05);
+}
+
+.delivery-group + .delivery-group {
+  margin-top: 9px;
+}
+
+.delivery-group__btn {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 13px 14px;
+  background: none;
+  border: 0;
+  color: inherit;
+  text-align: left;
+  cursor: pointer;
+  font-family: var(--font-sans);
+  list-style: none;
+}
+
+.delivery-group__btn::marker {
+  content: "";
+}
+
+.delivery-group__btn::-webkit-details-marker {
+  display: none;
+}
+
+.delivery-group__btn:focus-visible {
+  outline: 2px solid var(--color-sage-300);
+  outline-offset: -2px;
+}
+
+.delivery-group__ic {
+  width: 34px;
+  height: 34px;
+  border-radius: 10px;
+  display: grid;
+  place-items: center;
+  flex: none;
+}
+
+.delivery-group__ic > span {
+  width: 18px;
+  height: 18px;
+}
+
+.delivery-group__t {
+  flex: 1;
+  min-width: 0;
+}
+
+.delivery-group__lab {
+  display: block;
+  color: var(--color-ink);
+  font-size: 14px;
+  font-weight: 600;
+}
+
+.delivery-group__desc {
+  display: block;
+  color: var(--color-ink-3);
+  font-size: 11.5px;
+  margin-top: 1px;
+}
+
+.delivery-group__n {
+  color: var(--color-ink);
+  font-family: var(--font-mono);
+  font-size: 13px;
+  font-weight: 600;
+}
+
+.delivery-group__chev {
+  width: 18px;
+  height: 18px;
+  flex: none;
+  color: var(--color-ink-3);
+  transition: transform 120ms cubic-bezier(0.22, 0.61, 0.36, 1);
+}
+
+.delivery-group[open] .delivery-group__chev {
+  transform: rotate(180deg);
+}
+
+.delivery-group__rows {
+  border-top: 1px solid var(--color-line);
+  padding: 4px 14px;
+}
+
+.recipient {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  padding: 10px 0;
+}
+
+.recipient + .recipient {
+  border-top: 1px solid var(--color-line);
+}
+
+.recipient__id {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+}
+
+.recipient__av {
+  width: 30px;
+  height: 30px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  flex: none;
+  font-size: 11px;
+  font-weight: 700;
+}
+
+.recipient__name {
+  color: var(--color-ink);
+  font-size: 13.5px;
+  font-weight: 500;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.recipient__reason {
+  min-width: 0;
+  color: var(--color-ink-3);
+  font-size: 12.5px;
+  line-height: 1.35;
+  text-align: right;
+}
+
+.recipient__reason strong {
+  color: var(--color-ink);
+  font-weight: 600;
+}
+
+.deliv-ok {
+  background: var(--color-success);
+}
+
+.deliv-snd {
+  background: var(--color-warning);
+}
+
+.deliv-bad {
+  background: var(--color-error);
+}
+
+.deliv-unknown {
+  background: var(--color-info);
+}
+
+.deliv-tint-ok {
+  background: var(--color-sage-100);
+  color: var(--color-sage-700);
+}
+
+.deliv-tint-snd {
+  background: var(--color-warning-soft);
+  color: var(--color-warning);
+}
+
+.deliv-tint-bad {
+  background: var(--color-error-soft);
+  color: var(--color-error);
+}
+
+.deliv-tint-unknown {
+  background: var(--color-info-soft);
+  color: var(--color-info);
+}
+
 @media (max-width: 640px) {
   .app-frame {
     padding: 12px;
