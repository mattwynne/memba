diff --git a/web/lib/memba/messaging/projectors/inbound_email_source.ex b/web/lib/memba/messaging/projectors/inbound_email_source.ex
new file mode 100644
index 0000000..003430b
--- /dev/null
+++ b/web/lib/memba/messaging/projectors/inbound_email_source.ex
@@ -0,0 +1,44 @@
+defmodule Memba.Messaging.Projectors.InboundEmailSource do
+  @moduledoc """
+  Projects inbound club email outcome events into source/status records.
+  """
+
+  use Commanded.Projections.Ecto,
+    application: Memba.Messaging.App,
+    repo: Memba.Repo,
+    name: "Memba.Messaging.Projectors.InboundEmailSource",
+    consistency: :strong
