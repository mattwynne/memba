+<!-- @screen-label "Email — Reply notification" -->
+<!--
+  Memba · Transactional email — Reply notification (conversation)
+  Sent when someone replies to a club message conversation.
+
+  DESIGN DECISION (2026-06-19): lean on the email client for history.
+  The branded body is just the NEW reply + a "View the conversation" CTA + footer.
+  The earlier messages are emitted as a STANDARD quoted thread (blockquote.gmail_quote
+  with "On <date>, <name> wrote:" attributions), so email clients fold it natively
+  ("See more" in Apple Mail, "•••" in Gmail) and thread it via Message-ID / In-Reply-To /
+  References headers. We deliberately do NOT inline a branded full history — that would
+  fight the client and show the thread twice in clients that thread by headers.
+
+  Dynamic fields:  {{club_name}} {{club_slug}} {{club_initials}} {{replier_name}} {{replier_initials}}
+                   {{conversation_subject}} {{reply_body}} {{conversation_url}}
+                   {{recipient_email}} {{follow_reason}} {{stop_following_url}}
+                   quoted_history[] (most-recent-first, nested): {author, sent_label, body}
+  Subject:   [{{club_slug}}] Re: {{conversation_subject}}   (club-slug prefix kept — iteration 025, for mailbox filtering)
+  From:      {{club_name}} via Memba <{{club_slug}}@clubs.memba.io>
+  Reply-To:  everyone@{{club_slug}}.clubs.memba.io   (the club everyone address — iteration 042)
+  Headers:   Message-ID, In-Reply-To, References set so clients thread + fold AND so replies
+             route back to this conversation by header (iteration 041 pivoted reply routing to
+             email headers; there is no per-conversation plus-address).
+-->
+<!doctype html>
+<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta http-equiv="X-UA-Compatible" content="IE=edge">
+  <meta name="color-scheme" content="light only">
+  <meta name="supported-color-schemes" content="light only">
+  <title>Re: Saturday ridge walk</title>
+  <!--[if mso]><xml><o:OfficeDocumentSettings xmlns:o="urn:schemas-microsoft-com:office:office"><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml><![endif]-->
+  <style>
+    @import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&display=swap');
+    body { margin:0; padding:0; width:100% !important; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }
+    table { border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt; }
+    a { color:#5a7050; }
+    @media only screen and (max-width:600px) {
+      .container { width:100% !important; max-width:100% !important; border-radius:0 !important; }
+      .gutter { padding-left:22px !important; padding-right:22px !important; }
+      .h1 { font-size:20px !important; }
+    }
+  </style>
+</head>
+<body style="margin:0; padding:0; background:#ece9d9; font-family:'Figtree', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; color:#25291d; -webkit-font-smoothing:antialiased;">
+
+  <!-- preheader -->
+  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#ece9d9;">
+    Phil Dunbar replied in the Saturday ridge walk conversation.
+    &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
+  </div>
+
+  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ece9d9;">
+    <tr>
+      <td align="center" style="padding:32px 16px;">
+
+        <table role="presentation" class="container" width="560" cellpadding="0" cellspacing="0" border="0" style="width:560px; max-width:560px; background:#ffffff; border:1px solid #e8e6d4; border-radius:14px; overflow:hidden;">
+
+          <!-- header: CLUB lockup -->
+          <tr>
+            <td class="gutter" style="padding:18px 28px; border-bottom:1px solid #e8e6d4;">
+              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
+                <td style="vertical-align:middle;">
+                  <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
+                    <td style="padding-right:10px; vertical-align:middle;">
+                      <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
+                        <td width="26" height="26" align="center" valign="middle" style="width:26px; height:26px; background:#25291d; border-radius:7px; font-size:11px; font-weight:600; color:#f6f5ea; text-align:center; line-height:26px;">KAC</td>
+                      </tr></table>
+                    </td>
+                    <td style="vertical-align:middle; font-size:14px; font-weight:600; color:#25291d; letter-spacing:-0.012em;">Kootenay Alpine Club</td>
+                  </tr></table>
+                </td>
+                <td align="right" style="vertical-align:middle; font-size:11px; color:#b0b3a3; letter-spacing:0.04em; text-transform:uppercase;">New reply</td>
+              </tr></table>
+            </td>
+          </tr>
+
+          <!-- conversation subject -->
+          <tr>
+            <td class="gutter" style="padding:20px 28px 2px;">
+              <div style="font-size:11px; color:#878b76; letter-spacing:0.04em; text-transform:uppercase;">In the conversation</div>
+              <h1 class="h1" style="margin:5px 0 0; font-family:'Figtree',sans-serif; font-size:22px; font-weight:600; line-height:1.2; letter-spacing:-0.022em; color:#25291d;">Saturday ridge walk</h1>
+            </td>
+          </tr>
+
+          <!-- the NEW reply (the only branded message body) -->
+          <tr>
+            <td class="gutter" style="padding:18px 28px 4px;">
+              <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
+                <td style="vertical-align:middle; padding-right:12px;">
+                  <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
+                    <td width="42" height="42" align="center" valign="middle" style="width:42px; height:42px; background:#5a7050; border-radius:999px; font-size:15px; font-weight:600; color:#f6f5ea; text-align:center; line-height:42px;">PD</td>
+                  </tr></table>
+                </td>
+                <td style="vertical-align:middle;">
+                  <div style="font-size:15px; font-weight:600; color:#25291d; letter-spacing:-0.01em;">Phil Dunbar replied</div>
+                  <div style="font-size:12.5px; color:#878b76; margin-top:1px;">just now</div>
+                </td>
+              </tr></table>
+            </td>
+          </tr>
+          <tr>
+            <td class="gutter" style="padding:12px 28px 20px; font-size:15.5px; line-height:1.6; color:#323a2a;">
+              <p style="margin:0 0 14px;">I can bring a spare set of microspikes &mdash; happy to lend them out at the trailhead for anyone who needs them.</p>
+              <p style="margin:0;">Also bringing the big thermos, so there&rsquo;ll be hot tea at the saddle.</p>
+            </td>
+          </tr>
+
+          <!-- CTA -->
+          <tr>
+            <td class="gutter" style="padding:0 28px 22px;">
+              <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
+                <td align="center" style="background:#5a7050; border-radius:999px;">
+                  <a href="#" style="display:inline-block; padding:12px 26px; font-size:14px; font-weight:600; color:#ffffff; text-decoration:none;">View the conversation</a>
+                </td>
+              </tr></table>
+            </td>
+          </tr>
+
+          <!-- quoted history: STANDARD email quote so clients fold/thread it natively -->
+          <tr>
+            <td class="gutter" style="padding:0 28px 18px;">
+              <div class="gmail_quote" style="font-size:13.5px; line-height:1.55; color:#878b76;">
+                On 3 Jun, Marta Wi&#347;niewska wrote:
+                <blockquote class="gmail_quote" style="margin:6px 0 0; padding:2px 0 2px 14px; border-left:2px solid #d9d6bf; color:#878b76;">
+                  Carpool from the north lot? I have three seats &mdash; reply here if you want one.
+                  <br><br>
+                  On 3 Jun, Eira Sandhu wrote:
+                  <blockquote class="gmail_quote" style="margin:6px 0 0; padding:2px 0 2px 14px; border-left:2px solid #d9d6bf; color:#a4a892;">
+                    Meeting at the trailhead 8am sharp. Bring microspikes &mdash; the north side still has ice in the gullies. We&rsquo;ll regroup at the saddle for lunch.
+                  </blockquote>
+                </blockquote>
+              </div>
+            </td>
+          </tr>
+
+          <!-- footer: Memba baseline + follow controls -->
+          <tr>
+            <td class="gutter" style="padding:20px 28px 24px; border-top:1px solid #e8e6d4;">
+              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px;"><tr>
+                <td style="padding-right:7px; vertical-align:middle;">
+                  <svg width="15" height="15" viewBox="0 0 64 64" aria-hidden="true"><rect x="2" y="2" width="60" height="60" rx="12" fill="#5a7050"></rect><path d="M32 51 C32 43 32 36 32 18" fill="none" stroke="#ffffff" stroke-width="4.6" stroke-linecap="round"></path><path d="M32 33 C40 32 46 26 48 16 C39 17.5 33 24 32 33 Z" fill="#ffffff"></path><path d="M32 39 C25 38 20 32 19 23 C26 24.5 31 31 32 39 Z" fill="#ffffff"></path><circle cx="32" cy="15" r="3.7" fill="#d2925a"></circle></svg>
+                </td>
+                <td style="vertical-align:middle; font-size:11.5px; color:#878b76;">Delivered for Kootenay Alpine Club by <a href="https://memba.io" style="color:#555a47; text-decoration:none; font-weight:600;">Memba</a></td>
+              </tr></table>
+              <div style="font-size:12px; line-height:1.6; color:#878b76;">
+                You&rsquo;re following this conversation because you replied to it.<br>
+                <a href="#" style="color:#878b76; text-decoration:underline;">Stop following this conversation</a>
+              </div>
+            </td>
+          </tr>
+
+        </table>
+
+      </td>
+    </tr>
+  </table>
+
+</body>
+</html>
