+<!-- @screen-label "Email — Inbound rejection" -->
+<!--
+  Memba · Transactional email — Inbound club email rejection  (v3 — From names the club)
+  DIAL: club-named sender, Memba-voiced body. The From is "{{club_name}} via Memba"
+        (kept from iteration 031 so the recipient sees the club they wrote to), while the
+        body stays Memba-voiced because a bounce genuinely comes from the carrier — with a
+        one-line clarifier ("Memba delivers email for {{club_name}}").
+  Canonical sample shown: UNKNOWN SENDER (includes the optional club hint + original-message context).
+  Dynamic fields:  {{rejection_reason}}  {{club_name}}  {{club_hint}}  {{original_subject}}
+                   {{original_snippet}}  {{support_email}}  {{recipient_email}}
+  Subject: Your email to Wessex Chamber Choir wasn't posted   (or "Re: {{original_subject}}")
+  From:    {{club_name}} via Memba   (e.g. "Wessex Chamber Choir via Memba")
+  Reply-To: {{support_email}}   (help@memba.io)
+-->
+<!doctype html>
+<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta http-equiv="X-UA-Compatible" content="IE=edge">
+  <meta name="color-scheme" content="light only">
+  <meta name="supported-color-schemes" content="light only">
+  <title>Your email wasn't posted</title>
+  <!--[if mso]><xml><o:OfficeDocumentSettings xmlns:o="urn:schemas-microsoft-com:office:office"><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml><![endif]-->
+  <style>
+    @import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&display=swap');
+    body { margin:0; padding:0; width:100% !important; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }
+    table { border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt; }
+    a { color:#5a7050; }
+    @media only screen and (max-width:600px) {
+      .container { width:100% !important; max-width:100% !important; border-radius:0 !important; }
+      .gutter { padding-left:22px !important; padding-right:22px !important; }
+      .h1 { font-size:23px !important; }
+    }
+  </style>
+</head>
+<body style="margin:0; padding:0; background:#ece9d9; font-family:'Figtree', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; color:#25291d; -webkit-font-smoothing:antialiased;">
+
+  <!-- preheader -->
+  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#ece9d9;">
+    Your email to Wessex Chamber Choir wasn&rsquo;t posted. Here&rsquo;s why, and how to fix it.
+    &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
+  </div>
+
+  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ece9d9;">
+    <tr>
+      <td align="center" style="padding:32px 16px;">
+
+        <table role="presentation" class="container" width="560" cellpadding="0" cellspacing="0" border="0" style="width:560px; max-width:560px; background:#ffffff; border:1px solid #e8e6d4; border-radius:14px; overflow:hidden;">
+
+          <!-- header: MEMBA mark (this is the carrier speaking) + club clarifier -->
+          <tr>
+            <td class="gutter" style="padding:24px 28px 16px;">
+              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
+                <td style="vertical-align:middle;">
+                  <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
+                    <td style="padding-right:9px; vertical-align:middle;">
+                      <svg width="22" height="22" viewBox="0 0 64 64" aria-hidden="true"><rect x="2" y="2" width="60" height="60" rx="12" fill="#5a7050"></rect><path d="M32 51 C32 43 32 36 32 18" fill="none" stroke="#f6f5ea" stroke-width="4.6" stroke-linecap="round"></path><path d="M32 33 C40 32 46 26 48 16 C39 17.5 33 24 32 33 Z" fill="#f6f5ea"></path><path d="M32 39 C25 38 20 32 19 23 C26 24.5 31 31 32 39 Z" fill="#f6f5ea"></path><circle cx="32" cy="15" r="3.7" fill="#d2925a"></circle></svg>
+                    </td>
+                    <td style="vertical-align:middle; font-size:16px; font-weight:600; color:#25291d; letter-spacing:-0.018em;">Memba</td>
+                  </tr></table>
+                </td>
+                <td align="right" style="vertical-align:middle; font-size:11px; color:#b0b3a3; letter-spacing:0.04em; text-transform:uppercase;">Delivery notice</td>
+              </tr></table>
+            </td>
+          </tr>
+
+          <!-- body -->
+          <tr>
+            <td class="gutter" style="padding:6px 28px 24px; font-size:15px; line-height:1.55; color:#555a47;">
+
+              <!-- calm status mark — neutral, not alarming -->
+              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 2px;"><tr>
+                <td width="40" height="40" align="center" valign="middle" style="width:40px; height:40px; background:#e3e9ec; border-radius:999px; text-align:center; line-height:40px;">
+                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4f6b78" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><path d="m3.5 6.5 8.5 6 8.5-6"></path></svg>
+                </td>
+              </tr></table>
+
+              <h1 class="h1" style="margin:12px 0 12px; font-family:'Figtree',sans-serif; font-size:26px; font-weight:600; line-height:1.15; letter-spacing:-0.028em; color:#25291d;">Your email wasn&rsquo;t posted</h1>
+              <p style="margin:0 0 16px;">Sorry &mdash; your message to <b style="color:#25291d; font-weight:600;">Wessex Chamber Choir</b> didn&rsquo;t go out to members. Here&rsquo;s why:</p>
+
+              <!-- reason -->
+              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px;"><tr>
+                <td style="background:#f6f5ea; border:1px solid #e8e6d4; border-radius:10px; padding:14px 16px; font-size:15px; line-height:1.5; color:#25291d;">
+                  We couldn&rsquo;t find a member account for this email address, so your message hasn&rsquo;t been posted.
+                </td>
+              </tr></table>
+
+              <!-- optional hint (unknown-sender case) -->
+              <p style="margin:0 0 18px;">Is it possible you signed up for membership of Wessex Chamber Choir with a different email address?</p>
+
+              <!-- next step -->
+              <p style="margin:0 0 6px; color:#25291d; font-weight:600; font-size:15px;">What to do next</p>
+              <p style="margin:0 0 18px;">Just reply to this email and a person will help, or write to <a href="mailto:help@memba.io" style="color:#5a7050; text-decoration:underline;">help@memba.io</a>. Nothing was sent to the club, so there&rsquo;s nothing to undo.</p>
+
+              <!-- preserved original context -->
+              <p style="margin:0 0 7px; font-size:12px; font-weight:600; letter-spacing:0.04em; text-transform:uppercase; color:#878b76;">Your message</p>
+              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
+                <td style="background:#ffffff; border:1px solid #e8e6d4; border-radius:10px; padding:14px 16px;">
+                  <div style="font-size:14px; font-weight:600; color:#25291d; letter-spacing:-0.01em; margin-bottom:4px;">Can I bring a guest on Saturday?</div>
+                  <div style="font-size:13.5px; line-height:1.5; color:#878b76;">Hi &mdash; I wanted to check whether members are allowed to bring a guest along to the open rehearsal this weekend, or if it&rsquo;s members only&hellip;</div>
+                </td>
+              </tr></table>
+
+            </td>
+          </tr>
+
+          <!-- footer: ambient Memba baseline, with the carrier clarifier -->
+          <tr>
+            <td class="gutter" style="padding:16px 28px 24px; border-top:1px solid #e8e6d4;">
+              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:9px;"><tr>
+                <td style="padding-right:7px; vertical-align:middle;">
+                  <svg width="15" height="15" viewBox="0 0 64 64" aria-hidden="true"><rect x="2" y="2" width="60" height="60" rx="12" fill="#5a7050"></rect><path d="M32 51 C32 43 32 36 32 18" fill="none" stroke="#ffffff" stroke-width="4.6" stroke-linecap="round"></path><path d="M32 33 C40 32 46 26 48 16 C39 17.5 33 24 32 33 Z" fill="#ffffff"></path><path d="M32 39 C25 38 20 32 19 23 C26 24.5 31 31 32 39 Z" fill="#ffffff"></path><circle cx="32" cy="15" r="3.7" fill="#d2925a"></circle></svg>
+                </td>
+                <td style="vertical-align:middle; font-size:11.5px; color:#878b76;">Memba delivers email for Wessex Chamber Choir</td>
+              </tr></table>
+              <div style="font-size:12px; line-height:1.6; color:#878b76;">
+                This is an automatic notice, sent to margaret.ellis@gmail.com.<br>
+                Replies go to <a href="mailto:help@memba.io" style="color:#878b76; text-decoration:underline;">help@memba.io</a>.
+              </div>
+            </td>
+          </tr>
+
+        </table>
+
+      </td>
+    </tr>
+  </table>
+
+</body>
+</html>
