--- /dev/null
+++ b/web/lib/memba_web/controllers/auth_html/new.html.heex
@@ -0,0 +1,45 @@
+<Layouts.app flash={@flash}>
+  <section id="auth-sign-in" class="space-y-8">
+    <div class="space-y-4">
+      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage-600">
+        Shared sign-in
+      </p>
+      <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
+        Sign in to Memba
+      </h1>
+      <p class="text-lg leading-8 text-ink-2">
+        Enter your email address and we’ll send you a magic link. The same sign-in works for club members and Memba staff.
+      </p>
+    </div>
+
+    <.form
+      for={@form}
+      action={~p"/auth"}
+      id="magic-link-form"
+      class="rounded-3xl border border-line bg-paper p-6 shadow-sm"
+    >
+      <.input
+        field={@form[:email]}
+        id="auth_email_input"
+        type="email"
+        label="Email address"
+        autocomplete="email"
+        placeholder="you@example.com"
+        required
+      />
+
+      <.button
+        id="request-magic-link-button"
+        type="submit"
+        variant="primary"
+        class="mt-4 btn btn-primary"
+      >
+        Email me a sign-in link
+      </.button>
+    </.form>
+
+    <p class="text-sm leading-6 text-ink-3">
+      For your privacy, the response is the same whether or not we recognize the email address.
+    </p>
+  </section>
+</Layouts.app>
