@@ -0,0 +1,69 @@
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const test = require("node:test");
+
+const {
+  buildChromiumLaunchOptions,
+  chromiumExecutablePath,
+  findChromiumExecutable
+} = require("../features/support/browser_launch");
+
+test("buildChromiumLaunchOptions uses Playwright defaults when its expected browser exists", () => {
+  const tempDirectory = fs.mkdtempSync(path.join(os.tmpdir(), "memba-playwright-default-"));
+  const defaultExecutablePath = path.join(tempDirectory, "chromium-1223", "chrome-linux64", "chrome");
+  fs.mkdirSync(path.dirname(defaultExecutablePath), { recursive: true });
+  fs.writeFileSync(defaultExecutablePath, "");
+
+  const options = buildChromiumLaunchOptions(
+    { HEADLESS: "true", PLAYWRIGHT_BROWSERS_PATH: tempDirectory },
+    { executablePath: () => defaultExecutablePath }
+  );
+
+  assert.deepEqual(options, { headless: true });
+});
+
+test("buildChromiumLaunchOptions can use an explicit Chromium executable override", () => {
+  const executablePath = "/custom/chromium";
+
+  assert.deepEqual(
+    buildChromiumLaunchOptions({ HEADLESS: "false", PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH: executablePath }),
+    { headless: false, executablePath }
+  );
+});
+
+test("findChromiumExecutable falls back to the Nix-provided headless shell layout", () => {
+  const browsersPath = fs.mkdtempSync(path.join(os.tmpdir(), "memba-playwright-browsers-"));
+  const executablePath = path.join(
+    browsersPath,
+    "chromium_headless_shell-1217",
+    "chrome-headless-shell-linux64",
+    "chrome-headless-shell"
+  );
+  fs.mkdirSync(path.dirname(executablePath), { recursive: true });
+  fs.writeFileSync(executablePath, "");
+
+  assert.equal(findChromiumExecutable(browsersPath, true), executablePath);
+});
+
+test("chromiumExecutablePath uses the Nix fallback only when Playwright's expected browser is absent", () => {
+  const browsersPath = fs.mkdtempSync(path.join(os.tmpdir(), "memba-playwright-mismatch-"));
+  const fallbackPath = path.join(
+    browsersPath,
+    "chromium_headless_shell-1217",
+    "chrome-headless-shell-linux64",
+    "chrome-headless-shell"
+  );
+  fs.mkdirSync(path.dirname(fallbackPath), { recursive: true });
+  fs.writeFileSync(fallbackPath, "");
+
+  assert.equal(
+    chromiumExecutablePath(
+      { PLAYWRIGHT_BROWSERS_PATH: browsersPath },
+      { executablePath: () => path.join(browsersPath, "chromium_headless_shell-1223", "missing") },
+      true
+    ),
+    fallbackPath
+  );
+});
