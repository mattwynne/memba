diff --git a/acceptance-tests/test/browser_environment.test.js b/acceptance-tests/test/browser_environment.test.js
new file mode 100644
index 0000000..7d42371
--- /dev/null
+++ b/acceptance-tests/test/browser_environment.test.js
@@ -0,0 +1,28 @@
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const test = require("node:test");
+
+const { findNixFontconfigFile } = require("../features/support/browser_environment");
+
+test("findNixFontconfigFile finds a Nix fontconfig fonts.conf", () => {
+  const storePath = fs.mkdtempSync(path.join(os.tmpdir(), "memba-nix-store-"));
+  const fontconfigDir = path.join(storePath, "abc-fontconfig-2.17.1", "etc", "fonts");
+  const otherDir = path.join(storePath, "def-fontconfig-2.17.1.drv");
+
+  fs.mkdirSync(fontconfigDir, { recursive: true });
+  fs.mkdirSync(otherDir, { recursive: true });
+  fs.writeFileSync(path.join(fontconfigDir, "fonts.conf"), "<fontconfig />");
+
+  assert.equal(
+    findNixFontconfigFile(storePath),
+    path.join(fontconfigDir, "fonts.conf")
+  );
+});
+
+test("findNixFontconfigFile returns null when no Nix store is available", () => {
+  const missingStorePath = path.join(os.tmpdir(), `missing-nix-store-${Date.now()}`);
+
+  assert.equal(findNixFontconfigFile(missingStorePath), null);
+});
