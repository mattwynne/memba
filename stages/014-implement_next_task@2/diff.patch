+const assert = require("node:assert/strict");
+const test = require("node:test");
+
+const { defaultStepTimeoutMs } = require("../features/support/timeouts");
+
+test("default Cucumber step timeout leaves room for bounded projection waits", () => {
+  assert.equal(defaultStepTimeoutMs({}), 30000);
+});
+
+test("default Cucumber step timeout can be overridden with a positive numeric environment value", () => {
+  assert.equal(defaultStepTimeoutMs({ ACCEPTANCE_STEP_TIMEOUT_MS: "45000" }), 45000);
+});
+
+test("default Cucumber step timeout ignores invalid environment values", () => {
+  assert.equal(defaultStepTimeoutMs({ ACCEPTANCE_STEP_TIMEOUT_MS: "0" }), 30000);
+  assert.equal(defaultStepTimeoutMs({ ACCEPTANCE_STEP_TIMEOUT_MS: "not-a-number" }), 30000);
+});
