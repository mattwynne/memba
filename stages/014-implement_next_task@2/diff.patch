+++ b/acceptance-tests/features/support/browser_launch.js
@@ -0,0 +1,89 @@
+const fs = require("node:fs");
+const path = require("node:path");
+
+function buildChromiumLaunchOptions(env = process.env, chromium = null) {
+  const headless = env.HEADLESS !== "false";
+  const options = { headless };
+  const executablePath = chromiumExecutablePath(env, chromium, headless);
+
+  if (executablePath) {
+    options.executablePath = executablePath;
+  }
+
+  return options;
+}
+
+function chromiumExecutablePath(env = process.env, chromium = null, headless = env.HEADLESS !== "false") {
+  if (env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH) {
+    return env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH;
+  }
+
+  if (!env.PLAYWRIGHT_BROWSERS_PATH) {
+    return null;
+  }
+
+  const defaultExecutablePath = chromium && typeof chromium.executablePath === "function"
+    ? chromium.executablePath()
+    : null;
+
+  if (defaultExecutablePath && fs.existsSync(defaultExecutablePath)) {
+    return null;
+  }
+
+  return findChromiumExecutable(env.PLAYWRIGHT_BROWSERS_PATH, headless);
+}
+
+function findChromiumExecutable(browsersPath, headless) {
+  const preferredCandidates = headless
+    ? [headlessShellCandidates, chromiumCandidates]
+    : [chromiumCandidates, headlessShellCandidates];
+
+  for (const candidateBuilder of preferredCandidates) {
+    const executablePath = firstExistingExecutable(candidateBuilder(browsersPath));
+
+    if (executablePath) {
+      return executablePath;
+    }
+  }
+
+  return null;
+}
+
+function firstExistingExecutable(candidates) {
+  for (const candidate of candidates) {
+    if (fs.existsSync(candidate)) {
+      return candidate;
+    }
+  }
+
+  return null;
+}
+
+function headlessShellCandidates(browsersPath) {
+  return browserDirectories(browsersPath, "chromium_headless_shell-")
+    .map((directory) => path.join(directory, "chrome-headless-shell-linux64", "chrome-headless-shell"));
+}
+
+function chromiumCandidates(browsersPath) {
+  return browserDirectories(browsersPath, "chromium-")
+    .map((directory) => path.join(directory, "chrome-linux64", "chrome"));
+}
+
+function browserDirectories(browsersPath, prefix) {
+  try {
+    return fs
+      .readdirSync(browsersPath)
+      .filter((name) => name.startsWith(prefix))
+      .sort()
+      .reverse()
+      .map((name) => path.join(browsersPath, name));
+  } catch (_error) {
+    return [];
+  }
+}
+
+module.exports = {
+  buildChromiumLaunchOptions,
+  chromiumExecutablePath,
+  findChromiumExecutable
+};
