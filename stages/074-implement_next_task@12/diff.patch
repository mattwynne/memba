+                 sender_id: alice.person_id,
+                 subject: "Trip planning night",
+                 body: "Bring route ideas."
+               },
+               returning: :execution_result,
+               consistency: :strong
+             )
+
+    assert [
+             %EmailDeliveryRequest{
+               recipient_id: ^alice_id,
+               recipient_name: "Alice",
+               recipient_address: "alice@example.com"
+             },
+             %EmailDeliveryRequest{
