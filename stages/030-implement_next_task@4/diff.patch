+           )
+
+    assert has_element?(
+             view,
+             "#member-section-panel-members #club-members " <>
+               "#member-invite-member-link.btn.btn-soft.btn-sm[href='/members/invitations/new']",
+             "Invite member"
+           )
+
+    assert has_element?(
