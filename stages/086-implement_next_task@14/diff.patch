+
+  defp ensure_active_member(context, person_name, club_name) do
+    context =
+      context
+      |> ensure_club(club_name)
+      |> ensure_person(person_name)
+
+    club_id = fetch_club_id!(context, club_name)
+    person = fetch_person!(context, person_name)
