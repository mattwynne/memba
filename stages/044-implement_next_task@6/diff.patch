+  defp create_group_decision(%__MODULE__{} = club, %CreateGroup{} = command, group_key, name) do
+    case Map.fetch(club.groups, command.group_id) do
+      {:ok, %{group_key: ^group_key, name: ^name}} ->
+        []
+
+      {:ok, %{}} ->
