+             "#club-member-#{alice_id}.member-row[data-current-member='true'] " <>
+               ".member-row__meta [data-testid='club-member-current-indicator']",
+             "You"
+           )
+
+    ordinary_member_html =
+      dashboard_html(%{
+        active_section: "members",
+        current_member: %{id: alice_id, name: "Alice Adams"},
