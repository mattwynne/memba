      "name": "CloneSmoke",
      "nodes": {
        "make_commit": {
          "id": "make_commit",
          "attrs": {
            "script": {
              "String": "set -eu\nmkdir -p .fabro/tmp\ndate -u +%Y-%m-%dT%H:%M:%SZ > .fabro/tmp/clone-smoke.txt\ngit add .fabro/tmp/clone-smoke.txt\ngit config user.email fabro@example.invalid\ngit config user.name Fabro\ngit commit -m 'Smoke-test Fabro managed clone commit'\ngit log -1 --format='%h %s'\ngit status --short"
            },
            "shape": {
              "String": "parallelogram"
            },
            "label": {
              "String": "Make sandbox-only commit"
            }
          }
        },
        "inspect_after_commit": {
          "id": "inspect_after_commit",
          "attrs": {
            "script": {
              "String": "set -eu\necho PWD=$PWD\necho '--- branch ---'\ngit branch --show-current || true\necho '--- HEAD ---'\ngit log -1 --format='%h %s'\necho '--- status ---'\ngit status --short\necho '--- refs containing HEAD ---'\ngit for-each-ref --format='%(refname:short)' --contains HEAD refs/heads refs/remotes || true"
            },
            "label": {
              "String": "Inspect after commit"
            },
            "shape": {
              "String": "parallelogram"
            }
          }
        },
        "inspect_checkout": {
          "id": "inspect_checkout",
          "attrs": {
            "script": {
              "String": "set -eu\necho PWD=$PWD\necho HOME=${HOME:-}\necho '--- git root ---'\ngit rev-parse --show-toplevel\necho '--- branch ---'\ngit branch --show-current || true\necho '--- HEAD ---'\ngit log -1 --format='%h %s'\necho '--- remotes ---'\ngit remote -v\necho '--- status ---'\ngit status --short\necho '--- refs containing HEAD ---'\ngit for-each-ref --format='%(refname:short)' --contains HEAD refs/heads refs/remotes || true"
            },
            "label": {
              "String": "Inspect Fabro-managed checkout"
            },
            "shape": {
              "String": "parallelogram"
            }
