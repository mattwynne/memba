# flyctl launch added from .gitignore
# The directory Mix will write compiled artifacts to.
web/_build

# If you run "mix test --cover", coverage assets end up here.
web/cover

# The directory Mix downloads your dependencies sources to.
web/deps

# Where 3rd-party dependencies like ExDoc output generated docs.
web/doc

# Ignore .fetch files in case you like to edit your project deps locally.
.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
**/erl_crash.dump
web/erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
**/*.ez

# Temporary files, for example, from tests.
tmp
.devenv

# Ignore package tarball (built via "mix hex.build").
web/memba-*.tar

# Ignore assets that are produced by build tools.
web/priv/static/assets

# Ignore digested assets cache.
web/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
**/npm-debug.log
web/assets/node_modules
acceptance-tests/node_modules
acceptance-tests/playwright-report
acceptance-tests/test-results
acceptance-tests/core

**/.DS_Store
**/.local

# flyctl launch added from acceptance-tests/.gitignore
acceptance-tests/**/node_modules
acceptance-tests/**/playwright-report
acceptance-tests/**/test-results

# flyctl launch added from web/deps/cucumber/.gitignore
# The directory Mix will write compiled artifacts to.
web/deps/cucumber/_build

# If you run "mix test --cover", coverage assets end up here.
web/deps/cucumber/cover

# The directory Mix downloads your dependencies sources to.
web/deps/cucumber/deps

# Where third-party dependencies like ExDoc output generated docs.
web/deps/cucumber/doc

# If the VM crashes, it generates a dump, let's ignore it too.
web/deps/cucumber/**/erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
web/deps/cucumber/**/*.ez

# Ignore package tarball (built via "mix hex.build").
web/deps/cucumber/**/cucumber-*.tar

# Temporary files, for example, from tests.
web/deps/cucumber/tmp

web/deps/cucumber/**/**/.claude/settings.local.json
fly.toml
