digraph Quality {
 graph [default_max_retries=0]
 start [shape=Mdiamond]
 done [shape=Msquare]
 check [shape=parallelogram, timeout="30m", script="python3 -B .fabro/tmp/selection-partial-quality/command.py"]
 stop [shape=parallelogram, script="exit 1"]
 start -> check
 check -> done [condition="outcome=succeeded"]
 check -> stop
}
