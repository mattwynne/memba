digraph IterationReview {
    graph [
        goal="Review the completed implementation of { inputs.plan_path } against the plan, ADRs, and independent reviewers",
        default_fidelity="summary:high",
        max_node_visits=160,
        model_stylesheet="
            * { model: gpt-5.5; reasoning_effort: high; }
            #read_plan { reasoning_effort: low; }
            #fix_dev_check { model: gpt-5.5; reasoning_effort: high; }
            #plan_conformance_gate { model: gpt-5.5; reasoning_effort: high; }
            #fix_plan_conformance { model: gpt-5.5; reasoning_effort: high; }
            #adr_coherence_gate { model: gpt-5.5; reasoning_effort: high; }
            #fix_adr_coherence { model: gpt-5.5; reasoning_effort: high; }
            #claude_review { model: claude-sonnet-4-5; reasoning_effort: high; }
            #codex_review { model: gpt-5.5; reasoning_effort: high; }
            #gemini_review { model: gemini-3.1-pro-preview; reasoning_effort: high; }
            #synthesize_review { model: gpt-5.5; reasoning_effort: high; }
            #apply_review_fixes { model: gpt-5.5; reasoning_effort: high; }
            #final_summary { reasoning_effort: low; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    read_plan [
        label="Read Iteration Plan",
        shape=parallelogram,
        script="PLAN_PATH='{{ inputs.plan_path }}'\nif [ ! -f \"$PLAN_PATH\" ]; then\n  echo \"Iteration plan not found: $PLAN_PATH\" >&2\n  exit 1\nfi\nprintf 'PLAN_PATH=%s\\n\\n' \"$PLAN_PATH\"\nline_count=0\nwhile IFS= read -r line && [ \"$line_count\" -lt 320 ]; do\n  printf '%s\\n' \"$line\"\n  line_count=$((line_count + 1))\ndone < \"$PLAN_PATH\""
    ]

    read_failed [
        label="Fail: Plan Missing",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration review failed: the plan file could not be read. Pass -I plan_path=docs/iterations/NNN-topic/plan.md and ensure it is committed/pushed for remote sandboxes.' >&2\nexit 1"
    ]

    preflight_sandbox [
        label="Preflight Review Sandbox",
        shape=parallelogram,
        script="set -eu\nif [ ! -x bin/dev ]; then\n  echo \"Missing or non-executable bin/dev\" >&2\n  exit 1\nfi\nstatus=$(git status --short)\nif [ -n \"$status\" ]; then\n  echo 'Iteration review requires a clean working tree before review starts.' >&2\n  printf '%s\\n' \"$status\" >&2\n  exit 1\nfi\nPATH=\"$PWD/bin:$PATH\" dev sandbox-check",
        timeout="600s"
    ]

    preflight_failed [
        label="Fail: Sandbox Preflight",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration review failed before review: the sandbox/toolchain preflight did not pass. Fix the Fabro environment or image, then retry.' >&2\nexit 1"
    ]

    dev_check [
        label="Run Dev Check",
        shape=parallelogram,
        script="PATH=\"$PWD/bin:$PATH\" dev ci",
        timeout="1800s"
    ]

    fix_dev_check [
        label="Fix Dev Check Failures",
        prompt="@prompts/fix_dev_check.md",
        timeout="2400s",
        max_visits=3
    ]

    collect_implementation_evidence [
        label="Collect Implementation Evidence",
        shape=parallelogram,
        script="set -eu\nbase_ref='{{ inputs.base_ref }}'\nmerge_base_err=\"${TMPDIR:-/tmp}/memba-merge-base-$$.err\"\necho '=== Implementation Evidence Debug ==='\necho \"PWD: $PWD\"\necho \"Branch: $(git branch --show-current || true)\"\necho \"HEAD: $(git rev-parse HEAD 2>/dev/null || echo unknown)\"\necho \"Base ref input: ${base_ref:-<empty>}\"\necho ''\necho '--- available branches ---'\ngit branch -vv || true\necho ''\necho '--- available remote branches ---'\ngit branch -r -vv || true\necho ''\necho '--- recent commits ---'\ngit log --oneline --decorate --max-count=20 --all || true\necho ''\nif [ -n \"$base_ref\" ]; then\n  if ! git rev-parse --verify \"$base_ref\" >/dev/null 2>&1; then\n    case \"$base_ref\" in\n      origin/*)\n        branch=${base_ref#origin/}\n        git fetch --quiet origin \"$branch:refs/remotes/origin/$branch\" || true\n        ;;\n    esac\n  fi\n  if ! git rev-parse --verify \"$base_ref\" >/dev/null 2>&1; then\n    echo \"Configured base_ref is not a valid ref: $base_ref\" >&2\n    git branch -a -vv >&2 || true\n    git show-ref >&2 || true\n    exit 1\n  fi\nelse\n  git fetch --quiet origin main:refs/remotes/origin/main || true\n  for ref in origin/main main; do\n    if git rev-parse --verify \"$ref\" >/dev/null 2>&1; then\n      base_ref=$ref\n      break\n    fi\n  done\n  if [ -z \"$base_ref\" ]; then\n    echo 'Could not determine a base ref. Tried origin/main and main.' >&2\n    git branch -a -vv >&2 || true\n    git show-ref >&2 || true\n    exit 1\n  fi\nfi\nif ! merge_base=$(git merge-base HEAD \"$base_ref\" 2>\"$merge_base_err\"); then\n  echo \"Could not compute merge base between HEAD and $base_ref.\" >&2\n  cat \"$merge_base_err\" >&2 || true\n  shallow=$(git rev-parse --is-shallow-repository 2>/dev/null || echo unknown)\n  echo \"Repository shallow: $shallow\" >&2\n  if [ \"$shallow\" = true ]; then\n    echo 'Trying to fetch deeper history before failing...' >&2\n    case \"$base_ref\" in\n      origin/*)\n        branch=${base_ref#origin/}\n        git fetch --quiet --deepen=100 origin \"$branch:refs/remotes/origin/$branch\" || true\n        ;;\n    esac\n    git fetch --quiet --deepen=100 origin || true\n    if ! merge_base=$(git merge-base HEAD \"$base_ref\" 2>\"$merge_base_err\"); then\n      echo 'Trying to unshallow repository before failing...' >&2\n      git fetch --quiet --unshallow origin || true\n    fi\n  fi\n  if ! merge_base=$(git merge-base HEAD \"$base_ref\" 2>\"$merge_base_err\"); then\n    echo \"Still could not compute merge base between HEAD and $base_ref.\" >&2\n    cat \"$merge_base_err\" >&2 || true\n    git log --oneline --decorate --max-count=20 --all >&2 || true\n    git branch -a -vv >&2 || true\n    git show-ref >&2 || true\n    exit 1\n  fi\nfi\necho '=== Implementation Evidence ==='\necho \"Branch: $(git branch --show-current || true)\"\necho \"HEAD: $(git rev-parse HEAD)\"\necho \"Base ref: $base_ref\"\necho \"Merge base: $merge_base\"\necho ''\necho '--- git status --short ---'\ngit status --short\necho ''\necho '--- git diff --stat ---'\nif ! git diff --stat \"$merge_base\"..HEAD; then\n  echo \"Could not compute diff stat from $merge_base to HEAD.\" >&2\n  exit 1\nfi\necho ''\necho '--- git diff --name-status ---'\nif ! git diff --name-status \"$merge_base\"..HEAD; then\n  echo \"Could not compute diff name-status from $merge_base to HEAD.\" >&2\n  exit 1\nfi\necho ''\necho '--- changed source/config/test file excerpts ---'\nif ! changed_files=$(git diff --name-only \"$merge_base\"..HEAD); then\n  echo \"Could not compute changed files from $merge_base to HEAD.\" >&2\n  exit 1\nfi\nif [ -z \"$changed_files\" ]; then\n  echo 'No files differ between merge base and HEAD.'\nelse\n  excerpt_files=$(printf '%s\\n' \"$changed_files\" | grep -E '^(web/(lib|config|test|priv/repo/migrations|mix\\.exs|mix\\.lock)|bin/|docs/iterations/)' || true)\n  if [ -z \"$excerpt_files\" ]; then\n    echo 'No changed files matched the excerpt filter.'\n  else\n    printf '%s\\n' \"$excerpt_files\" | while IFS= read -r file; do\n      if [ -f \"$file\" ]; then\n        echo \"=== $file ===\"\n        sed -n '1,220p' \"$file\"\n        echo ''\n      fi\n    done\n  fi\nfi",
        timeout="120s"
    ]

    collect_evidence_failed [
        label="Fail: Evidence Collection",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration review failed before gates: implementation evidence could not be collected. Check base_ref and branch visibility, then retry.' >&2\nexit 1"
    ]

    plan_conformance_gate [
        label="Plan Conformance Gate",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/plan_conformance_gate.md"
    ]
    plan_gate [
        shape=diamond,
        label="Plan conformant?"
    ]
    snapshot_before_plan_repair [
        label="Snapshot Before Plan Repair",
        shape=parallelogram,
        script="set -eu\nmkdir -p .fabro/tmp\nkind='plan'\ngit diff --binary > \".fabro/tmp/${kind}-repair-before.patch\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-before-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-before-stat.txt\" || true\nprintf 'Repair baseline (%s) captured.\\n' \"$kind\""
    ]
    fix_plan_conformance [
        label="Fix Plan Conformance",
        prompt="@prompts/fix_plan_conformance.md",
        timeout="2400s",
        max_visits=2
    ]
    verify_plan_repair [
        label="Verify Plan Repair",
        shape=parallelogram,
        script="set -eu\nkind='plan'\nbefore=\".fabro/tmp/${kind}-repair-before.patch\"\nafter=\".fabro/tmp/${kind}-repair-after.patch\"\ngit diff --binary > \"$after\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-after-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-after-stat.txt\" || true\nprintf 'Repair baseline (%s) captured in %s\\n' \"$kind\" \"$before\"\nprintf 'Repair after    (%s) captured in %s\\n' \"$kind\" \"$after\"\nprintf 'Changed files after repair:\\n'\ngit diff --name-only\nif cmp -s \"$before\" \"$after\"; then\n  echo \"${kind} repair produced no working-tree diff change since repair started.\" >&2\n  echo \"If no code/config/test changes were required, route to human input or make the repair prompt explicitly justify that case.\" >&2\n  exit 1\nfi\nif git diff --name-only | grep -E '\\.feature$'; then\n  echo \"Repair modified locked acceptance feature files.\" >&2\n  exit 1\nfi"
    ]
    plan_not_ready [
        label="Fail: Needs Human Plan Review",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration review failed: plan conformance gate found violations that require human input or exceeded the automatic plan repair budget.' >&2\nexit 1"
    ]
    adr_coherence_gate [
        label="ADR Coherence Gate",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/adr_coherence_gate.md"
    ]
    adr_gate [shape=diamond, label="ADR coherent?"]
    snapshot_before_adr_repair [
        label="Snapshot Before ADR Repair",
        shape=parallelogram,
        script="set -eu\nmkdir -p .fabro/tmp\nkind='adr'\ngit diff --binary > \".fabro/tmp/${kind}-repair-before.patch\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-before-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-before-stat.txt\" || true\nprintf 'Repair baseline (%s) captured.\\n' \"$kind\""
    ]
    fix_adr_coherence [
        label="Fix ADR Coherence",
        prompt="@prompts/fix_adr_coherence.md",
        timeout="2400s",
        max_visits=2
    ]
    verify_adr_repair [
        label="Verify ADR Repair",
        shape=parallelogram,
        script="set -eu\nkind='adr'\nbefore=\".fabro/tmp/${kind}-repair-before.patch\"\nafter=\".fabro/tmp/${kind}-repair-after.patch\"\ngit diff --binary > \"$after\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-after-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-after-stat.txt\" || true\nprintf 'Repair baseline (%s) captured in %s\\n' \"$kind\" \"$before\"\nprintf 'Repair after    (%s) captured in %s\\n' \"$kind\" \"$after\"\nprintf 'Changed files after repair:\\n'\ngit diff --name-only\nif cmp -s \"$before\" \"$after\"; then\n  echo \"${kind} repair produced no working-tree diff change since repair started.\" >&2\n  echo \"If no code/config/test changes were required, route to human input or make the repair prompt explicitly justify that case.\" >&2\n  exit 1\nfi\nif git diff --name-only | grep -E '\\.feature$'; then\n  echo \"Repair modified locked acceptance feature files.\" >&2\n  exit 1\nfi"
    ]
    adr_not_ready [
        label="Fail: Needs Human ADR Review",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration review failed: ADR coherence gate found violations that require human input or exceeded the automatic ADR repair budget.' >&2\nexit 1"
    ]
    review_fork [label="Independent Implementation Reviews", shape=component, join_policy="wait_all", max_parallel=3]
    claude_review [
        label="Claude Review",
        shape=tab,
        prompt="@prompts/review.md"
    ]
    codex_review [
        label="Codex/GPT Review",
        shape=tab,
        prompt="@prompts/review.md"
    ]
    gemini_review [
        label="Gemini Review",
        shape=tab,
        prompt="@prompts/review.md"
    ]
    review_merge [label="Merge Reviews", shape=tripleoctagon]
    synthesize_review [
        label="Synthesize Review",
        shape=tab,
        output_schema="routing",
        prompt="@prompts/synthesize_review.md"
    ]
    review_gate [shape=diamond, label="Implementation accepted?"]
    snapshot_before_review_repair [
        label="Snapshot Before Review Repair",
        shape=parallelogram,
        script="set -eu\nmkdir -p .fabro/tmp\nkind='review'\ngit diff --binary > \".fabro/tmp/${kind}-repair-before.patch\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-before-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-before-stat.txt\" || true\nprintf 'Repair baseline (%s) captured.\\n' \"$kind\""
    ]
    apply_review_fixes [
        label="Apply Review Fixes",
        prompt="@prompts/apply_review_fixes.md",
        timeout="2400s",
        max_visits=3
    ]
    verify_review_repair [
        label="Verify Review Repair",
        shape=parallelogram,
        script="set -eu\nkind='review'\nbefore=\".fabro/tmp/${kind}-repair-before.patch\"\nafter=\".fabro/tmp/${kind}-repair-after.patch\"\ngit diff --binary > \"$after\"\ngit diff --name-only > \".fabro/tmp/${kind}-repair-after-files.txt\"\ngit diff --stat > \".fabro/tmp/${kind}-repair-after-stat.txt\" || true\nprintf 'Repair baseline (%s) captured in %s\\n' \"$kind\" \"$before\"\nprintf 'Repair after    (%s) captured in %s\\n' \"$kind\" \"$after\"\nprintf 'Changed files after repair:\\n'\ngit diff --name-only\nif cmp -s \"$before\" \"$after\"; then\n  echo \"${kind} repair produced no working-tree diff change since repair started.\" >&2\n  echo \"If no code/config/test changes were required, route to human input or make the repair prompt explicitly justify that case.\" >&2\n  exit 1\nfi\nif git diff --name-only | grep -E '\\.feature$'; then\n  echo \"Repair modified locked acceptance feature files.\" >&2\n  exit 1\nfi"
    ]
    not_ready [
        label="Fail: Needs Human Review",
        shape=parallelogram,
        goal_gate=true,
        script="echo 'Iteration review failed: reviewers found blocking issues that require human input or exceeded the automatic repair budget.' >&2\nexit 1"
    ]

    final_artifact_gate [
        label="Final Artifact Gate",
        shape=parallelogram,
        script="set -eu\necho '=== Final Artifact Gate ==='\necho ''\necho 'Checking for implementation artifact evidence...'\necho ''\n\n# Strategy: prefer git base/head comparison over working-tree dirtiness alone,\n# since Fabro may checkpoint changes between nodes.\n\n# 1. Check working tree status first (may be clean if already checkpointed)\nstatus=$(git status --short)\nif [ -n \"$status\" ]; then\n  echo \"Working tree changes still present:\"\n  printf '%s\\n' \"$status\"\n  echo ''\nelse\n  echo \"Working tree is clean (changes may have been checkpointed).\"\n  echo ''\nfi\n\n# 2. Look for recent commits since workflow start (more reliable after checkpoint)\n# Get the base commit (start of workflow) - try common refs\nbase_ref='{{ inputs.base_ref }}'\nchanged_files=''\nif [ -n \"$base_ref\" ]; then\n  if ! git rev-parse --verify \"$base_ref\" >/dev/null 2>&1; then\n    echo \"Configured base_ref is not a valid ref: $base_ref\" >&2\n    exit 1\n  fi\nelse\n  for ref in origin/main main; do\n    if git rev-parse --verify \"$ref\" >/dev/null 2>&1; then\n      base_ref=$(git merge-base HEAD \"$ref\" 2>/dev/null || true)\n      [ -n \"$base_ref\" ] && break\n    fi\n  done\nfi\n\nif [ -n \"$base_ref\" ]; then\n  echo \"Comparing HEAD with $base_ref...\"\n  changed_files=$(git diff --name-only \"$base_ref\" HEAD 2>/dev/null || true)\n  if [ -n \"$changed_files\" ]; then\n    echo \"Files changed since workflow start:\"\n    printf '%s\\n' \"$changed_files\"\n    echo ''\n    echo \"Change summary:\"\n    git diff --stat \"$base_ref\" HEAD || true\n    echo ''\n  else\n    echo \"No differences found between $base_ref and HEAD.\"\n    echo ''\n  fi\nelse\n  echo \"Could not determine base reference for comparison.\"\n  echo ''\nfi\n\n# 3. Check for very recent commits (Fabro checkpoints)\nrecent_commits=$(git log --oneline -5 --format='%h %s')\nif [ -n \"$recent_commits\" ]; then\n  echo \"Recent commits (may include Fabro checkpoints):\"\n  printf '%s\\n' \"$recent_commits\"\n  echo ''\nfi\n\n# 4. Gather all evidence\nevidence=''\nif [ -n \"$status\" ]; then\n  evidence=\"working-tree\"\nfi\nif [ -n \"$changed_files\" ]; then\n  evidence=\"${evidence:+$evidence, }base-head-diff\"\nfi\n\n# 5. Check for locked .feature file changes\nif [ -n \"$status\" ] && printf '%s\\n' \"$status\" | grep -E '\\.feature$'; then\n  echo 'ERROR: Final working tree includes locked acceptance feature changes.' >&2\n  echo 'Acceptance .feature files must not be modified during implementation.' >&2\n  exit 1\nfi\nif [ -n \"$changed_files\" ] && printf '%s\\n' \"$changed_files\" | grep -E '\\.feature$'; then\n  echo 'ERROR: Implementation modified locked acceptance feature files.' >&2\n  echo 'Acceptance .feature files must not be modified during implementation.' >&2\n  exit 1\nfi\n\n# 6. Fail if no evidence of changes\nif [ -z \"$evidence\" ]; then\n  echo 'ERROR: Iteration review reached finalization with no artifact evidence.' >&2\n  echo 'No working tree changes, no base-head diff, and no captured checkpoint found.' >&2\n  echo 'Refusing to report success without implementation artifacts.' >&2\n  exit 1\nfi\n\necho \"Final artifact evidence confirmed: $evidence\"\necho 'Final artifact gate passed.'"
    ]

    final_summary [
        label="Final Summary",
        shape=tab,
        prompt="@prompts/final_summary.md"
    ]

    start -> read_plan
    read_plan -> preflight_sandbox [condition="outcome=succeeded"]
    read_plan -> read_failed
    read_failed -> exit

    preflight_sandbox -> dev_check [condition="outcome=succeeded"]
    preflight_sandbox -> preflight_failed
    preflight_failed -> exit

    dev_check -> collect_implementation_evidence [label="Dev check passed", condition="outcome=succeeded"]
    dev_check -> fix_dev_check [label="Fix failures"]
    fix_dev_check -> dev_check
    collect_implementation_evidence -> plan_conformance_gate [condition="outcome=succeeded"]
    collect_implementation_evidence -> collect_evidence_failed
    collect_evidence_failed -> exit

    plan_conformance_gate -> plan_gate
    plan_gate -> adr_coherence_gate [label="Conformant", condition="context.plan_conformant=true"]
    plan_gate -> snapshot_before_plan_repair [label="Plan rework", condition="context.plan_rework_available=true"]
    plan_gate -> plan_not_ready [label="Needs human input"]
    snapshot_before_plan_repair -> fix_plan_conformance
    fix_plan_conformance -> verify_plan_repair
    verify_plan_repair -> dev_check
    plan_not_ready -> exit

    adr_coherence_gate -> adr_gate
    adr_gate -> review_fork [label="Coherent", condition="context.adr_coherent=true"]
    adr_gate -> snapshot_before_adr_repair [label="ADR rework", condition="context.adr_rework_available=true"]
    adr_gate -> adr_not_ready [label="Needs human input"]
    snapshot_before_adr_repair -> fix_adr_coherence
    fix_adr_coherence -> verify_adr_repair
    verify_adr_repair -> dev_check
    adr_not_ready -> exit

    review_fork -> claude_review
    review_fork -> codex_review
    review_fork -> gemini_review
    claude_review -> review_merge
    codex_review -> review_merge
    gemini_review -> review_merge
    review_merge -> synthesize_review
    synthesize_review -> review_gate
    review_gate -> final_artifact_gate [label="Accepted", condition="context.implementation_accepted=true"]
    review_gate -> snapshot_before_review_repair [label="Fix", condition="context.review_fixes_available=true"]
    review_gate -> not_ready [label="Needs human input"]
    snapshot_before_review_repair -> apply_review_fixes
    apply_review_fixes -> verify_review_repair
    verify_review_repair -> dev_check

    final_artifact_gate -> final_summary
    final_summary -> exit
    not_ready -> exit
}
