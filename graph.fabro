digraph FinalCombinedSourceQuality {
 graph [default_max_retries=0]
 start [shape=Mdiamond]
 end [shape=Msquare]
 error [shape=parallelogram, script="exit 1"]
 command [shape=parallelogram, timeout="45m", script="python3 -B - <<'FINAL_SOURCE_QUALITY_PY'\nimport datetime\nimport hashlib\nimport io\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport stat\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom urllib.parse import urlsplit\n\n\nEXPECTED_SOURCE = \"a54bab9ce3b726ce96ffb84632ce2343aeac811d\"\nEXPECTED_TREE = \"643f657a3cfddb0be70d2c5bc40ad78c91b2d6d3\"\nOUT = Path(\".fabro/tmp/final-source-quality\")\nOUT.mkdir(parents=True, exist_ok=True)\nCLI_PROBE_SCRIPT = \"#!/usr/bin/env bash\\nset -euo pipefail\\n\\nfixture=\\\"acceptance-tests/features/qa_wip_declaration_probe.feature\\\"\\nevidence_dir=\\\"${FINAL_SOURCE_QUALITY_EVIDENCE_DIR:-.fabro/tmp/final-source-quality}\\\"\\ngreen_sentinel=\\\"This scenario now passes. Remove its @wip tag.\\\"\\nowned=false\\nlast_status=0\\nlast_stdout=\\\"\\\"\\nlast_stderr=\\\"\\\"\\n\\nrequire_owned_fixture() {\\n  if [[ \\\"$owned\\\" != true ]] || [[ ! -f \\\"$fixture\\\" ]] || [[ -L \\\"$fixture\\\" ]]; then\\n    echo \\\"Refusing to overwrite or remove an unowned fixture: $fixture\\\" >&2\\n    return 1\\n  fi\\n}\\n\\nremove_owned_fixture() {\\n  if [[ \\\"$owned\\\" != true ]]; then\\n    return 0\\n  fi\\n  require_owned_fixture\\n  rm -f -- \\\"$fixture\\\"\\n  owned=false\\n}\\n\\ncleanup() {\\n  local status=$?\\n  trap - EXIT\\n  if ! remove_owned_fixture; then\\n    if [[ \\\"$status\\\" -eq 0 ]]; then\\n      status=3\\n    fi\\n  fi\\n  exit \\\"$status\\\"\\n}\\ntrap cleanup EXIT\\n\\nif [[ -e \\\"$fixture\\\" ]] || [[ -L \\\"$fixture\\\" ]]; then\\n  echo \\\"Refusing to overwrite $fixture\\\" >&2\\n  exit 2\\nfi\\n\\nif rg -n \\\"^[[:space:]]*@.*wip\\\" acceptance-tests/features --glob \\\"*.feature\\\"; then\\n  echo \\\"Existing @wip declaration would invalidate this isolated probe.\\\" >&2\\n  exit 2\\nfi\\n\\nif [[ -L \\\"$evidence_dir\\\" ]]; then\\n  echo \\\"Refusing symlink evidence directory: $evidence_dir\\\" >&2\\n  exit 2\\nfi\\nmkdir -p -- \\\"$evidence_dir\\\"\\n\\ncapture_wip() {\\n  local name=\\\"$1\\\"\\n  last_stdout=\\\"$evidence_dir/cli-${name}.stdout.log\\\"\\n  last_stderr=\\\"$evidence_dir/cli-${name}.stderr.log\\\"\\n\\n  set +e\\n  bin/dev test:wip >\\\"$last_stdout\\\" 2>\\\"$last_stderr\\\"\\n  last_status=$?\\n  set -e\\n\\n  cat \\\"$last_stdout\\\"\\n  cat \\\"$last_stderr\\\" >&2\\n  printf '{\\\"name\\\":\\\"%s\\\",\\\"argv\\\":[\\\"bin/dev\\\",\\\"test:wip\\\"],\\\"exit\\\":%d,\\\"stdout\\\":\\\"%s\\\",\\\"stderr\\\":\\\"%s\\\"}\\\\n' \\\\\\n    \\\"$name\\\" \\\"$last_status\\\" \\\"$last_stdout\\\" \\\"$last_stderr\\\" \\\\\\n    >\\\"$evidence_dir/cli-${name}.result.json\\\"\\n}\\n\\nrequire_output() {\\n  local expected=\\\"$1\\\"\\n  if ! grep -Fq -- \\\"$expected\\\" \\\"$last_stdout\\\" \\\"$last_stderr\\\"; then\\n    echo \\\"Missing expected output: $expected\\\" >&2\\n    return 1\\n  fi\\n}\\n\\nreject_output() {\\n  local forbidden=\\\"$1\\\"\\n  if grep -Fq -- \\\"$forbidden\\\" \\\"$last_stdout\\\" \\\"$last_stderr\\\"; then\\n    echo \\\"Unexpected output: $forbidden\\\" >&2\\n    return 1\\n  fi\\n}\\n\\nrun_rejected_wip() {\\n  local name=\\\"$1\\\"\\n  local expected=\\\"$2\\\"\\n  capture_wip \\\"$name\\\"\\n  if [[ \\\"$last_status\\\" -eq 0 ]]; then\\n    echo \\\"Expected bin/dev test:wip to reject $name\\\" >&2\\n    return 1\\n  fi\\n  require_output \\\"$expected\\\"\\n  reject_output \\\"$green_sentinel\\\"\\n}\\n\\nrun_green_wip() {\\n  local name=\\\"$1\\\"\\n  local expected_row_one=\\\"$2\\\"\\n  local expected_row_two=\\\"$3\\\"\\n  local forbidden_label=\\\"$4\\\"\\n\\n  capture_wip \\\"$name\\\"\\n  test \\\"$last_status\\\" -eq 1\\n  require_output \\\"2 tests, 0 failures\\\"\\n  require_output \\\"$expected_row_one\\\"\\n  require_output \\\"$expected_row_two\\\"\\n  require_output \\\"$green_sentinel\\\"\\n\\n  if [[ -n \\\"$forbidden_label\\\" ]]; then\\n    reject_output \\\"$forbidden_label\\\"\\n  fi\\n}\\n\\nrun_rejected_wip \\\"zero-declarations\\\" \\\"found none\\\"\\n\\nif ! (\\n  set -o noclobber\\n  cat >\\\"$fixture\\\" <<'EOF'\\nFeature: QA WIP Outline execution\\n  @wip\\n  Scenario Outline: QA outline preserves membership for <person>\\n    Given <person> is a member of Kootenay Mountaineering Club\\n    Then <person> should be an active member of Kootenay Mountaineering Club\\n\\n    Examples: selected members\\n      | person |\\n      | Alice  |\\n      | Bob    |\\nEOF\\n); then\\n  echo \\\"Exclusive fixture creation failed: $fixture\\\" >&2\\n  exit 2\\nfi\\nowned=true\\n\\nrun_green_wip \\\\\\n  \\\"outline-two-rows\\\" \\\\\\n  \\\"WIP: qa_wip_declaration_probe.feature: QA outline preserves membership for <person> (selected members: row 1) (row 1)\\\" \\\\\\n  \\\"WIP: qa_wip_declaration_probe.feature: QA outline preserves membership for <person> (selected members: row 2) (row 2)\\\" \\\\\\n  \\\"\\\"\\n\\nrequire_owned_fixture\\ncat >\\\"$fixture\\\" <<'EOF'\\nFeature: QA WIP Examples execution\\n  Scenario Outline: QA Examples preserve membership for <person>\\n    Given <person> is a member of Kootenay Mountaineering Club\\n    Then <person> should be an active member of Kootenay Mountaineering Club\\n\\n    @wip\\n    Examples: selected members\\n      | person |\\n      | Alice  |\\n      | Bob    |\\n\\n    Examples: ordinary member\\n      | person |\\n      | Carol  |\\nEOF\\n\\nrun_green_wip \\\\\\n  \\\"examples-two-rows\\\" \\\\\\n  \\\"WIP: qa_wip_declaration_probe.feature: QA Examples preserve membership for <person> (selected members: row 1) (row 1)\\\" \\\\\\n  \\\"WIP: qa_wip_declaration_probe.feature: QA Examples preserve membership for <person> (selected members: row 2) (row 2)\\\" \\\\\\n  \\\"ordinary member: row 1\\\"\\n\\nrequire_owned_fixture\\ncat >\\\"$fixture\\\" <<'EOF'\\nFeature: QA multiple WIP rejection\\n  @wip\\n  Scenario: First WIP\\n    Given Alice is a member of Kootenay Mountaineering Club\\n    Then Alice should be an active member of Kootenay Mountaineering Club\\n\\n  @wip\\n  Scenario: Second WIP\\n    Given Bob is a member of Kootenay Mountaineering Club\\n    Then Bob should be an active member of Kootenay Mountaineering Club\\nEOF\\n\\nrun_rejected_wip \\\"multiple-declarations\\\" \\\"found 2\\\"\\nrequire_output \\\"First WIP\\\"\\nrequire_output \\\"Second WIP\\\"\\n\\nremove_owned_fixture\\ntrap - EXIT\\necho \\\"Actual zero, two-row Outline, two-row selected-Examples, and multiple WIP CLI probes passed.\\\"\\n\"\n\n\ndef utc_now():\n    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n\n\ndef write_json(name, value):\n    (OUT / name).write_text(json.dumps(value, indent=2, sort_keys=True) + \"\\n\")\n\n\ndef git(*args, check=True):\n    return subprocess.run(\n        [\"git\", *args],\n        check=check,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n    )\n\n\ndef git_text(*args, optional=False):\n    result = git(*args, check=not optional)\n    if result.returncode and optional:\n        return None\n    return result.stdout.decode().strip()\n\n\ndef safe_remote_identity(remote):\n    if remote is None:\n        return None\n    digest = hashlib.sha256(remote.encode()).hexdigest()\n    if \"://\" in remote:\n        parsed = urlsplit(remote)\n        host = parsed.hostname or \"unknown-host\"\n        if parsed.port is not None:\n            host = f\"{host}:{parsed.port}\"\n        host_path = host + parsed.path\n    else:\n        match = re.fullmatch(r\"(?:[^@]+@)?([^:]+):(.+)\", remote)\n        host_path = (\n            match.group(1) + \"/\" + match.group(2).lstrip(\"/\")\n            if match else \"non-network-remote\"\n        )\n    return {\"host_path\": host_path, \"full_url_sha256\": digest}\n\n\ndef source_snapshot(label):\n    head = git_text(\"rev-parse\", \"HEAD\")\n    tree = git_text(\"rev-parse\", \"HEAD^{tree}\")\n    index_tree = git_text(\"write-tree\")\n    worktree_diff = git(\"diff\", \"--binary\").stdout\n    index_diff = git(\"diff\", \"--cached\", \"--binary\").stdout\n    entries = []\n    tree_rows = git(\"ls-tree\", \"-r\", \"-z\", \"--full-tree\", head).stdout\n    for row in tree_rows.split(b\"\\0\"):\n        if not row:\n            continue\n        metadata, raw_path = row.split(b\"\\t\", 1)\n        mode, kind, blob = metadata.split()\n        if kind != b\"blob\":\n            raise AssertionError((\"unsupported tracked entry\", os.fsdecode(raw_path), kind.decode()))\n        entries.append((mode.decode(), blob, os.fsdecode(raw_path)))\n\n    objects = subprocess.check_output(\n        [\"git\", \"cat-file\", \"--batch\"],\n        input=b\"\\n\".join(blob for _, blob, _ in entries) + b\"\\n\",\n    )\n    stream = io.BytesIO(objects)\n    fingerprint = hashlib.sha256()\n    mismatches = []\n    for expected_mode, blob, name in entries:\n        header = stream.readline().split()\n        if len(header) != 3 or header[0] != blob or header[1] != b\"blob\":\n            raise AssertionError((\"bad cat-file header\", header, name))\n        expected_bytes = stream.read(int(header[2]))\n        if stream.read(1) != b\"\\n\":\n            raise AssertionError((\"bad cat-file separator\", name))\n        path = Path(name)\n        if path.is_symlink():\n            actual_mode = \"120000\"\n            actual_bytes = os.fsencode(os.readlink(path))\n        elif path.exists() and stat.S_ISREG(path.stat().st_mode):\n            actual_mode = \"100755\" if path.stat().st_mode & 0o111 else \"100644\"\n            actual_bytes = path.read_bytes()\n        else:\n            mismatches.append({\"path\": name, \"problem\": \"missing or unsupported worktree file\"})\n            continue\n        if actual_mode != expected_mode or actual_bytes != expected_bytes:\n            mismatches.append({\n                \"path\": name,\n                \"expected_mode\": expected_mode,\n                \"actual_mode\": actual_mode,\n                \"expected_blob\": blob.decode(),\n                \"actual_sha256\": hashlib.sha256(actual_bytes).hexdigest(),\n            })\n        fingerprint.update(os.fsencode(name) + b\"\\0\" + actual_mode.encode() + b\"\\0\" + actual_bytes)\n    if stream.read():\n        raise AssertionError(\"unexpected trailing cat-file output\")\n\n    snapshot = {\n        \"captured_at\": utc_now(),\n        \"head\": head,\n        \"head_tree\": tree,\n        \"index_tree\": index_tree,\n        \"branch_ref\": git_text(\"symbolic-ref\", \"-q\", \"HEAD\", optional=True),\n        \"branch_name\": git_text(\"symbolic-ref\", \"--short\", \"-q\", \"HEAD\", optional=True),\n        \"upstream\": git_text(\n            \"rev-parse\", \"--abbrev-ref\", \"--symbolic-full-name\", \"@{upstream}\", optional=True\n        ),\n        \"origin_remote\": safe_remote_identity(\n            git_text(\"config\", \"--get\", \"remote.origin.url\", optional=True)\n        ),\n        \"status\": git_text(\"status\", \"--porcelain=v2\", \"--branch\", \"--untracked-files=normal\"),\n        \"tracked_files\": len(entries),\n        \"actual_bytes_modes_sha256\": fingerprint.hexdigest(),\n        \"worktree_diff_sha256\": hashlib.sha256(worktree_diff).hexdigest(),\n        \"worktree_diff_bytes\": len(worktree_diff),\n        \"index_diff_sha256\": hashlib.sha256(index_diff).hexdigest(),\n        \"index_diff_bytes\": len(index_diff),\n        \"mismatches\": mismatches,\n    }\n    write_json(f\"source-{label}.json\", snapshot)\n    print(\"SOURCE_SNAPSHOT \" + label + \" \" + json.dumps(snapshot, sort_keys=True), flush=True)\n    return snapshot\n\n\ndef source_errors(snapshot):\n    errors = []\n    if snapshot[\"head\"] != EXPECTED_SOURCE:\n        errors.append(\"HEAD does not equal approved source\")\n    if snapshot[\"head_tree\"] != EXPECTED_TREE:\n        errors.append(\"HEAD tree does not equal approved tree\")\n    if snapshot[\"index_tree\"] != EXPECTED_TREE:\n        errors.append(\"index tree does not equal approved tree\")\n    if snapshot[\"worktree_diff_bytes\"] != 0:\n        errors.append(\"tracked worktree diff is not empty\")\n    if snapshot[\"index_diff_bytes\"] != 0:\n        errors.append(\"tracked index diff is not empty\")\n    if snapshot[\"mismatches\"]:\n        errors.append(\"tracked worktree bytes or modes do not match HEAD\")\n    return errors\n\n\ndef invariant(snapshot):\n    return {key: value for key, value in snapshot.items() if key != \"captured_at\"}\n\n\nresults = []\n\n\ndef save_results():\n    write_json(\"command-results.json\", {\n        \"source\": EXPECTED_SOURCE,\n        \"tree\": EXPECTED_TREE,\n        \"commands\": results,\n    })\n\n\ndef mirror_stream(source, sink, mirror):\n    while True:\n        chunk = source.read(65536)\n        if not chunk:\n            break\n        sink.write(chunk)\n        sink.flush()\n        mirror.write(chunk)\n        mirror.flush()\n\n\ndef slug(value):\n    return re.sub(r\"[^a-z0-9]+\", \"-\", value.lower()).strip(\"-\")\n\n\ndef run_check(name, argv, cwd=None, env=None):\n    ordinal = len(results) + 1\n    prefix = f\"{ordinal:02d}-{slug(name)}\"\n    stdout_path = OUT / f\"{prefix}.stdout.log\"\n    stderr_path = OUT / f\"{prefix}.stderr.log\"\n    started_at = utc_now()\n    started = time.monotonic()\n    error = None\n    try:\n        with stdout_path.open(\"wb\") as stdout_log, stderr_path.open(\"wb\") as stderr_log:\n            process = subprocess.Popen(\n                argv,\n                cwd=cwd,\n                env=env,\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n            )\n            stdout_thread = threading.Thread(\n                target=mirror_stream,\n                args=(process.stdout, stdout_log, sys.stdout.buffer),\n            )\n            stderr_thread = threading.Thread(\n                target=mirror_stream,\n                args=(process.stderr, stderr_log, sys.stderr.buffer),\n            )\n            stdout_thread.start()\n            stderr_thread.start()\n            exit_code = process.wait()\n            stdout_thread.join()\n            stderr_thread.join()\n    except OSError as exception:\n        exit_code = 127\n        error = f\"{type(exception).__name__}: {exception}\"\n        stderr_path.write_text(error + \"\\n\")\n        if not stdout_path.exists():\n            stdout_path.write_bytes(b\"\")\n        print(error, file=sys.stderr, flush=True)\n\n    result = {\n        \"name\": name,\n        \"argv\": argv,\n        \"cwd\": str(cwd) if cwd is not None else None,\n        \"started_at\": started_at,\n        \"finished_at\": utc_now(),\n        \"duration_ms\": round((time.monotonic() - started) * 1000),\n        \"exit\": exit_code,\n        \"stdout\": str(stdout_path),\n        \"stderr\": str(stderr_path),\n    }\n    if error is not None:\n        result[\"error\"] = error\n    results.append(result)\n    save_results()\n    print(\"COMMAND_EXIT \" + json.dumps(result, sort_keys=True), flush=True)\n    return result\n\n\ndef record_wrapper_error(exception):\n    result = {\n        \"name\": \"wrapper-error\",\n        \"argv\": [],\n        \"started_at\": utc_now(),\n        \"finished_at\": utc_now(),\n        \"duration_ms\": 0,\n        \"exit\": 125,\n        \"error\": f\"{type(exception).__name__}: {exception}\",\n    }\n    results.append(result)\n    save_results()\n    print(\"WRAPPER_ERROR \" + json.dumps(result, sort_keys=True), file=sys.stderr, flush=True)\n\n\ndef run_approved_cli_outline_examples_proof():\n    probe_path = OUT / \"four-case-cli-probe.sh\"\n    probe_path.write_text(CLI_PROBE_SCRIPT)\n    probe_environment = os.environ.copy()\n    probe_environment[\"FINAL_SOURCE_QUALITY_EVIDENCE_DIR\"] = str(OUT)\n    return run_check(\n        \"actual-four-case-wip-cli-probe\",\n        [\"bash\", str(probe_path)],\n        env=probe_environment,\n    )\n\n\nwrite_json(\"owner.json\", {\n    \"source\": EXPECTED_SOURCE,\n    \"tree\": EXPECTED_TREE,\n    \"purpose\": \"final-combined-source-managed-green-full-gate\",\n    \"models\": 0,\n})\n\nbefore = source_snapshot(\"before\")\nadmission_errors = source_errors(before)\nwrite_json(\"admission.json\", {\"errors\": admission_errors, \"accepted\": not admission_errors})\n\nif not admission_errors:\n    try:\n        checks = [\n            (\"shell-syntax-bin-dev\", [\"bash\", \"-n\", \"bin/dev\"]),\n            (\"node-syntax-cli\", [\"node\", \"--check\", \"dev-tools/bdd/cli.cjs\"]),\n            (\"node-syntax-core\", [\"node\", \"--check\", \"dev-tools/bdd/core.cjs\"]),\n            (\"node-syntax-workflow-mechanics\", [\"node\", \"--check\", \"dev-tools/bdd/test-workflow.cjs\"]),\n            (\"node-syntax-dev-cucumber-config\", [\"node\", \"--check\", \"dev-tests/cucumber.js\"]),\n            (\"node-syntax-dev-steps\", [\"node\", \"--check\", \"dev-tests/features/step_definitions/bdd_cli_steps.js\"]),\n            (\"node-syntax-dev-world\", [\"node\", \"--check\", \"dev-tests/features/support/world.js\"]),\n            (\"dev-check\", [\"bin/dev\", \"check\"]),\n            (\"node-workflow-mechanics-tests\", [\"node\", \"--test\", \"dev-tools/bdd/test-workflow.cjs\"]),\n            (\"python-boundary-tests\", [\"python3\", \"-B\", \".fabro/workflows/bdd-plan-implementation/eval/test_boundaries.py\"]),\n            (\"selection-helper-tests\", [\"python3\", \"-B\", \"-m\", \"unittest\", \"discover\", \"-s\", \".fabro/workflows/bdd-plan-implementation/eval/selection\", \"-p\", \"test_*.py\"]),\n            (\"single-scenario-helper-tests\", [\"python3\", \"-B\", \"-m\", \"unittest\", \"discover\", \"-s\", \".fabro/workflows/bdd-scenario-implementation/eval\", \"-p\", \"test_*.py\"]),\n            (\"focused-domain-cucumber-runner-tests\", [\"bin/dev\", \"test\", \"test/features/domain_cucumber_runner_test.exs\"]),\n            (\"focused-dev-wip-command-tests\", [\"bin/dev\", \"test\", \"test/features/dev_wip_command_test.exs\"]),\n        ]\n        for check_name, command in checks:\n            run_check(check_name, command)\n        run_approved_cli_outline_examples_proof()\n    except BaseException as exception:\n        record_wrapper_error(exception)\n\nafter = source_snapshot(\"after\")\nafter_errors = source_errors(after)\nsource_unchanged = invariant(before) == invariant(after)\nwrite_json(\"source-comparison.json\", {\n    \"source\": EXPECTED_SOURCE,\n    \"tree\": EXPECTED_TREE,\n    \"unchanged\": source_unchanged,\n    \"before_fingerprint\": before[\"actual_bytes_modes_sha256\"],\n    \"after_fingerprint\": after[\"actual_bytes_modes_sha256\"],\n    \"admission_errors\": admission_errors,\n    \"after_errors\": after_errors,\n})\n\nfailed = [result for result in results if result[\"exit\"] != 0]\naccepted = not admission_errors and not after_errors and source_unchanged and not failed\nsummary = {\n    \"source\": EXPECTED_SOURCE,\n    \"tree\": EXPECTED_TREE,\n    \"commands\": len(results),\n    \"failed\": [result[\"name\"] for result in failed],\n    \"source_unchanged\": source_unchanged,\n    \"accepted\": accepted,\n}\nwrite_json(\"final-diagnostics.json\", summary)\nprint(\"QUALITY_SUMMARY \" + json.dumps(summary, sort_keys=True), flush=True)\nif admission_errors or after_errors or not source_unchanged:\n    sys.exit(125)\nsys.exit(failed[0][\"exit\"] if failed else 0)\n\nFINAL_SOURCE_QUALITY_PY\n"]
 start -> command
 command -> end [condition="outcome=succeeded"]
 command -> error
}
