digraph WipDeclarationRedFollowUp1 {
 graph [default_max_retries=0]
 start [shape=Mdiamond]
 command [shape=parallelogram, timeout="30m", script="python3 -B - <<'WIP_DECLARATION_RED_FOLLOW_UP_1_PY'\nimport datetime\nimport hashlib\nimport io\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport stat\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom urllib.parse import urlsplit\n\n\nEXPECTED_SOURCE = \"20cbecdcdee0366e464cc488e163bbe44d5c540b\"\nEXPECTED_TREE = \"4616d5d46c2ef26e310579ab4337e3f52ef74de5\"\nEXPECTED_TESTS = 15\nEXPECTED_FAILURES = 8\nCOMMAND = [\"bin/dev\", \"test\", \"test/features/domain_cucumber_runner_test.exs\"]\nOUT = Path(\".fabro/tmp/wip-declaration-red-follow-up-1-evidence\")\nOUT.mkdir(parents=True, exist_ok=True)\n\nMODULE = \"Memba.DomainCucumberRunnerTest\"\nPOSITIVE_TWO_ROW_MATCH_FAILURES = {\n    \"one WIP outline is one declaration containing all of its expanded rows\",\n    \"one locally WIP Examples declaration contains all and only its expanded rows\",\n    \"outline-level WIP remains one declaration across separate Examples blocks\",\n    \"identical rows in one WIP declaration remain separate executions\",\n}\nMULTIPLICITY_SUBSTRING_FAILURES = {\n    \"separately WIP Examples blocks are separate declarations even on one outline\",\n    \"inherited feature WIP counts logical scenarios and outlines, not expanded rows\",\n    \"inherited rule WIP counts logical scenarios and outlines, not expanded rows\",\n}\nMAP_LIST_MATCH_FAILURE = \"WIP is still included in ordinary domain regression selection\"\nEXPECTED_FAILURE_NAMES = (\n    POSITIVE_TWO_ROW_MATCH_FAILURES\n    | MULTIPLICITY_SUBSTRING_FAILURES\n    | {MAP_LIST_MATCH_FAILURE}\n)\nFAILURE_START = re.compile(\n    rf\"(?m)^\\s*\\d+\\)\\s+test\\s+(.+?)\\s+\\({re.escape(MODULE)}\\)\\s*$\"\n)\nSUMMARY = re.compile(r\"(?m)(\\d+)\\s+tests?,\\s+(\\d+)\\s+failures?\")\nRUNTIME_EXCEPTION = re.compile(r\"(?m)^\\s*\\*\\*\\s+\\(([^)]+)\\)\")\n\n\ndef utc_now():\n    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n\n\ndef write_json(name, value):\n    (OUT / name).write_text(json.dumps(value, indent=2, sort_keys=True) + \"\\n\")\n\n\ndef git(*args, check=True):\n    return subprocess.run(\n        [\"git\", *args],\n        check=check,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n    )\n\n\ndef git_text(*args, optional=False):\n    result = git(*args, check=not optional)\n    if result.returncode and optional:\n        return None\n    return result.stdout.decode().strip()\n\n\ndef safe_remote_identity(remote):\n    if remote is None:\n        return None\n    digest = hashlib.sha256(remote.encode()).hexdigest()\n    if \"://\" in remote:\n        parsed = urlsplit(remote)\n        host = parsed.hostname or \"unknown-host\"\n        if parsed.port is not None:\n            host = f\"{host}:{parsed.port}\"\n        host_path = host + parsed.path\n    else:\n        match = re.fullmatch(r\"(?:[^@]+@)?([^:]+):(.+)\", remote)\n        if match:\n            host_path = match.group(1) + \"/\" + match.group(2).lstrip(\"/\")\n        else:\n            host_path = \"non-network-remote\"\n    return {\"host_path\": host_path, \"full_url_sha256\": digest}\n\n\ndef source_snapshot(label):\n    head = git_text(\"rev-parse\", \"HEAD\")\n    tree = git_text(\"rev-parse\", \"HEAD^{tree}\")\n    index_tree = git_text(\"write-tree\")\n    worktree_diff = git(\"diff\", \"--binary\").stdout\n    index_diff = git(\"diff\", \"--cached\", \"--binary\").stdout\n    entries = []\n    tree_rows = git(\"ls-tree\", \"-r\", \"-z\", \"--full-tree\", head).stdout\n    for row in tree_rows.split(b\"\\0\"):\n        if not row:\n            continue\n        metadata, raw_path = row.split(b\"\\t\", 1)\n        mode, kind, blob = metadata.split()\n        if kind != b\"blob\":\n            raise AssertionError((\"unsupported tracked entry\", os.fsdecode(raw_path), kind.decode()))\n        entries.append((mode.decode(), blob, os.fsdecode(raw_path)))\n\n    objects = subprocess.check_output(\n        [\"git\", \"cat-file\", \"--batch\"],\n        input=b\"\\n\".join(blob for _, blob, _ in entries) + b\"\\n\",\n    )\n    stream = io.BytesIO(objects)\n    fingerprint = hashlib.sha256()\n    mismatches = []\n    for expected_mode, blob, name in entries:\n        header = stream.readline().split()\n        if len(header) != 3 or header[0] != blob or header[1] != b\"blob\":\n            raise AssertionError((\"bad cat-file header\", header, name))\n        expected_bytes = stream.read(int(header[2]))\n        if stream.read(1) != b\"\\n\":\n            raise AssertionError((\"bad cat-file separator\", name))\n        path = Path(name)\n        if path.is_symlink():\n            actual_mode = \"120000\"\n            actual_bytes = os.fsencode(os.readlink(path))\n        elif path.exists() and stat.S_ISREG(path.stat().st_mode):\n            actual_mode = \"100755\" if path.stat().st_mode & 0o111 else \"100644\"\n            actual_bytes = path.read_bytes()\n        else:\n            mismatches.append({\"path\": name, \"problem\": \"missing or unsupported worktree file\"})\n            continue\n        if actual_mode != expected_mode or actual_bytes != expected_bytes:\n            mismatches.append({\n                \"path\": name,\n                \"expected_mode\": expected_mode,\n                \"actual_mode\": actual_mode,\n                \"expected_blob\": blob.decode(),\n                \"actual_sha256\": hashlib.sha256(actual_bytes).hexdigest(),\n            })\n        fingerprint.update(os.fsencode(name) + b\"\\0\" + actual_mode.encode() + b\"\\0\" + actual_bytes)\n    if stream.read():\n        raise AssertionError(\"unexpected trailing cat-file output\")\n\n    snapshot = {\n        \"captured_at\": utc_now(),\n        \"head\": head,\n        \"head_tree\": tree,\n        \"index_tree\": index_tree,\n        \"branch_ref\": git_text(\"symbolic-ref\", \"-q\", \"HEAD\", optional=True),\n        \"branch_name\": git_text(\"symbolic-ref\", \"--short\", \"-q\", \"HEAD\", optional=True),\n        \"upstream\": git_text(\n            \"rev-parse\", \"--abbrev-ref\", \"--symbolic-full-name\", \"@{upstream}\", optional=True\n        ),\n        \"origin_remote\": safe_remote_identity(\n            git_text(\"config\", \"--get\", \"remote.origin.url\", optional=True)\n        ),\n        \"status\": git_text(\"status\", \"--porcelain=v2\", \"--branch\", \"--untracked-files=normal\"),\n        \"tracked_files\": len(entries),\n        \"actual_bytes_modes_sha256\": fingerprint.hexdigest(),\n        \"worktree_diff_sha256\": hashlib.sha256(worktree_diff).hexdigest(),\n        \"worktree_diff_bytes\": len(worktree_diff),\n        \"index_diff_sha256\": hashlib.sha256(index_diff).hexdigest(),\n        \"index_diff_bytes\": len(index_diff),\n        \"mismatches\": mismatches,\n    }\n    write_json(f\"source-{label}.json\", snapshot)\n    print(\"SOURCE_SNAPSHOT \" + label + \" \" + json.dumps(snapshot, sort_keys=True), flush=True)\n    return snapshot\n\n\ndef invariant(snapshot):\n    return {key: value for key, value in snapshot.items() if key != \"captured_at\"}\n\n\ndef initial_source_errors(snapshot):\n    errors = []\n    if snapshot[\"head\"] != EXPECTED_SOURCE:\n        errors.append(\"HEAD does not equal approved source\")\n    if snapshot[\"head_tree\"] != EXPECTED_TREE:\n        errors.append(\"HEAD tree does not equal approved tree\")\n    if snapshot[\"index_tree\"] != EXPECTED_TREE:\n        errors.append(\"index tree does not equal approved tree\")\n    if snapshot[\"worktree_diff_bytes\"] != 0:\n        errors.append(\"tracked worktree diff is not empty\")\n    if snapshot[\"index_diff_bytes\"] != 0:\n        errors.append(\"tracked index diff is not empty\")\n    if snapshot[\"mismatches\"]:\n        errors.append(\"tracked worktree bytes or modes do not match HEAD\")\n    return errors\n\n\ndef mirror_stream(source, sink, mirror):\n    while True:\n        chunk = source.read(65536)\n        if not chunk:\n            break\n        sink.write(chunk)\n        sink.flush()\n        mirror.write(chunk)\n        mirror.flush()\n\n\ndef run_focused_command():\n    stdout_path = OUT / \"focused-command.stdout.log\"\n    stderr_path = OUT / \"focused-command.stderr.log\"\n    started_at = utc_now()\n    started = time.monotonic()\n    error = None\n    try:\n        with stdout_path.open(\"wb\") as stdout_log, stderr_path.open(\"wb\") as stderr_log:\n            process = subprocess.Popen(COMMAND, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n            stdout_thread = threading.Thread(\n                target=mirror_stream,\n                args=(process.stdout, stdout_log, sys.stdout.buffer),\n            )\n            stderr_thread = threading.Thread(\n                target=mirror_stream,\n                args=(process.stderr, stderr_log, sys.stderr.buffer),\n            )\n            stdout_thread.start()\n            stderr_thread.start()\n            exit_code = process.wait()\n            stdout_thread.join()\n            stderr_thread.join()\n    except OSError as exception:\n        exit_code = 127\n        error = f\"{type(exception).__name__}: {exception}\"\n        stderr_path.write_text(error + \"\\n\")\n        if not stdout_path.exists():\n            stdout_path.write_bytes(b\"\")\n        print(error, file=sys.stderr, flush=True)\n\n    result = {\n        \"name\": \"focused-domain-cucumber-runner-test\",\n        \"argv\": COMMAND,\n        \"started_at\": started_at,\n        \"finished_at\": utc_now(),\n        \"duration_ms\": round((time.monotonic() - started) * 1000),\n        \"exit\": exit_code,\n        \"stdout\": str(stdout_path),\n        \"stderr\": str(stderr_path),\n    }\n    if error is not None:\n        result[\"error\"] = error\n    write_json(\"command-result.json\", result)\n    print(\"COMMAND_EXIT \" + json.dumps(result, sort_keys=True), flush=True)\n    return result\n\n\ndef split_failure_blocks(text):\n    matches = list(FAILURE_START.finditer(text))\n    blocks = {}\n    duplicates = []\n    for index, match in enumerate(matches):\n        name = match.group(1)\n        end = matches[index + 1].start() if index + 1 < len(matches) else len(text)\n        finished = text.find(\"\\nFinished in \", match.end(), end)\n        if finished != -1:\n            end = finished\n        if name in blocks:\n            duplicates.append(name)\n        blocks[name] = text[match.start():end]\n    return blocks, duplicates\n\n\ndef reason_kind(block):\n    exception = RUNTIME_EXCEPTION.search(block)\n    if exception:\n        return \"runtime_exception\", exception.group(1)\n    if re.search(r\"(?m)^\\s*match \\(=\\) failed\\s*$\", block):\n        return \"match_equals_failed\", None\n    if re.search(r\"(?m)^\\s*Assertion with =~ failed\\s*$\", block):\n        return \"substring_assertion_failed\", None\n    return \"unknown\", None\n\n\ndef classify_failure(name, block):\n    kind, exception = reason_kind(block)\n    errors = []\n    if kind == \"runtime_exception\":\n        errors.append(f\"unexpected runtime exception: {exception}\")\n    elif kind == \"unknown\":\n        errors.append(\"unrecognized failure reason\")\n\n    if name in POSITIVE_TWO_ROW_MATCH_FAILURES:\n        expected_kind = \"match_equals_failed\"\n        if kind != expected_kind:\n            errors.append(f\"expected {expected_kind}, got {kind}\")\n        if not re.search(r\"(?m)^\\s*left:\\s+\\{:ok,\\s*selected_rows\\}\\s*$\", block):\n            errors.append(\"missing {:ok, selected_rows} expected left-hand value\")\n        if not re.search(r\"(?s)right:\\s+\\{:error,.*?but found 2:\", block):\n            errors.append(\"actual return is not {:error, ... found 2 ...}\")\n    elif name in MULTIPLICITY_SUBSTRING_FAILURES:\n        expected_kind = \"substring_assertion_failed\"\n        if kind != expected_kind:\n            errors.append(f\"expected {expected_kind}, got {kind}\")\n        if not re.search(r'(?m)^\\s*code:\\s+assert message =~ \"found 2\"\\s*$', block):\n            errors.append(\"missing expected found-2 substring assertion\")\n        if not re.search(r'(?s)left:\\s+\".*?but found 3:', block):\n            errors.append(\"actual multiplicity message does not report found 3\")\n        if not re.search(r'(?m)^\\s*right:\\s+\"found 2\"\\s*$', block):\n            errors.append(\"expected multiplicity substring is not found 2\")\n    elif name == MAP_LIST_MATCH_FAILURE:\n        expected_kind = \"match_equals_failed\"\n        if kind != expected_kind:\n            errors.append(f\"expected {expected_kind}, got {kind}\")\n        if not re.search(\n            r'(?m)^\\s*left:\\s+\\{:ok, \\[%\\{scenario: %\\{name: \"Current red example\"\\}\\}\\]\\}\\s*$',\n            block,\n        ):\n            errors.append(\"missing expected one-element list left-hand shape\")\n        if not re.search(r\"(?s)right:\\s*\\{:ok,\\s*\\n\\s*%\\{.*?scenario:\", block):\n            errors.append(\"actual return is not the old {:ok, map} shape\")\n    else:\n        expected_kind = None\n        errors.append(\"unexpected failure name\")\n\n    return {\n        \"name\": name,\n        \"expected_reason_kind\": expected_kind,\n        \"actual_reason_kind\": kind,\n        \"exception\": exception,\n        \"accepted\": not errors,\n        \"errors\": errors,\n    }\n\n\ndef parse_test_result(command_result):\n    raw = (OUT / \"focused-command.stdout.log\").read_text(errors=\"replace\")\n    raw += \"\\n\" + (OUT / \"focused-command.stderr.log\").read_text(errors=\"replace\")\n    text = re.sub(r\"\\x1b\\[[0-9;]*[A-Za-z]\", \"\", raw)\n    blocks, duplicates = split_failure_blocks(text)\n    summaries = SUMMARY.findall(text)\n    tests = int(summaries[-1][0]) if summaries else None\n    failures = int(summaries[-1][1]) if summaries else None\n    names = set(blocks)\n    expected_names = sorted(EXPECTED_FAILURE_NAMES)\n    actual_names = sorted(names)\n    details = [classify_failure(name, blocks[name]) for name in actual_names]\n    global_errors = []\n    if command_result.get(\"argv\") != COMMAND:\n        global_errors.append(\"command argv does not match the frozen focused module command\")\n    if command_result.get(\"exit\", 0) == 0:\n        global_errors.append(\"focused command did not exit nonzero\")\n    if tests != EXPECTED_TESTS or failures != EXPECTED_FAILURES:\n        global_errors.append(\n            f\"expected {EXPECTED_TESTS} tests/{EXPECTED_FAILURES} failures, got {tests}/{failures}\"\n        )\n    if names != EXPECTED_FAILURE_NAMES:\n        global_errors.append(\"failure-name set does not exactly match the frozen set\")\n    if duplicates:\n        global_errors.append(\"duplicate failure blocks present\")\n    if RUNTIME_EXCEPTION.search(text):\n        global_errors.append(\"one or more failure blocks contain a runtime exception\")\n    accepted_reasoned_red = not global_errors and all(detail[\"accepted\"] for detail in details)\n    return {\n        \"tests\": tests,\n        \"failures\": failures,\n        \"failure_names\": actual_names,\n        \"expected_failure_names\": expected_names,\n        \"missing_expected_failures\": sorted(EXPECTED_FAILURE_NAMES.difference(names)),\n        \"unexpected_failures\": sorted(names.difference(EXPECTED_FAILURE_NAMES)),\n        \"duplicate_failure_names\": duplicates,\n        \"global_errors\": global_errors,\n        \"failure_details\": details,\n        \"required_reason_counts\": {\n            \"match_equals_failed\": 5,\n            \"substring_assertion_failed\": 3,\n            \"runtime_exception\": 0,\n        },\n        \"actual_reason_counts\": {\n            kind: sum(detail[\"actual_reason_kind\"] == kind for detail in details)\n            for kind in (\"match_equals_failed\", \"substring_assertion_failed\", \"runtime_exception\", \"unknown\")\n        },\n        \"exact_names_and_count\": (\n            tests == EXPECTED_TESTS and failures == EXPECTED_FAILURES and names == EXPECTED_FAILURE_NAMES\n        ),\n        \"accepted_reasoned_red\": accepted_reasoned_red,\n    }\n\n\ndef main():\n    write_json(\"owner.json\", {\n        \"source\": EXPECTED_SOURCE,\n        \"tree\": EXPECTED_TREE,\n        \"purpose\": \"expected-tdd-red-for-wip-declaration-granularity-follow-up-1\",\n        \"model_nodes\": 0,\n        \"command\": COMMAND,\n    })\n\n    before = source_snapshot(\"before\")\n    admission_errors = initial_source_errors(before)\n    command_result = None\n    if admission_errors:\n        print(\"SOURCE_ADMISSION_FAILED \" + json.dumps(admission_errors), file=sys.stderr, flush=True)\n    else:\n        command_result = run_focused_command()\n\n    after = source_snapshot(\"after\")\n    source_unchanged = invariant(before) == invariant(after)\n    after_errors = initial_source_errors(after)\n    parsed = parse_test_result(command_result) if command_result is not None else {\n        \"tests\": None,\n        \"failures\": None,\n        \"failure_names\": [],\n        \"expected_failure_names\": sorted(EXPECTED_FAILURE_NAMES),\n        \"missing_expected_failures\": sorted(EXPECTED_FAILURE_NAMES),\n        \"unexpected_failures\": [],\n        \"duplicate_failure_names\": [],\n        \"global_errors\": [\"focused command was not executed\"],\n        \"failure_details\": [],\n        \"required_reason_counts\": {\n            \"match_equals_failed\": 5,\n            \"substring_assertion_failed\": 3,\n            \"runtime_exception\": 0,\n        },\n        \"actual_reason_counts\": {\n            \"match_equals_failed\": 0,\n            \"substring_assertion_failed\": 0,\n            \"runtime_exception\": 0,\n            \"unknown\": 0,\n        },\n        \"exact_names_and_count\": False,\n        \"accepted_reasoned_red\": False,\n    }\n    desired_red = bool(\n        command_result is not None\n        and command_result[\"exit\"] != 0\n        and parsed[\"accepted_reasoned_red\"]\n        and not admission_errors\n        and not after_errors\n        and source_unchanged\n    )\n    final = {\n        \"purpose\": \"expected-tdd-red-for-wip-declaration-granularity-follow-up-1\",\n        \"source\": EXPECTED_SOURCE,\n        \"tree\": EXPECTED_TREE,\n        \"command\": command_result,\n        \"parsed_test_result\": parsed,\n        \"desired_tdd_red\": desired_red,\n        \"admission_errors\": admission_errors,\n        \"after_errors\": after_errors,\n        \"source_unchanged\": source_unchanged,\n        \"before_fingerprint\": before[\"actual_bytes_modes_sha256\"],\n        \"after_fingerprint\": after[\"actual_bytes_modes_sha256\"],\n    }\n    write_json(\"final-diagnostics.json\", final)\n    write_json(\"source-comparison.json\", {\n        \"source\": EXPECTED_SOURCE,\n        \"tree\": EXPECTED_TREE,\n        \"unchanged\": source_unchanged,\n        \"before\": invariant(before),\n        \"after\": invariant(after),\n    })\n    print(\"TDD_RED_SUMMARY \" + json.dumps(final, sort_keys=True), flush=True)\n\n    if admission_errors or after_errors or not source_unchanged:\n        return 90\n    if command_result[\"exit\"] != 0:\n        return command_result[\"exit\"]\n    return 0 if desired_red else 86\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\nWIP_DECLARATION_RED_FOLLOW_UP_1_PY\n"]
 end [shape=Msquare]
 error [shape=parallelogram, script="exit 1"]
 start -> command
 command -> end [condition="outcome=succeeded"]
 command -> error
}
