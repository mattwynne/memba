#!/usr/bin/env bash
# @describe Memba development commands

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [ "${MEMBA_DEVENV_SHELL:-}" != "1" ]; then
  exec env \
    -u DEVENV_DOTFILE \
    -u DEVENV_PROFILE \
    -u DEVENV_ROOT \
    -u DEVENV_STATE \
    -u DEVENV_TASKS \
    -u DEVENV_TASK_FILE \
    -u PGDATA \
    -u PGHOST \
    -u PGPORT \
    MEMBA_DEVENV_SHELL=1 \
    devenv shell -- "$0" "$@"
fi

if ! command -v argc >/dev/null 2>&1; then
  echo "Missing required tool: argc. devenv shell did not provide the expected environment." >&2
  exit 1
fi

# @cmd Start development services
up() {
  if pg_isready -h "$PGHOST" -p "$PGPORT" >/dev/null 2>&1; then
    return
  fi

  # Use devenv's process-compose backend directly. A previous run can leave
  # process-compose thinking postgres is "ready" even though the socket/port in
  # the current shell is not accepting connections, so reset stale processes
  # before starting with strict ports.
  devenv processes down >/dev/null 2>&1 || true
  DEVENV_TUI=false devenv processes up --strict-ports -d postgres
  devenv processes wait --timeout 120

  if ! pg_isready -h "$PGHOST" -p "$PGPORT" >/dev/null 2>&1; then
    devenv processes logs -n 100 postgres >&2 || true
    echo "Postgres did not become ready at PGHOST=$PGHOST PGPORT=$PGPORT" >&2
    exit 1
  fi
}

# @cmd Stop development services
down() {
  devenv processes down || true
}

precommit() {
  (cd "$repo_root/web" && mix precommit)
}

# @cmd Run the standard local quality gate with required services
ci() {
  up
  trap down EXIT
  precommit
}

# @cmd Start the Phoenix web app
web() {
  (cd web && mix phx.server)
}

# @cmd Run the standard local quality gate
check() {
  up
  trap down EXIT
  precommit
}

# @cmd Verify the Fabro sandbox runtime contract
sandbox_check() {
  export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"

  echo "== sandbox environment =="
  for name in HOME MIX_HOME HEX_HOME XDG_CACHE_HOME DEVENV_ROOT DEVENV_STATE DEVENV_PROFILE DEVENV_DOTFILE PGHOST PGPORT PGDATA; do
    eval "value=\${$name-}"
    printf '%s=%s\n' "$name" "$value"
  done

  for tool in devenv git pg_isready elixir mix node npm; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "Missing required sandbox tool: $tool" >&2
      exit 1
    fi
  done

  for name in HOME MIX_HOME HEX_HOME XDG_CACHE_HOME; do
    eval "dir=\${$name-}"
    if [ -z "$dir" ]; then
      echo "Missing runtime path: $name" >&2
      exit 1
    fi
    case "$dir" in
      /env|/env/*)
        echo "Runtime path $name points into stale/non-writable /env: $dir" >&2
        exit 1
        ;;
    esac
    mkdir -p "$dir"
    test -w "$dir"
    probe="$dir/.fabro-write-probe-$$"
    : > "$probe"
    rm -f "$probe"
  done

  up
  trap down EXIT

  echo "Starting test dependency compile smoke test..."
  (cd "$repo_root/web" && MIX_ENV=test mix deps.compile --force)

  echo "Sandbox runtime check passed."
}

# @cmd Run the acceptance test suite
acceptance() {
  (cd "$repo_root/acceptance-tests" && npm test -- "$@")
}

eval "$(argc --argc-eval "$0" "$@")"
