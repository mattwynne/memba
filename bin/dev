#!/usr/bin/env bash
# @describe Memba development commands

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

find_free_port() {
  if command -v python3 >/dev/null 2>&1; then
    python3 - <<'PY'
import socket
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
    s.bind(("127.0.0.1", 0))
    print(s.getsockname()[1])
PY
    return
  fi

  local port
  for port in $(seq 15432 16432); do
    if ! lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
      printf '%s\n' "$port"
      return
    fi
  done

  echo "Could not find a free Postgres port" >&2
  exit 1
}

if [ "${MEMBA_DEVENV_SHELL:-}" != "1" ]; then
  memba_postgres_port="${MEMBA_POSTGRES_PORT:-$(find_free_port)}"

  exec env \
    -u DEVENV_DOTFILE \
    -u DEVENV_PROFILE \
    -u DEVENV_ROOT \
    -u DEVENV_STATE \
    -u DEVENV_TASKS \
    -u DEVENV_TASK_FILE \
    -u PGDATA \
    -u PGHOST \
    -u PGPORT \
    MEMBA_DEVENV_SHELL=1 \
    MEMBA_POSTGRES_PORT="$memba_postgres_port" \
    devenv shell -O services.postgres.port:int "$memba_postgres_port" -- "$0" "$@"
fi

if ! command -v argc >/dev/null 2>&1; then
  echo "Missing required tool: argc. devenv shell did not provide the expected environment." >&2
  exit 1
fi

devenv_with_postgres_port() {
  if [ -n "${MEMBA_POSTGRES_PORT:-}" ]; then
    devenv -O services.postgres.port:int "$MEMBA_POSTGRES_PORT" "$@"
  else
    devenv "$@"
  fi
}

start_services() {
  if pg_isready -h "$PGHOST" -p "$PGPORT" >/dev/null 2>&1; then
    return
  fi

  # Use devenv's process-compose backend directly. A previous run can leave
  # process-compose thinking postgres is "ready" even though the socket/port in
  # the current shell is not accepting connections, so reset stale processes
  # before starting on the free port selected for this shell.
  devenv_with_postgres_port processes down >/dev/null 2>&1 || true
  DEVENV_TUI=false devenv_with_postgres_port processes up --no-strict-ports -d postgres
  devenv_with_postgres_port processes wait --timeout 120

  if ! pg_isready -h "$PGHOST" -p "$PGPORT" >/dev/null 2>&1; then
    devenv_with_postgres_port processes logs -n 100 postgres >&2 || true
    echo "Postgres did not become ready at PGHOST=$PGHOST PGPORT=$PGPORT" >&2
    exit 1
  fi
}

# @cmd Start Postgres and the Phoenix web app
up() {
  start_services
  trap down EXIT
  (cd "$repo_root/web" && mix phx.server)
}

# @cmd Stop development services
down() {
  devenv_with_postgres_port processes down || true
}

precommit() {
  (cd "$repo_root/web" && mix precommit)
}

# @cmd Run the standard local quality gate with required services
ci() {
  start_services
  trap down EXIT
  precommit
}

# @cmd Run the standard local quality gate
check() {
  start_services
  trap down EXIT
  precommit
}

# @cmd Verify the Fabro sandbox runtime contract
sandbox_check() {
  export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"

  echo "== sandbox environment =="
  for name in HOME MIX_HOME HEX_HOME XDG_CACHE_HOME DEVENV_ROOT DEVENV_STATE DEVENV_PROFILE DEVENV_DOTFILE PGHOST PGPORT PGDATA; do
    eval "value=\${$name-}"
    printf '%s=%s\n' "$name" "$value"
  done

  for tool in devenv git pg_isready elixir mix node npm; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "Missing required sandbox tool: $tool" >&2
      exit 1
    fi
  done

  for name in HOME MIX_HOME HEX_HOME XDG_CACHE_HOME; do
    eval "dir=\${$name-}"
    if [ -z "$dir" ]; then
      echo "Missing runtime path: $name" >&2
      exit 1
    fi
    case "$dir" in
      /env|/env/*)
        echo "Runtime path $name points into stale/non-writable /env: $dir" >&2
        exit 1
        ;;
    esac
    mkdir -p "$dir"
    test -w "$dir"
    probe="$dir/.fabro-write-probe-$$"
    : > "$probe"
    rm -f "$probe"
  done

  start_services
  trap down EXIT

  echo "Starting test dependency compile smoke test..."
  (cd "$repo_root/web" && MIX_ENV=test mix deps.compile --force)

  echo "Sandbox runtime check passed."
}

# @cmd Run the acceptance test suite
acceptance() {
  (cd "$repo_root/acceptance-tests" && npm test -- "$@")
}

# @cmd Run Fabro workflow helpers
# @arg command![validate-plan|start|mark-merged|mark-merged-style|review] Helper command
# @arg args~ Arguments for the helper command
fabro() {
  local command_name="${1:-}"
  if [ $# -gt 0 ]; then
    shift
  fi

  case "$command_name" in
    validate-plan) _fabro_validate_plan "$@" ;;
    start) _fabro_start "$@" ;;
    mark-merged) _fabro_mark_merged "$@" ;;
    mark-merged-style) _fabro_mark_merged_style "$@" ;;
    review) _fabro_review "$@" ;;
    -h|--help|"")
      cat >&2 <<EOF
Usage: $0 fabro <command> [args]

Commands:
  validate-plan <plan_path>
  start <plan_path>
  mark-merged <plan_path> [branch] [main_ref]
  mark-merged-style <plan_path>
  review <branch> <plan_path> [base_ref_or_base_sha]
EOF
      ;;
    *)
      echo "Unknown Fabro helper command: $command_name" >&2
      echo "Run '$0 fabro --help' for usage." >&2
      exit 2
      ;;
  esac
}

_fabro_validate_plan() {
  local plan_path="${1:-}"
  if [ -z "$plan_path" ]; then
    echo "Usage: $0 fabro validate-plan <plan_path>" >&2
    exit 2
  fi
  (cd "$repo_root" && command fabro run .fabro/workflows/plan-validation/workflow.toml \
    -I plan_path="$plan_path" \
    --auto-approve)
}

_fabro_start() {
  local plan_path="${1:-}"
  if [ -z "$plan_path" ]; then
    echo "Usage: $0 fabro start <plan_path>" >&2
    exit 2
  fi
  (cd "$repo_root" && .fabro/workflows/scripts/iteration_status.py check-clear "$plan_path")
  (cd "$repo_root" && command fabro run .fabro/workflows/iteration-deliver/workflow.toml \
    -I plan_path="$plan_path" \
    -I mode=deliver)
}

_fabro_mark_merged() {
  local plan_path="${1:-}"
  local branch="${2:-}"
  local main_ref="${3:-origin/main}"

  if [ -z "$plan_path" ]; then
    echo "Usage: $0 fabro mark-merged <plan_path> [branch] [main_ref]" >&2
    exit 2
  fi

  case "$plan_path" in
    */plan.md) ;;
    *) echo "plan_path must end with /plan.md: $plan_path" >&2; exit 2 ;;
  esac

  local iteration_dir="${plan_path%/plan.md}"
  local implementation_path="$iteration_dir/implementation.md"
  local iteration_slug
  iteration_slug=$(basename "$iteration_dir")
  local iteration_number="${iteration_slug%%-*}"

  if [ ! -f "$repo_root/$plan_path" ]; then
    echo "Plan not found: $plan_path" >&2
    exit 1
  fi
  if [ ! -f "$repo_root/docs/iterations/README.md" ]; then
    echo "Iteration index not found: docs/iterations/README.md" >&2
    exit 1
  fi

  if [ -z "$branch" ] && [ -f "$repo_root/$implementation_path" ]; then
    branch=$(awk -F': *' '/^Branch:/ {print $2; exit}' "$repo_root/$implementation_path")
  fi
  if [ -z "$branch" ]; then
    echo "No branch supplied and no Branch: entry found in $implementation_path" >&2
    exit 1
  fi

  git -C "$repo_root" fetch origin >/dev/null 2>&1 || true

  local branch_commit main_commit
  if ! branch_commit=$(git -C "$repo_root" rev-parse --verify "$branch^{commit}" 2>/dev/null); then
    if ! branch_commit=$(git -C "$repo_root" rev-parse --verify "origin/$branch^{commit}" 2>/dev/null); then
      echo "Could not resolve merged branch/ref: $branch" >&2
      exit 1
    fi
  fi
  if ! main_commit=$(git -C "$repo_root" rev-parse --verify "$main_ref^{commit}" 2>/dev/null); then
    echo "Could not resolve main ref: $main_ref" >&2
    exit 1
  fi
  if ! git -C "$repo_root" merge-base --is-ancestor "$branch_commit" "$main_commit"; then
    echo "Refusing to mark merged: $branch ($branch_commit) is not an ancestor of $main_ref ($main_commit)." >&2
    exit 1
  fi

  python3 - "$repo_root" "$plan_path" "$implementation_path" "$iteration_number" <<'PY'
import pathlib
import re
import sys

repo = pathlib.Path(sys.argv[1])
plan_path = repo / sys.argv[2]
implementation_path = repo / sys.argv[3]
iteration_number = sys.argv[4]
readme_path = repo / "docs/iterations/README.md"


def replace_status_line(path):
    text = path.read_text()
    if re.search(r"^Status: .*$", text, flags=re.MULTILINE):
        text = re.sub(r"^Status: .*$", "Status: merged", text, count=1, flags=re.MULTILINE)
    else:
        text = text.rstrip() + "\nStatus: merged\n"
    path.write_text(text)

replace_status_line(plan_path)
if implementation_path.exists():
    replace_status_line(implementation_path)
else:
    implementation_path.write_text("# Implementation\n\nStatus: merged\n")

readme = readme_path.read_text()
pattern = re.compile(rf"^(\|\s*{re.escape(iteration_number)}\s*\|\s*[^|]+\|\s*)[^|]+(\|.*)$", re.MULTILINE)
readme, count = pattern.subn(r"\1merged\2", readme, count=1)
if count != 1:
    raise SystemExit(f"Could not find iteration {iteration_number} row in docs/iterations/README.md")
readme_path.write_text(readme)
PY

  echo "Marked iteration $iteration_number as merged in:"
  echo "- docs/iterations/README.md"
  echo "- $plan_path"
  echo "- $implementation_path"
}

_fabro_mark_merged_style() {
  local plan_path="${1:-}"

  if [ -z "$plan_path" ]; then
    echo "Usage: $0 fabro mark-merged-style <plan_path>" >&2
    exit 2
  fi

  case "$plan_path" in
    */plan.md) ;;
    *) echo "plan_path must end with /plan.md: $plan_path" >&2; exit 2 ;;
  esac

  local iteration_dir="${plan_path%/plan.md}"
  local implementation_path="$iteration_dir/implementation.md"
  local iteration_slug
  iteration_slug=$(basename "$iteration_dir")
  local iteration_number="${iteration_slug%%-*}"

  if [ ! -f "$repo_root/$plan_path" ]; then
    echo "Plan not found: $plan_path" >&2
    exit 1
  fi
  if [ ! -f "$repo_root/docs/iterations/README.md" ]; then
    echo "Iteration index not found: docs/iterations/README.md" >&2
    exit 1
  fi

  python3 - "$repo_root" "$plan_path" "$implementation_path" "$iteration_number" <<'PY'
import pathlib
import re
import sys

repo = pathlib.Path(sys.argv[1])
plan_path = repo / sys.argv[2]
implementation_path = repo / sys.argv[3]
iteration_number = sys.argv[4]
readme_path = repo / "docs/iterations/README.md"


def replace_status_line(path):
    text = path.read_text()
    if re.search(r"^Status: .*$", text, flags=re.MULTILINE):
        text = re.sub(r"^Status: .*$", "Status: merged", text, count=1, flags=re.MULTILINE)
    else:
        text = text.rstrip() + "\nStatus: merged\n"
    path.write_text(text)

replace_status_line(plan_path)
if implementation_path.exists():
    replace_status_line(implementation_path)
else:
    implementation_path.write_text("# Implementation\n\nStatus: merged\n")

readme = readme_path.read_text()
pattern = re.compile(rf"^(\|\s*{re.escape(iteration_number)}\s*\|\s*[^|]+\|\s*)[^|]+(\|.*)$", re.MULTILINE)
readme, count = pattern.subn(r"\1merged\2", readme, count=1)
if count != 1:
    raise SystemExit(f"Could not find iteration {iteration_number} row in docs/iterations/README.md")
readme_path.write_text(readme)
PY

  echo "Marked iteration $iteration_number as merged-style in:"
  echo "- docs/iterations/README.md"
  echo "- $plan_path"
  echo "- $implementation_path"
}

_fabro_review() {
  local branch="${1:-}"
  local plan_path="${2:-}"
  local base_ref_or_base_sha="${3:-}"

  if [ -z "$branch" ] || [ -z "$plan_path" ]; then
    echo "Usage: $0 fabro review <branch> <plan_path> [base_ref_or_base_sha]" >&2
    exit 2
  fi

  if ! type -P fabro >/dev/null 2>&1; then
    echo "Missing required tool: fabro" >&2
    exit 1
  fi

  git -C "$repo_root" fetch origin

  local ref="$branch"
  local review_branch="$branch"
  local remote_branch=""

  if git -C "$repo_root" rev-parse --verify --quiet "refs/remotes/$branch^{commit}" >/dev/null; then
    remote_branch="${branch#origin/}"
    review_branch="$remote_branch"
    ref="$review_branch"
  elif git -C "$repo_root" rev-parse --verify --quiet "refs/remotes/origin/$branch^{commit}" >/dev/null; then
    remote_branch="$branch"
    review_branch="$branch"
    ref="$review_branch"
  elif git -C "$repo_root" rev-parse --verify --quiet "refs/heads/$branch^{commit}" >/dev/null; then
    review_branch="$branch"
    ref="$review_branch"
  elif git -C "$repo_root" rev-parse --verify --quiet "${branch}^{commit}" >/dev/null; then
    echo "Resolved $branch as a commit, tag, or detached ref, but fabro review needs a remote branch Fabro can clone." >&2
    echo "Create and push a review branch first, then retry: git branch <branch-name> $branch && git push -u origin <branch-name>" >&2
    exit 1
  else
    echo "Could not resolve branch/ref: $branch" >&2
    exit 1
  fi

  if [ -n "$remote_branch" ]; then
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$review_branch"; then
      local branch_worktree
      branch_worktree=$(git -C "$repo_root" branch --format='%(worktreepath)' --list "$review_branch")
      if [ -n "$branch_worktree" ]; then
        echo "Local review branch is already checked out: $review_branch at $branch_worktree" >&2
        echo "Run '$0 fabro review' with that branch name, or remove the existing worktree before reviewing the remote ref." >&2
        exit 1
      fi
      git -C "$repo_root" branch --set-upstream-to="origin/$remote_branch" "$review_branch" >/dev/null 2>&1 || true
      git -C "$repo_root" branch --force "$review_branch" "origin/$remote_branch"
    else
      git -C "$repo_root" branch --track "$review_branch" "origin/$remote_branch"
    fi
  fi

  local safe_branch
  safe_branch=$(printf '%s' "$review_branch" | tr '/:' '--' | tr -cd 'A-Za-z0-9._-')

  local worktree_parent="${MEMBA_REVIEW_WORKTREE_ROOT:-$(dirname "$repo_root")}"
  local worktree="$worktree_parent/memba-review-$safe_branch"

  if [ -e "$worktree" ]; then
    echo "Review worktree already exists: $worktree" >&2
    echo "Remove it with: git worktree remove $worktree" >&2
    exit 1
  fi

  git -C "$repo_root" worktree add "$worktree" "$ref"

  local worktree_branch
  worktree_branch=$(git -C "$worktree" branch --show-current)
  if [ -z "$worktree_branch" ]; then
    echo "Review worktree is detached; Fabro would try to clone branch HEAD." >&2
    echo "Requested ref: $branch" >&2
    echo "Resolved ref: $ref" >&2
    echo "HEAD: $(git -C "$worktree" rev-parse HEAD)" >&2
    git -C "$repo_root" worktree remove "$worktree"
    exit 1
  fi

  local base_sha
  if [ -z "$base_ref_or_base_sha" ]; then
    if ! base_sha=$(git -C "$worktree" rev-parse 'HEAD~1^{commit}' 2>/dev/null); then
      echo "Could not infer review base SHA from HEAD~1 for review branch $worktree_branch" >&2
      echo "Pass an explicit base SHA when reviewing a branch that is not a single squashed iteration commit." >&2
      git -C "$repo_root" worktree remove "$worktree"
      exit 1
    fi
  elif [[ "$base_ref_or_base_sha" =~ ^[0-9a-fA-F]{40}$ ]] && git -C "$worktree" cat-file -e "$base_ref_or_base_sha^{commit}" 2>/dev/null; then
    base_sha="$base_ref_or_base_sha"
  else
    if ! git -C "$worktree" rev-parse --verify --quiet "$base_ref_or_base_sha^{commit}" >/dev/null; then
      git -C "$worktree" fetch origin >/dev/null 2>&1 || true
    fi
    if ! base_sha=$(git -C "$worktree" merge-base HEAD "$base_ref_or_base_sha" 2>/dev/null); then
      echo "Could not resolve base SHA from $base_ref_or_base_sha for review branch $worktree_branch" >&2
      echo "Pass an explicit base SHA, or ensure the base ref is visible in the review worktree." >&2
      git -C "$worktree" log --oneline --decorate --max-count=30 --all >&2 || true
      git -C "$repo_root" worktree remove "$worktree"
      exit 1
    fi
  fi

  echo "Running iteration review in isolated worktree: $worktree"
  echo "Review branch: $worktree_branch"
  echo "Review HEAD: $(git -C "$worktree" rev-parse HEAD)"
  echo "Review upstream: $(git -C "$worktree" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  echo "Review base input: $base_ref_or_base_sha"
  echo "Review base sha: $base_sha"
  (
    cd "$worktree"
    command fabro run "$repo_root/.fabro/workflows/iteration-review/workflow.toml" \
      -I "plan_path=$plan_path" \
      -I "base_sha=$base_sha"
  )
}

eval "$(argc --argc-eval "$0" "$@")"
