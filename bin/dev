#!/usr/bin/env bash
# @describe Memba development commands

set -euo pipefail

if ! command -v argc >/dev/null 2>&1; then
  exec devenv shell -- "$0" "$@"
fi

# @cmd Start development services
up() {
  devenv processes up postgres
}

# @cmd Start the Phoenix web app
web() {
  (cd web && mix phx.server)
}

# @cmd Run the standard local quality gate
check() {
  (cd web && mix precommit)
}

# @cmd Run the acceptance test suite
acceptance() {
  (cd acceptance-tests && npm test -- "$@")
}

eval "$(argc --argc-eval "$0" "$@")"
