#!/usr/bin/env bash
# @describe Memba development commands

set -euo pipefail

have_devenv=0
if command -v devenv >/dev/null 2>&1; then
  have_devenv=1
fi

if ! command -v argc >/dev/null 2>&1 && [ "$have_devenv" -eq 1 ]; then
  exec devenv shell -- "$0" "$@"
fi

# @cmd Start development services
up() {
  if [ "$have_devenv" -eq 1 ]; then
    DEVENV_TUI=false devenv up -d postgres
    devenv processes wait --timeout 120
  else
    echo "devenv not found; skipping service startup" >&2
  fi
}

# @cmd Stop development services
down() {
  if [ "$have_devenv" -eq 1 ]; then
    devenv processes down
  fi
}

# @cmd Run the standard local quality gate with required services
ci() {
  up
  trap down EXIT
  check
}

# @cmd Start the Phoenix web app
web() {
  (cd web && mix phx.server)
}

# @cmd Run the standard local quality gate
check() {
  (cd web && mix precommit)
}

# @cmd Run the acceptance test suite
acceptance() {
  (cd acceptance-tests && npm test -- "$@")
}

if command -v argc >/dev/null 2>&1; then
  eval "$(argc --argc-eval "$0" "$@")"
else
  usage() {
    cat <<'EOF'
Usage: dev <command>

Commands:
  up
  down
  ci
  web
  check
  acceptance
EOF
  }

  cmd="${1:-}"
  shift || true

  case "$cmd" in
    up) up "$@" ;;
    down) down "$@" ;;
    ci) ci "$@" ;;
    web) web "$@" ;;
    check) check "$@" ;;
    acceptance) acceptance "$@" ;;
    -h|--help|help|"") usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
fi
