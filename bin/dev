#!/usr/bin/env bash
# @describe Memba development commands

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
default_postgres_port_value=15432

default_postgres_port() {
  printf '%s\n' "${MEMBA_POSTGRES_PORT:-$default_postgres_port_value}"
}

devenv_with_postgres_port() {
  (
    cd "$repo_root"

    if [ -n "${MEMBA_POSTGRES_PORT:-}" ] && [ "$MEMBA_POSTGRES_PORT" != "$default_postgres_port_value" ]; then
      devenv -O services.postgres.port:int "$MEMBA_POSTGRES_PORT" "$@"
    else
      devenv "$@"
    fi
  )
}

load_local_secrets() {
  if [ -f "$repo_root/.local/secrets.envrc" ]; then
    # shellcheck source=/dev/null
    source "$repo_root/.local/secrets.envrc"
  fi
}

configure_dev_up_email_provider() {
  # This is local development policy, not a secret. Keep provider selection out of
  # .local/secrets.envrc; that file should hold tokens and addresses only.
  export MEMBA_EMAIL_PROVIDER="${MEMBA_DEV_EMAIL_PROVIDER:-postmark}"
}

dev_support_processes() {
  printf '%s\n' postgres

  if [ "${MEMBA_DEV_NGROK:-1}" != "0" ]; then
    printf '%s\n' ngrok
  fi
}

process_phase() {
  DEVENV_TUI=false devenv_with_postgres_port processes status "$1" 2>/dev/null \
    | awk -F': *' '/^Phase:/ {print $2; exit}'
}

wait_for_managed_processes() {
  local timeout="$1"
  shift
  local deadline=$((SECONDS + timeout))
  local process_name phase waiting_for

  while true; do
    waiting_for=()

    for process_name in "$@"; do
      phase="$(process_phase "$process_name")"
      case "$phase" in
        ready|running)
          ;;
        exited|failed|stopped)
          echo "Process '$process_name' exited before becoming ready." >&2
          DEVENV_TUI=false devenv_with_postgres_port processes logs -n 80 "$process_name" >&2 || true
          return 1
          ;;
        *)
          waiting_for+=("$process_name${phase:+ ($phase)}")
          ;;
      esac
    done

    if [ "${#waiting_for[@]}" -eq 0 ]; then
      return 0
    fi

    if [ "$SECONDS" -ge "$deadline" ]; then
      echo "Timed out waiting for managed process(es): ${waiting_for[*]}" >&2
      for process_name in "$@"; do
        DEVENV_TUI=false devenv_with_postgres_port processes status "$process_name" >&2 || true
      done
      return 1
    fi

    sleep 1
  done
}

stop_orphaned_ngrok_dev_tunnels() {
  local target="${MEMBA_NGROK_TARGET:-4000}"
  local pids=()
  local pid

  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    pids+=("$pid")
  done < <(
    python3 - "$target" <<'PY'
import shlex
import subprocess
import sys

target = sys.argv[1]
ps = subprocess.run(
    ["ps", "-axo", "pid=,command="],
    check=True,
    text=True,
    stdout=subprocess.PIPE,
)

for line in ps.stdout.splitlines():
    line = line.strip()
    if not line:
        continue
    pid, _, command = line.partition(" ")
    if not pid.isdigit() or "ngrok" not in command or "http" not in command:
        continue
    try:
        args = shlex.split(command)
    except ValueError:
        args = command.split()
    if len(args) < 3:
        continue
    executable = args[0].split("/")[-1]
    if executable != "ngrok" or args[1] != "http":
        continue
    tunnel_targets = [arg for arg in args[2:] if not arg.startswith("-")]
    if target in tunnel_targets:
        print(pid)
        continue
    if target.isdigit():
        target_patterns = {
            f"localhost:{target}",
            f"127.0.0.1:{target}",
            f"http://localhost:{target}",
            f"http://127.0.0.1:{target}",
            f"https://localhost:{target}",
            f"https://127.0.0.1:{target}",
        }
        if any(candidate in tunnel_targets for candidate in target_patterns):
            print(pid)
PY
  )

  if [ "${#pids[@]}" -eq 0 ]; then
    return 0
  fi

  echo "Stopping orphaned ngrok tunnel(s) for Memba dev target $target: ${pids[*]}"
  kill "${pids[@]}" 2>/dev/null || true
  sleep 1

  for pid in "${pids[@]}"; do
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true
    fi
  done
}

force_stop_dev_leftovers() {
  stop_orphaned_ngrok_dev_tunnels
}

start_managed_processes() {
  if DEVENV_TUI=false devenv_with_postgres_port processes up --no-strict-ports -d "$@"; then
    return
  fi

  devenv_with_postgres_port processes list >/dev/null

  for process_name in "$@"; do
    if devenv_with_postgres_port processes status "$process_name" 2>/dev/null | grep -Eq '\b(ready|running|starting)\b'; then
      continue
    fi

    start_output="$(devenv_with_postgres_port processes start "$process_name" 2>&1)" || {
      if grep -q "already running" <<<"$start_output"; then
        continue
      fi

      if grep -q "not found" <<<"$start_output"; then
        devenv_with_postgres_port processes down || true
        DEVENV_TUI=false devenv_with_postgres_port processes up --no-strict-ports -d "$@"
        return
      fi

      printf '%s\n' "$start_output" >&2
      return 1
    }
  done
}

current_ngrok_url() {
  local api_url="${MEMBA_NGROK_API_URL:-http://127.0.0.1:4040/api/tunnels}"
  local attempts=30
  local url=""

  while [ "$attempts" -gt 0 ]; do
    url=$(curl -fsS "$api_url" 2>/dev/null \
      | jq -r '.tunnels[]? | select(.proto == "https") | .public_url' \
      | head -n 1 || true)

    if [ -n "$url" ] && [ "$url" != "null" ]; then
      printf '%s\n' "$url"
      return 0
    fi

    attempts=$((attempts - 1))
    sleep 1
  done

  return 1
}

sync_postmark_dev_webhooks() {
  if [ "${MEMBA_DEV_POSTMARK_WEBHOOK_SYNC:-1}" = "0" ]; then
    return 0
  fi

  if [ "${MEMBA_DEV_NGROK:-1}" = "0" ]; then
    return 0
  fi

  if [ "${MEMBA_EMAIL_PROVIDER:-}" != "postmark" ]; then
    return 0
  fi

  local server_token="${MEMBA_POSTMARK_SERVER_TOKEN:-}"
  local account_token="${POSTMARK_ACCOUNT_TOKEN:-}"

  if [ -z "$server_token" ] || [ -z "$account_token" ]; then
    echo "Skipping Postmark dev webhook sync: missing Postmark server/account token."
    return 0
  fi

  local ngrok_url
  if ! ngrok_url=$(current_ngrok_url); then
    echo "Skipping Postmark dev webhook sync: ngrok URL not available."
    return 0
  fi

  mkdir -p "$repo_root/.local"
  printf '%s\n' "$ngrok_url" > "$repo_root/.local/ngrok-url"

  local base_url="${POSTMARK_BASE_URL:-https://api.postmarkapp.com}"
  local server_json server_id server_name server_color inbound_domain
  server_json=$(curl -fsS \
    -H "X-Postmark-Server-Token: $server_token" \
    -H "Accept: application/json" \
    "$base_url/server")
  server_id=$(printf '%s' "$server_json" | jq -r '.ID')
  server_name=$(printf '%s' "$server_json" | jq -r '.Name')
  server_color=$(printf '%s' "$server_json" | jq -r '.Color // "purple"')
  inbound_domain="${MEMBA_CLUB_INBOUND_EMAIL_DOMAIN:-}"

  if [ -z "$inbound_domain" ]; then
    inbound_domain=$(printf '%s' "$server_json" | jq -r '.InboundDomain // ""')
  fi

  if ! printf '%s' "$server_name" | grep -Eiq 'dev|local'; then
    echo "Skipping Postmark dev webhook sync: server '$server_name' does not look like a dev/local server."
    return 0
  fi

  local delivery_url="$ngrok_url/webhooks/postmark"
  local inbound_url="$ngrok_url/webhooks/postmark/inbound"
  local webhooks_json webhook_id
  webhooks_json=$(curl -fsS \
    -H "X-Postmark-Server-Token: $server_token" \
    -H "Accept: application/json" \
    "$base_url/webhooks")
  webhook_id=$(printf '%s' "$webhooks_json" \
    | jq -r '.Webhooks[]? | select(.MessageStream == "outbound" and (.Url | endswith("/webhooks/postmark"))) | .ID' \
    | head -n 1)

  jq -n --arg url "$delivery_url" '{
    Url: $url,
    MessageStream: "outbound",
    Triggers: {
      Delivery: {Enabled: true},
      Bounce: {Enabled: true, IncludeContent: false},
      SpamComplaint: {Enabled: true, IncludeContent: false},
      Open: {Enabled: false},
      Click: {Enabled: false}
    }
  }' > "$repo_root/.local/postmark-delivery-webhook.json"

  if [ -n "$webhook_id" ]; then
    curl -fsS -X PUT \
      -H "X-Postmark-Server-Token: $server_token" \
      -H "Accept: application/json" \
      -H "Content-Type: application/json" \
      "$base_url/webhooks/$webhook_id" \
      -d @"$repo_root/.local/postmark-delivery-webhook.json" >/dev/null
  else
    curl -fsS -X POST \
      -H "X-Postmark-Server-Token: $server_token" \
      -H "Accept: application/json" \
      -H "Content-Type: application/json" \
      "$base_url/webhooks" \
      -d @"$repo_root/.local/postmark-delivery-webhook.json" >/dev/null
  fi

  jq -n --arg name "$server_name" --arg color "$server_color" --arg inbound_domain "$inbound_domain" --arg inbound "$inbound_url" '{
    Name: $name,
    Color: $color,
    InboundDomain: $inbound_domain,
    InboundHookUrl: $inbound
  }' > "$repo_root/.local/postmark-server-webhook.json"

  curl -fsS -X PUT \
    -H "X-Postmark-Account-Token: $account_token" \
    -H "Accept: application/json" \
    -H "Content-Type: application/json" \
    "$base_url/servers/$server_id" \
    -d @"$repo_root/.local/postmark-server-webhook.json" >/dev/null

  rm -f "$repo_root/.local/postmark-delivery-webhook.json" "$repo_root/.local/postmark-server-webhook.json"
  echo "Synced Postmark dev webhooks for '$server_name' to $ngrok_url."
}


memba_postgres_port="$(default_postgres_port)"
export MEMBA_POSTGRES_PORT="$memba_postgres_port"

case "${1:-}" in
  up)
    if [ "${2:-}" != "--foreground" ] && [ "${2:-}" != "-h" ] && [ "${2:-}" != "--help" ] && [ "$#" -le 1 ]; then
      # Start detached processes directly, not through a nested `devenv shell`,
      # so `devenv processes ...` can find the same process manager afterwards.
      load_local_secrets
      configure_dev_up_email_provider

      support_processes=()
      while IFS= read -r process_name; do
        support_processes+=("$process_name")
      done < <(dev_support_processes)

      start_managed_processes "${support_processes[@]}" web
      wait_for_managed_processes 120 postgres web
      sync_postmark_dev_webhooks
      exit 0
    fi
    ;;
  down)
    if [ "$#" -eq 1 ] || { [ "$#" -eq 2 ] && [ "${2:-}" = "--force" ]; }; then
      load_local_secrets
      devenv_with_postgres_port processes down || true
      if [ "${2:-}" = "--force" ]; then
        force_stop_dev_leftovers
      fi
      exit 0
    fi
    ;;
  restart)
    if [ "$#" -eq 1 ]; then
      devenv_with_postgres_port processes down || true
      load_local_secrets
      configure_dev_up_email_provider

      support_processes=()
      while IFS= read -r process_name; do
        support_processes+=("$process_name")
      done < <(dev_support_processes)

      start_managed_processes "${support_processes[@]}" web
      wait_for_managed_processes 120 postgres web
      sync_postmark_dev_webhooks
      exit 0
    fi
    ;;
esac

if [ "${MEMBA_DEVENV_SHELL:-}" != "1" ]; then
  devenv_shell_args=(shell)
  if [ "$memba_postgres_port" != "$default_postgres_port_value" ]; then
    devenv_shell_args+=(-O services.postgres.port:int "$memba_postgres_port")
  fi

  exec env \
    -u DEVENV_DOTFILE \
    -u DEVENV_PROFILE \
    -u DEVENV_ROOT \
    -u DEVENV_STATE \
    -u DEVENV_TASKS \
    -u DEVENV_TASK_FILE \
    -u PGDATA \
    -u PGHOST \
    -u PGPORT \
    MEMBA_DEVENV_SHELL=1 \
    MEMBA_POSTGRES_PORT="$memba_postgres_port" \
    devenv "${devenv_shell_args[@]}" -- "$0" "$@"
fi

if ! command -v argc >/dev/null 2>&1; then
  echo "Missing required tool: argc. devenv shell did not provide the expected environment." >&2
  exit 1
fi

start_postgres() {
  if devenv_with_postgres_port processes status postgres >/dev/null 2>&1; then
    return
  fi

  DEVENV_TUI=false devenv_with_postgres_port processes up --no-strict-ports -d postgres
  wait_for_managed_processes 120 postgres
}

migrate_databases() {
  (
    cd "$repo_root/web"

    mix dev.setup
  )
}

start_processes() {
  start_managed_processes "$@"
}

gallery_server_reachable() {
  python3 - <<'PY'
import sys
import urllib.request

try:
    with urllib.request.urlopen("http://127.0.0.1:4000/", timeout=2) as response:
        status = response.status
except Exception:
    sys.exit(1)

sys.exit(0 if status < 500 else 1)
PY
}

wait_for_gallery_server() {
  local timeout="${1:-90}"
  local deadline=$((SECONDS + timeout))

  while true; do
    if gallery_server_reachable; then
      return 0
    fi

    if [ "$SECONDS" -ge "$deadline" ]; then
      echo "Timed out waiting for Phoenix at http://localhost:4000/." >&2
      return 1
    fi

    sleep 1
  done
}

start_gallery_server() {
  mkdir -p "$repo_root/tmp/gallery"
  echo "Building assets before starting Phoenix..."
  (cd "$repo_root/web" && MIX_ENV=dev mix assets.build)

  echo "Starting Phoenix at http://localhost:4000/ for gallery walk..."
  (
    cd "$repo_root/web"
    exec env MIX_ENV=dev mix phx.server
  ) > "$repo_root/tmp/gallery/phoenix-server.log" 2>&1 &
  gallery_server_pid=$!

  if ! wait_for_gallery_server 90; then
    echo "Phoenix server log:" >&2
    tail -n 120 "$repo_root/tmp/gallery/phoenix-server.log" >&2 || true
    return 1
  fi
}

stop_gallery_server() {
  if [ -z "${gallery_server_pid:-}" ]; then
    return 0
  fi

  kill "$gallery_server_pid" 2>/dev/null || true
  wait "$gallery_server_pid" 2>/dev/null || true
  python3 - <<'PY'
import os
import signal
import time

proc = "/proc"
if not os.path.isdir(proc):
    raise SystemExit(0)

current = {os.getpid(), os.getppid()}
matches = []

for entry in os.listdir(proc):
    if not entry.isdigit():
        continue

    pid = int(entry)
    if pid in current:
        continue

    try:
        with open(os.path.join(proc, entry, "cmdline"), "rb") as handle:
            command = handle.read().replace(b"\0", b" ").decode("utf-8", "ignore")
    except OSError:
        continue

    if "mix phx.server" in command or ("beam.smp" in command and "phx.server" in command):
        matches.append(pid)

for pid in matches:
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except PermissionError:
        pass

time.sleep(1)

for pid in matches:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        continue

    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except PermissionError:
        pass
PY
  pkill -f 'mix phx.server' 2>/dev/null || true
}

open_gallery_file() {
  local gallery_path="$repo_root/tmp/gallery/gallery.html"

  if command -v open >/dev/null 2>&1; then
    open "$gallery_path"
  else
    echo "Gallery written to: $gallery_path"
  fi
}


# @cmd Start Postgres, the optional ngrok tunnel, and the Phoenix web app
# @flag --foreground Keep Phoenix attached to the terminal instead of starting it as a managed background process
up() {
  load_local_secrets
  configure_dev_up_email_provider

  local support_processes=()
  while IFS= read -r process_name; do
    support_processes+=("$process_name")
  done < <(dev_support_processes)

  if [ "${argc_foreground:-0}" = "1" ]; then
    start_processes "${support_processes[@]}"
    wait_for_managed_processes 120 postgres
    sync_postmark_dev_webhooks
    migrate_databases
    trap down EXIT
    (cd "$repo_root/web" && mix phx.server)
  else
    start_processes "${support_processes[@]}" web
    wait_for_managed_processes 120 postgres web
    sync_postmark_dev_webhooks
  fi
}

# @cmd Stop development services
# @flag --force Also stop known local dev leftovers, such as orphaned ngrok tunnels to Phoenix
down() {
  load_local_secrets
  devenv_with_postgres_port processes down || true
  if [ "${argc_force:-0}" = "1" ]; then
    force_stop_dev_leftovers
  fi
}

# @cmd Stop and then start development services, waiting until they are ready
restart() {
  down
  up
}

local_test_email_env() {
  env \
    -u MEMBA_EMAIL_PROVIDER \
    -u MEMBA_POSTMARK_SERVER_TOKEN \
    -u MEMBA_RESEND_API_KEY \
    -u MEMBA_MESSAGING_FROM_ADDRESS \
    -u MEMBA_MESSAGING_REPLY_TO_ADDRESS \
    -u MEMBA_AUTH_EMAIL_FROM_ADDRESS \
    -u MEMBA_AUTH_EMAIL_MESSAGE_STREAM \
    -u MEMBA_RESEND_WEBHOOK_SIGNING_SECRET \
    -u MEMBA_CLUB_INBOUND_EMAIL_DOMAIN \
    -u MEMBA_DEV_EMAIL_PROVIDER \
    -u MEMBA_NGROK_DOMAIN \
    -u MEMBA_NGROK_TARGET \
    -u NGROK_AUTHTOKEN \
    -u POSTMARK_ACCOUNT_TOKEN \
    -u RESEND_ADMIN_API_KEY \
    -u RESEND_API_KEY \
    "$@"
}

quality_gate_lock_root() {
  printf '%s\n' "${MEMBA_QUALITY_GATE_LOCK_ROOT:-/tmp}"
}

quality_gate_lock_dir() {
  printf '%s/memba-quality-gate-postgres-%s.lock\n' "$(quality_gate_lock_root)" "$MEMBA_POSTGRES_PORT"
}

acquire_quality_gate_lock() {
  local lock_root lock_dir pid waited=0
  lock_root="$(quality_gate_lock_root)"
  lock_dir="$(quality_gate_lock_dir)"
  mkdir -p "$lock_root"

  while ! mkdir "$lock_dir" 2>/dev/null; do
    if [ ! -f "$lock_dir/pid" ]; then
      sleep 1
      if [ ! -f "$lock_dir/pid" ]; then
        echo "Removing incomplete dev quality gate lock with no pid file: $lock_dir" >&2
        rm -rf "$lock_dir"
        continue
      fi
    fi

    pid="$(cat "$lock_dir/pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      echo "Removing stale dev quality gate lock from pid $pid: $lock_dir" >&2
      rm -rf "$lock_dir"
      continue
    fi

    if [ "$waited" -eq 0 ]; then
      echo "Another dev quality gate is running; waiting for lock: $lock_dir" >&2
    elif [ $((waited % 30)) -eq 0 ]; then
      echo "Still waiting for dev quality gate lock after ${waited}s: $lock_dir" >&2
    fi

    sleep 1
    waited=$((waited + 1))
  done

  printf '%s\n' "$$" > "$lock_dir/pid"
  {
    printf 'pid=%s\n' "$$"
    printf 'started_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'command=%s\n' "$0 ${*:-}"
    printf 'repo=%s\n' "$repo_root"
    printf 'postgres_port=%s\n' "$MEMBA_POSTGRES_PORT"
  } > "$lock_dir/info"
}

release_quality_gate_lock() {
  rm -rf "$(quality_gate_lock_dir)"
}

with_quality_gate_lock() {
  local command_name="$1"
  shift

  if [ "${MEMBA_QUALITY_GATE_LOCK_HELD:-0}" = "1" ]; then
    "$command_name" "$@"
    return
  fi

  acquire_quality_gate_lock "$command_name" "$@"

  local status
  set +e
  MEMBA_QUALITY_GATE_LOCK_HELD=1 "$command_name" "$@"
  status=$?
  set -e

  release_quality_gate_lock
  return "$status"
}

precommit() {
  with_quality_gate_lock _precommit "$@"
}

_precommit() {
  (cd "$repo_root/web" && local_test_email_env mix precommit)
}

# @cmd Install local development and test dependencies
setup() {
  with_quality_gate_lock _setup "$@"
}

_setup() {
  if [ "${MEMBA_DEV_SETUP_DONE:-0}" = "1" ]; then
    return
  fi

  echo "Installing Hex..."
  mix local.hex --force

  echo "Installing Rebar..."
  mix local.rebar --force

  echo "Fetching web dependencies..."
  (cd "$repo_root/web" && mix deps.get)

  echo "Checking acceptance-test dependencies..."
  (
    cd "$repo_root/acceptance-tests"

    if [ ! -x node_modules/.bin/cucumber-js ] \
      || [ ! -x node_modules/.bin/playwright ] \
      || [ ! -f node_modules/.package-lock.json ] \
      || [ package-lock.json -nt node_modules/.package-lock.json ]; then
      npm ci
    else
      echo "Acceptance-test npm dependencies already installed."
    fi
  )

  export MEMBA_DEV_SETUP_DONE=1
}

# @cmd Run the standard local quality gate with required services
ci() {
  with_quality_gate_lock _ci "$@"
}

_ci() {
  start_postgres
  _setup
  precommit
  acceptance
}

# @cmd Run the standard local quality gate
# @flag --quick Skip browser acceptance for faster local loops
check() {
  with_quality_gate_lock _check "$@"
}

_check() {
  start_postgres
  _setup
  precommit

  if [ "${argc_quick:-0}" != "1" ]; then
    acceptance
  fi
}

dev_test() {
  with_quality_gate_lock _dev_test "$@"
}

_dev_test() {
  start_postgres
  _setup
  (cd "$repo_root/web" && local_test_email_env mix test "$@")
}

check_tracked_repo_file_writability() {
  python3 - "$repo_root" <<'PY'
import grp
import os
import pwd
import stat
import subprocess
import sys

repo_root = sys.argv[1]

result = subprocess.run(
    ["git", "-C", repo_root, "ls-files", "-z"],
    check=True,
    stdout=subprocess.PIPE,
)

checked = 0
unwritable = []

for raw_path in result.stdout.split(b"\0"):
    if not raw_path:
        continue

    relative_path = os.fsdecode(raw_path)
    absolute_path = os.path.join(repo_root, relative_path)

    try:
        file_stat = os.lstat(absolute_path)
    except FileNotFoundError:
        continue

    if not stat.S_ISREG(file_stat.st_mode):
        continue

    checked += 1

    if not os.access(absolute_path, os.W_OK):
        mode = stat.filemode(file_stat.st_mode)
        try:
            owner = pwd.getpwuid(file_stat.st_uid).pw_name
        except KeyError:
            owner = str(file_stat.st_uid)
        try:
            group = grp.getgrgid(file_stat.st_gid).gr_name
        except KeyError:
            group = str(file_stat.st_gid)
        unwritable.append((mode, owner, group, relative_path))

if checked == 0:
    print(
        "No tracked regular repository files were available for sandbox writability checks.",
        file=sys.stderr,
    )
    sys.exit(1)

if unwritable:
    current_uid = os.geteuid()
    current_gid = os.getegid()
    try:
        current_user = pwd.getpwuid(current_uid).pw_name
    except KeyError:
        current_user = str(current_uid)
    try:
        current_group = grp.getgrgid(current_gid).gr_name
    except KeyError:
        current_group = str(current_gid)

    print(
        "Tracked repository files are not writable by the sandbox shell user.",
        file=sys.stderr,
    )
    print(
        f"Current user: {current_user}:{current_group} ({current_uid}:{current_gid})",
        file=sys.stderr,
    )
    print("Unwritable tracked files (showing first 20):", file=sys.stderr)
    for mode, owner, group, relative_path in unwritable[:20]:
        print(f"  {mode} {owner}:{group} {relative_path}", file=sys.stderr)
    if len(unwritable) > 20:
        print(f"  ... and {len(unwritable) - 20} more", file=sys.stderr)
    print(
        "Fix the Fabro sandbox/provider so cloned or restored checkout files are owned "
        "by the same user that runs agent commands, then retry before product work starts.",
        file=sys.stderr,
    )
    sys.exit(1)

print(f"Tracked repository file writability OK ({checked} regular files checked).")
PY
}

# @cmd Verify the Fabro sandbox runtime contract
sandbox_check() {
  export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"

  echo "== sandbox environment =="
  for name in HOME MIX_HOME HEX_HOME XDG_CACHE_HOME DEVENV_ROOT DEVENV_STATE DEVENV_PROFILE DEVENV_DOTFILE PGHOST PGPORT PGDATA; do
    eval "value=\${$name-}"
    printf '%s=%s\n' "$name" "$value"
  done

  for tool in devenv git nix pg_isready elixir mix node npm python3; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "Missing required sandbox tool: $tool" >&2
      exit 1
    fi
  done

  check_tracked_repo_file_writability

  for name in HOME MIX_HOME HEX_HOME XDG_CACHE_HOME; do
    eval "dir=\${$name-}"
    if [ -z "$dir" ]; then
      echo "Missing runtime path: $name" >&2
      exit 1
    fi
    case "$dir" in
      /env|/env/*)
        echo "Runtime path $name points into stale/non-writable /env: $dir" >&2
        exit 1
        ;;
    esac
    mkdir -p "$dir"
    test -w "$dir"
    probe="$dir/.fabro-write-probe-$$"
    : > "$probe"
    rm -f "$probe"
  done

  _setup
  start_postgres

  echo "Starting test dependency compile smoke test..."
  (cd "$repo_root/web" && MIX_ENV=test mix deps.compile --force)

  echo "Sandbox runtime check passed."
}

