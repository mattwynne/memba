    GALLERY_BASE_URL=http://lvh.me:4000 node gallery/walk.js
  )

  node "$repo_root/acceptance-tests/gallery/build-gallery.js"
  open_gallery_file
  stop_gallery_server
  trap - EXIT
}

# @cmd Save/fetch local secrets in 1Password
# @arg command![set|save|fetch] Helper command
# @arg args~ Arguments for the helper command
secrets() {
  local command_name="${1:-}"
  if [ $# -gt 0 ]; then
    shift
  fi

  case "$command_name" in
    set) _secrets_set "$@" ;;
    save) _secrets_save ;;
    fetch) _secrets_fetch ;;
    -h|--help|"")
      cat >&2 <<EOF
Usage: $0 secrets <command> [args]

Commands:
  set <NAME> <VALUE>  Set a secret in .local/secrets.envrc and save to 1Password
  save                Save .local/secrets.envrc to 1Password
  fetch               Fetch .local/secrets.envrc from 1Password
EOF
      ;;
    *)
      echo "Unknown secrets command: $command_name" >&2
      echo "Run '$0 secrets --help' for usage." >&2
      exit 2
      ;;
  esac
}

_secrets_op() {
  if command -v op >/dev/null 2>&1; then
    op "$@"
  else
    NIXPKGS_ALLOW_UNFREE=1 nix run --impure nixpkgs#_1password-cli -- "$@"
  fi
}

_secrets_account() {
  printf '%s' "${MEMBA_SECRETS_1PASSWORD_ACCOUNT:-B3DE55IEORDQ7MF23S4TRTSQ5E}"
}

_secrets_vault() {
  printf '%s' "${MEMBA_SECRETS_1PASSWORD_VAULT:-Private}"
}

_secrets_item_title() {
  printf '%s' "${MEMBA_SECRETS_1PASSWORD_ITEM:-Memba local secrets.envrc}"
}

_secrets_set() {
  local name="${1:-}"
  local value="${2:-}"
  if [ $# -ne 2 ] || [ -z "$name" ]; then
    echo "Usage: $0 secrets set <NAME> <VALUE>" >&2
    exit 2
  fi
  if ! [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo "Secret name must be a valid shell variable name: $name" >&2
    exit 2
  fi

  local secrets_path="$repo_root/.local/secrets.envrc"
  mkdir -p "$repo_root/.local"
  touch "$secrets_path"
  chmod 600 "$secrets_path"

  if grep -q "^export ${name}=" "$secrets_path"; then
    local tmp
    tmp=$(mktemp)
    grep -v "^export ${name}=" "$secrets_path" > "$tmp" || true
    mv "$tmp" "$secrets_path"
    chmod 600 "$secrets_path"
  fi

  python3 - "$secrets_path" "$name" "$value" <<'PY'
import shlex
import sys
from pathlib import Path

path = Path(sys.argv[1])
name = sys.argv[2]
value = sys.argv[3]
replacement = f"export {name}={shlex.quote(value)}"
lines = path.read_text().splitlines()
if lines and lines[-1] != "":
    lines.append("")
lines.append(replacement)
path.write_text("\n".join(lines) + "\n")
PY

  _secrets_save
  echo "Set $name in .local/secrets.envrc and saved to 1Password."
}

_secrets_save() {
  local secrets_path="$repo_root/.local/secrets.envrc"
  if [ ! -f "$secrets_path" ]; then
    echo "Secrets file not found: $secrets_path" >&2
    exit 1
  fi

  local account vault title tmp item_id
  account="$(_secrets_account)"
  vault="$(_secrets_vault)"
  title="$(_secrets_item_title)"
  tmp=$(mktemp)
  trap 'rm -f "${tmp:-}"' RETURN

  python3 - "$secrets_path" "$title" > "$tmp" <<'PY'
import base64
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
title = sys.argv[2]
encoded = base64.b64encode(path.read_bytes()).decode("ascii")
print(json.dumps({
    "title": title,
    "category": "SECURE_NOTE",
    "fields": [
        {
            "id": "notesPlain",
            "type": "STRING",
            "purpose": "NOTES",
            "label": "notesPlain",
            "value": encoded,
        }
    ],
}))
PY

  item_id=$(_secrets_op item get "$title" --account "$account" --vault "$vault" --format json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' 2>/dev/null || true)

  if [ -n "$item_id" ]; then
    _secrets_op item edit "$item_id" --account "$account" --vault "$vault" --template "$tmp" >/dev/null
    echo "Saved .local/secrets.envrc to 1Password item '$title'."
  else
    _secrets_op item create --account "$account" --vault "$vault" --template "$tmp" >/dev/null
    echo "Created 1Password item '$title' from .local/secrets.envrc."
  fi
}

_secrets_fetch() {
  local secrets_path="$repo_root/.local/secrets.envrc"
  local account vault title tmp
  account="$(_secrets_account)"
  vault="$(_secrets_vault)"
  title="$(_secrets_item_title)"
  tmp=$(mktemp)
  trap 'rm -f "${tmp:-}"' RETURN

  _secrets_op item get "$title" --account "$account" --vault "$vault" --format json --reveal > "$tmp"
  mkdir -p "$repo_root/.local"
  python3 - "$tmp" "$secrets_path" <<'PY'
import base64
import json
import os
import sys
from pathlib import Path

item = json.load(open(sys.argv[1]))
encoded = None
for field in item.get("fields", []):
    if field.get("id") == "notesPlain" or field.get("purpose") == "NOTES":
        encoded = field.get("value")
        break
if not encoded:
    raise SystemExit("1Password item did not contain notesPlain secrets content")
path = Path(sys.argv[2])
path.write_bytes(base64.b64decode(encoded))
os.chmod(path, 0o600)
PY
  echo "Fetched .local/secrets.envrc from 1Password item '$title'."
}

# @cmd Run production smoke tests
# @arg args~ Extra arguments passed to cucumber-js
smoke_test() {
  load_local_secrets

  export MEMBA_SMOKE_STAFF_EMAIL="${MEMBA_SMOKE_STAFF_EMAIL:-test@memba.io}"
  export MEMBA_SMOKE_UNKNOWN_EMAIL="${MEMBA_SMOKE_UNKNOWN_EMAIL:-test+unknown@memba.io}"
  export MEMBA_SMOKE_STEP_TIMEOUT_MS="${MEMBA_SMOKE_STEP_TIMEOUT_MS:-900000}"
