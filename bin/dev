}

# @cmd Manage iteration lifecycle status
# @arg command![status|mark|check-clear|check-predecessors] Helper command
# @arg args~ Arguments for the helper command
iteration() {
  local command_name="${1:-}"
  if [ $# -gt 0 ]; then
    shift
  fi

  case "$command_name" in
    status)
      local plan_path="${1:-}"
      if [ -z "$plan_path" ]; then
        echo "Usage: $0 iteration status <plan_path>" >&2
        exit 2
      fi
      _fabro_plan_status "$plan_path"
      ;;
    mark)
      _iteration_status_tool mark "$@"
      ;;
    check-clear)
      _iteration_status_tool check-clear "$@"
      ;;
    check-predecessors)
      _iteration_status_tool check-predecessors "$@"
      ;;
    -h|--help|"")
      cat >&2 <<EOF
Usage: $0 iteration <command> [args]

Commands:
  status <plan_path>
  mark <plan_path> <status> [--check-clear-first]
  check-clear <plan_path> [--allow-same-iteration]
  check-predecessors <plan_path>
EOF
      ;;
    *)
      echo "Unknown iteration helper command: $command_name" >&2
      echo "Run '$0 iteration --help' for usage." >&2
      exit 2
      ;;
  esac
}

_iteration_status_tool() {
  (cd "$repo_root" && .fabro/workflows/scripts/iteration_status.py "$@")
}

# @cmd Run Fabro workflow helpers
# @arg command![validate-plan|deliver|review|pull-todo|progress|clean-branches] Helper command
# @arg args~ Arguments for the helper command
fabro() {
  local command_name="${1:-}"
  if [ $# -gt 0 ]; then
    shift
  fi

  case "$command_name" in
    validate-plan) _fabro_validate_plan "$@" ;;
    deliver) _fabro_deliver "$@" ;;
    review) _fabro_review "$@" ;;
    pull-todo) _fabro_pull_todo "$@" ;;
    progress) _fabro_progress "$@" ;;
    clean-branches) _fabro_clean_branches "$@" ;;
    -h|--help|"")
      cat >&2 <<EOF
Usage: $0 fabro <command> [args]

Commands:
  validate-plan <plan_path>
  deliver <plan_path> [--wait|--no-wait] [--poll-interval seconds]
  review <branch> <plan_path> [base_ref_or_base_sha]
  pull-todo <run_id> [plan_path] [destination]
  progress <run_id> [plan_path] [--watch] [--interval seconds]
  clean-branches [--force]
EOF
      ;;
    *)
      echo "Unknown Fabro helper command: $command_name" >&2
      echo "Run '$0 fabro --help' for usage." >&2
      exit 2
      ;;
  esac
}

_fabro_require_tool() {
  local tool="$1"
  if ! type -P "$tool" >/dev/null 2>&1; then
    echo "Missing required tool: $tool" >&2
    exit 1
  fi
}

_fabro_iteration_number() {
  local plan_path="$1"
  local iteration_dir="${plan_path%/plan.md}"
  local iteration_slug
  iteration_slug=$(basename "$iteration_dir")
  printf '%s' "${iteration_slug%%-*}"
}

_fabro_validate_plan() {
  local plan_path="${1:-}"
  if [ -z "$plan_path" ]; then
    echo "Usage: $0 fabro validate-plan <plan_path>" >&2
    exit 2
  fi
  _fabro_require_tool fabro
  (cd "$repo_root" && command fabro run .fabro/workflows/plan-validation/workflow.toml \
    -I plan_path="$plan_path" \
    --auto-approve)
}

_fabro_pull_todo() {
  local run_id="${1:-}"
  local plan_path=""
  local destination=""

  if [ "$run_id" = "-h" ] || [ "$run_id" = "--help" ] || [ -z "$run_id" ] || [ $# -gt 3 ]; then
    echo "Usage: $0 fabro pull-todo <run_id> [plan_path] [destination]" >&2
    echo "If plan_path is omitted, it is inferred from the run inputs." >&2
    echo "If destination is omitted, prints the sandbox todo.md to stdout." >&2
    exit 2
  fi

  if [ $# -ge 2 ]; then
    case "${2:-}" in
      */plan.md) plan_path="$2" ;;
      *) destination="$2" ;;
    esac
  fi
  if [ $# -eq 3 ]; then
    if [ -z "$plan_path" ]; then
      echo "A destination cannot be supplied as the third argument unless the second argument is a plan_path ending in /plan.md." >&2
      exit 2
    fi
    destination="$3"
  fi

  _fabro_require_tool fabro

  if [ -z "$plan_path" ]; then
    _fabro_require_tool jq
    plan_path=$(command fabro inspect "$run_id" --json \
      | jq -r 'if type == "array" then .[0] else . end | .run_spec.settings.run.inputs.plan_path // empty')
    if [ -z "$plan_path" ]; then
      echo "Could not infer plan_path from run inputs; pass it explicitly." >&2
      exit 1
    fi
  fi

  case "$plan_path" in
    */plan.md) ;;
    *) echo "plan_path must end with /plan.md: $plan_path" >&2; exit 2 ;;
  esac

  local todo_path="${plan_path%/plan.md}/todo.md"
  local sandbox_path="/workspace/memba/$todo_path"

  if [ -n "$destination" ]; then
    command fabro sandbox cp "$run_id:$sandbox_path" "$destination"
    return
  fi

  local tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/memba-fabro-todo.XXXXXX.md")
  if command fabro sandbox cp --quiet "$run_id:$sandbox_path" "$tmp"; then
    cat "$tmp"
    rm -f "$tmp"
  else
    local status=$?
    rm -f "$tmp"
    return "$status"
  fi
}

_fabro_render_progress() {
  local run_id="$1"
  local todo_file="$2"
  local run_url="$3"
  local total done remaining percent width filled bar next_task i linked_run

  _fabro_require_tool gum

  total=$(grep -E '^[[:space:]]*- \[[ xX]\]' "$todo_file" | wc -l | tr -d ' ')
  done=$(grep -E '^[[:space:]]*- \[[xX]\]' "$todo_file" | wc -l | tr -d ' ')
  next_task=$(grep -E '^[[:space:]]*- \[ \]' "$todo_file" | head -1 | sed -E 's/^[[:space:]]*- \[ \][[:space:]]+//')
  remaining=$((total - done))
  width=30
  if [ "$total" -eq 0 ]; then
    percent=100
    filled=0
  else
    percent=$(((done * 100 + total / 2) / total))
    filled=$(((done * width + total / 2) / total))
  fi

  bar=""
  i=0
  while [ "$i" -lt "$filled" ]; do
    bar="${bar}█"
    i=$((i + 1))
  done
  while [ "$i" -lt "$width" ]; do
    bar="${bar}░"
    i=$((i + 1))
  done

  linked_run=$(printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$run_url" "$run_id")
  gum style --bold --foreground 212 "Fabro run $linked_run"
  gum style --foreground 42 "Progress: [$bar] $done/$total (${percent}%)"
  gum style --foreground 245 "Remaining: $remaining"
  if [ -n "$next_task" ]; then
    gum style --foreground 214 "Next: $next_task"
  else
    gum style --foreground 214 "Next: all todo tasks are checked"
  fi
}

_fabro_progress() {
  local run_id="${1:-}"
  local plan_path=""
  local watch=0
  local interval=30

  if [ "$run_id" = "-h" ] || [ "$run_id" = "--help" ] || [ -z "$run_id" ]; then
    echo "Usage: $0 fabro progress <run_id> [plan_path] [--watch] [--interval seconds]" >&2
    echo "If plan_path is omitted, it is inferred from the run inputs." >&2
    exit 2
  fi
  if [ $# -gt 0 ]; then
    shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --watch) watch=1; shift ;;
      --interval)
        interval="${2:-}"
        if ! [[ "$interval" =~ ^[0-9]+$ ]] || [ "$interval" -lt 1 ]; then
          echo "--interval must be a positive integer number of seconds" >&2
          exit 2
        fi
        shift 2
        ;;
      */plan.md)
        if [ -n "$plan_path" ]; then
          echo "Only one plan_path may be supplied." >&2
          exit 2
        fi
        plan_path="$1"
        shift
        ;;
      *) echo "Unknown progress argument: $1" >&2; exit 2 ;;
    esac
  done

  if [ -z "$plan_path" ]; then
    _fabro_require_tool jq
    plan_path=$(command fabro inspect "$run_id" --json \
      | jq -r 'if type == "array" then .[0] else . end | .run_spec.settings.run.inputs.plan_path // empty')
    if [ -z "$plan_path" ]; then
      echo "Could not infer plan_path from run inputs; pass it explicitly." >&2
      exit 1
    fi
  fi

  local iteration_name
  iteration_name=$(basename "${plan_path%/plan.md}" | sed -E 's/^[0-9]+-//' | tr '-' ' ')

  local run_url
  run_url=$(command fabro inspect "$run_id" --json \
    | jq -r 'if type == "array" then .[0] else . end | .web_url // .url // empty')
  if [ -z "$run_url" ]; then
    run_url="https://fabro.home.wynne.family/runs/$run_id"
  fi

  local tmp status
  tmp=$(mktemp "${TMPDIR:-/tmp}/memba-fabro-progress.XXXXXX.md")
  while true; do
    _fabro_pull_todo "$run_id" "$plan_path" "$tmp" >/dev/null

    if [ "$watch" -eq 1 ]; then
      clear
      gum style --foreground 245 "Updated: $(date '+%Y-%m-%d %H:%M:%S') — polling every ${interval}s"
    fi
    gum style --bold --foreground 99 "Iteration: $iteration_name"
    _fabro_render_progress "$run_id" "$tmp" "$run_url"
    status=$?

    if [ "$watch" -ne 1 ] || [ "$status" -ne 0 ]; then
      rm -f "$tmp"
      return "$status"
    fi
    sleep "$interval"
  done
}

_fabro_plan_status() {
  local plan_path="$1"
  awk -F': *' '/^Status:/ {print tolower($2); exit}' "$repo_root/$plan_path"
}

_fabro_remote_wip_status() {
  local plan_path="$1"
  git -C "$repo_root" show origin/main:docs/iterations/README.md | python3 -c '
import re
import sys
from pathlib import Path

plan_path = Path(sys.argv[1])
exclude = plan_path.parent.name.split("-", 1)[0]
active_statuses = {"implementing", "ready-for-review", "in-review", "reviewing", "finalizing"}
active = []
for line in sys.stdin:
    if not line.startswith("|") or "[plan](" not in line:
        continue
    cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
    if len(cells) < 5 or cells[0] in {"---", "#"}:
        continue
    status = cells[2].lower()
    if status not in active_statuses or cells[0] == exclude:
        continue
    match = re.search(r"\[plan\]\(([^)]+)\)", cells[4])
    path = f"docs/iterations/{match.group(1)}" if match else ""
    active.append(f"- {cells[0]} {cells[3]} ({cells[2]}) {path}")
if active:
    print("Implementation WIP limit is occupied by active iteration(s):")
    print("\n".join(active))
    raise SystemExit(1)
print("Implementation WIP slot is clear on origin/main.")
' "$plan_path"
}

_fabro_wait_for_wip_slot() {
  local plan_path="$1"
  local poll_interval="$2"
  while true; do
    git -C "$repo_root" fetch origin >/dev/null
    if _fabro_remote_wip_status "$plan_path"; then
      return 0
    fi
    echo "Waiting ${poll_interval}s for implementation WIP slot to clear..."
    sleep "$poll_interval"
  done
}

_fabro_extract_run_id() {
  grep -Eo '[0-9A-Z]{26}' | head -1 || true
}

_fabro_inspect_status_kind() {
  local run_id="$1"

  command fabro inspect "$run_id" --json --no-upgrade-check \
    | jq -r 'if type == "array" then .[0] else . end | .status.kind // .status // .state // .outcome // empty'
}

_fabro_implementation_status_class() {
  local status_kind="$1"

  case "$(printf '%s' "$status_kind" | tr '[:upper:]' '[:lower:]')" in
    succeeded|success|completed|complete)
      printf '%s\n' succeeded
      ;;
    failed|failure|cancelled|canceled|timed_out|timeout)
      printf '%s\n' failed
      ;;
    running|queued|pending|created|starting|in_progress|active)
      printf '%s\n' active
      ;;
    *)
      printf '%s\n' unknown
      ;;
  esac
}

_fabro_print_implementation_recovery_commands() {
  local run_id="$1"
  local plan_path="$2"
  local poll_interval="$3"
  local quoted_run_id quoted_plan_path

  printf -v quoted_run_id '%q' "$run_id"
  printf -v quoted_plan_path '%q' "$plan_path"

  echo "Implementation run ID: $run_id" >&2
  echo "Monitor or recover with:" >&2
  echo "  fabro inspect $quoted_run_id --no-upgrade-check" >&2
  echo "  fabro events $quoted_run_id --no-upgrade-check" >&2
  echo "  fabro logs $quoted_run_id --no-upgrade-check" >&2
  echo "  $0 fabro progress $quoted_run_id $quoted_plan_path --watch --interval $poll_interval" >&2
}

_fabro_restore_status_after_failed_implementation() {
  local plan_path="$1"
  local previous_status="$2"
  local status_commit_sha="$3"
  local iteration_number="$4"

  echo "Implementation workflow failed; checking whether the WIP reservation can be rolled back..." >&2
  git -C "$repo_root" fetch origin >/dev/null
  local remote_sha
  remote_sha=$(git -C "$repo_root" rev-parse origin/main^{commit})
  if [ "$remote_sha" != "$status_commit_sha" ]; then
    echo "Not rolling back iteration status because origin/main moved from $status_commit_sha to $remote_sha." >&2
    echo "Inspect the run before changing lifecycle state manually." >&2
    return 0
  fi

  git -C "$repo_root" pull --ff-only origin main >/dev/null
  local current_status
  current_status=$(_fabro_plan_status "$plan_path")
  if [ "$current_status" != "implementing" ]; then
    echo "Not rolling back iteration status because current status is '$current_status', not 'implementing'." >&2
    return 0
  fi

  echo "Restoring iteration ${iteration_number} status to '$previous_status' after failed implementation launch." >&2
  "$0" iteration mark "$plan_path" "$previous_status"
  git -C "$repo_root" add -- "$plan_path" docs/iterations/README.md
  if ! git -C "$repo_root" diff --cached --quiet; then
    git -C "$repo_root" commit -m "iteration ${iteration_number}: restore ${previous_status} after failed implementation"
    git -C "$repo_root" push origin HEAD:main
  fi
}

_fabro_deliver() {
  local plan_path="${1:-}"
  if [ "$plan_path" = "-h" ] || [ "$plan_path" = "--help" ]; then
    echo "Usage: $0 fabro deliver <plan_path> [--wait|--no-wait] [--poll-interval seconds]" >&2
    exit 0
  fi
  if [ $# -gt 0 ]; then
    shift
  fi
  local wait_for_wip=1
  local poll_interval=60
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait) wait_for_wip=1; shift ;;
      --no-wait) wait_for_wip=0; shift ;;
      --poll-interval)
        poll_interval="${2:-}"
        if ! [[ "$poll_interval" =~ ^[0-9]+$ ]] || [ "$poll_interval" -lt 1 ]; then
          echo "--poll-interval must be a positive integer number of seconds" >&2
          exit 2
        fi
        shift 2
        ;;
      -h|--help|"")
        echo "Usage: $0 fabro deliver <plan_path> [--wait|--no-wait] [--poll-interval seconds]" >&2
        exit 0
        ;;
      *) echo "Unknown deliver option: $1" >&2; exit 2 ;;
    esac
  done
  if [ -z "$plan_path" ]; then
    echo "Usage: $0 fabro deliver <plan_path> [--wait|--no-wait] [--poll-interval seconds]" >&2
    exit 2
  fi
  case "$plan_path" in
    */plan.md) ;;
    *) echo "plan_path must end with /plan.md: $plan_path" >&2; exit 2 ;;
  esac

  _fabro_require_tool fabro
  _fabro_require_tool jq

  if [ ! -f "$repo_root/$plan_path" ]; then
    echo "Plan not found: $plan_path" >&2
    exit 1
  fi

  local current_branch
  current_branch=$(git -C "$repo_root" branch --show-current)
  if [ "$current_branch" != "main" ]; then
    echo "Delivery must be launched from the main branch; current branch is: ${current_branch:-detached HEAD}" >&2
    exit 1
  fi

  local status
  status=$(git -C "$repo_root" status --short)
  if [ -n "$status" ]; then
    echo "Delivery requires a clean working tree before it marks the iteration implementing." >&2
    printf '%s\n' "$status" >&2
    exit 1
  fi

  git -C "$repo_root" pull --ff-only origin main

  local plan_status
  plan_status=$(_fabro_plan_status "$plan_path")
  case "$plan_status" in
    validated)
      echo "== Plan already validated; skipping validation =="
      ;;
    ready)
      echo "== Validating iteration plan =="
      _fabro_validate_plan "$plan_path"
      git -C "$repo_root" pull --ff-only origin main
      plan_status=$(_fabro_plan_status "$plan_path")
      if [ "$plan_status" != "validated" ]; then
        echo "Plan validation completed, but $plan_path is now '$plan_status' rather than 'validated'." >&2
        exit 1
      fi
      ;;
    "")
      echo "Plan status not found in $plan_path" >&2
      exit 1
      ;;
    *)
      echo "Plan must be ready or validated before delivery; current status is: $plan_status" >&2
      exit 1
      ;;
  esac

  echo "== Checking predecessor iterations =="
  "$0" iteration check-predecessors "$plan_path"

  echo "== Waiting for implementation WIP slot =="
  if [ "$wait_for_wip" -eq 1 ]; then
    _fabro_wait_for_wip_slot "$plan_path" "$poll_interval"
    git -C "$repo_root" pull --ff-only origin main
  else
    "$0" iteration check-clear "$plan_path" --allow-same-iteration
  fi

  local previous_plan_status="$plan_status"

  echo "== Reserving implementation WIP slot =="
  "$0" iteration check-clear "$plan_path" --allow-same-iteration
  "$0" iteration mark "$plan_path" implementing --check-clear-first

  local iteration_number
  iteration_number=$(_fabro_iteration_number "$plan_path")
  git -C "$repo_root" add -- "$plan_path" docs/iterations/README.md
  if ! git -C "$repo_root" diff --cached --quiet; then
    git -C "$repo_root" commit -m "iteration ${iteration_number}: mark implementing"
    git -C "$repo_root" push origin HEAD:main
  else
    echo "Iteration was already marked implementing; no status commit needed."
  fi

  git -C "$repo_root" fetch origin
  local base_sha
  base_sha=$(git -C "$repo_root" rev-parse origin/main^{commit})
  echo "Review base SHA: $base_sha"

  echo "== Starting implementation workflow =="
  local implementation_output implementation_create_status implementation_run_id implementation_status_kind implementation_status_class
  implementation_output="$({
    cd "$repo_root" && command fabro run .fabro/workflows/iteration-implementation/workflow.toml \
      -I plan_path="$plan_path" \
      -I expected_source_head="$base_sha" \
      --auto-approve \
      --no-upgrade-check \
      -d
  } 2>&1)" || implementation_create_status=$?
  implementation_create_status=${implementation_create_status:-0}
  printf '%s\n' "$implementation_output"

  implementation_run_id=$(printf '%s\n' "$implementation_output" | _fabro_extract_run_id)
  if [ -n "$implementation_run_id" ]; then
    mkdir -p "$repo_root/.fabro/tmp"
    printf '%s\n' "$implementation_run_id" > "$repo_root/.fabro/tmp/iteration-implementation-run-id"
    _fabro_print_implementation_recovery_commands "$implementation_run_id" "$plan_path" "$poll_interval"
  fi

  if [ "$implementation_create_status" -ne 0 ]; then
    if [ -n "$implementation_run_id" ]; then
      implementation_status_kind=$(_fabro_inspect_status_kind "$implementation_run_id" 2>/dev/null || true)
      implementation_status_class=$(_fabro_implementation_status_class "$implementation_status_kind")
      case "$implementation_status_class" in
        succeeded)
          echo "Fabro launch failed locally, but remote implementation run $implementation_run_id is '${implementation_status_kind}'. Continuing to review." >&2
          implementation_create_status=0
          ;;
        failed)
          _fabro_restore_status_after_failed_implementation "$plan_path" "$previous_plan_status" "$base_sha" "$iteration_number"
          exit 1
          ;;
        active|unknown)
          echo "Not rolling back iteration status because Fabro returned run ID $implementation_run_id and its remote status is '${implementation_status_kind:-unknown}'." >&2
          _fabro_print_implementation_recovery_commands "$implementation_run_id" "$plan_path" "$poll_interval"
          exit 1
          ;;
      esac
    else
      _fabro_restore_status_after_failed_implementation "$plan_path" "$previous_plan_status" "$base_sha" "$iteration_number"
    fi
    if [ "$implementation_create_status" -ne 0 ]; then
      exit 1
    fi
  fi

  if [ -z "$implementation_run_id" ]; then
    echo "Could not determine the detached implementation run ID; refusing to continue." >&2
    _fabro_restore_status_after_failed_implementation "$plan_path" "$previous_plan_status" "$base_sha" "$iteration_number"
    exit 1
  fi

  echo "== Waiting for implementation workflow =="
  if ! command fabro wait "$implementation_run_id" --no-upgrade-check; then
    implementation_status_kind=$(_fabro_inspect_status_kind "$implementation_run_id" 2>/dev/null || true)
    implementation_status_class=$(_fabro_implementation_status_class "$implementation_status_kind")
    case "$implementation_status_class" in
      succeeded)
        echo "Fabro wait failed locally, but remote implementation run $implementation_run_id is '${implementation_status_kind}'. Continuing to review." >&2
        ;;
      failed)
        _fabro_restore_status_after_failed_implementation "$plan_path" "$previous_plan_status" "$base_sha" "$iteration_number"
        exit 1
        ;;
      active|unknown)
        echo "Fabro wait failed locally, but remote implementation run $implementation_run_id is '${implementation_status_kind:-unknown}'." >&2
        echo "Preserving implementation WIP state; inspect or monitor the remote run before changing lifecycle status." >&2
        _fabro_print_implementation_recovery_commands "$implementation_run_id" "$plan_path" "$poll_interval"
        exit 1
        ;;
    esac
  fi

  echo "== Running review workflow =="
  git -C "$repo_root" fetch origin
  _fabro_review origin/main "$plan_path" "$base_sha"
}

_fabro_review() {
  local branch="${1:-}"
  local plan_path="${2:-}"
  local base_ref_or_base_sha="${3:-}"

  if [ -z "$branch" ] || [ -z "$plan_path" ]; then
    echo "Usage: $0 fabro review <branch> <plan_path> [base_ref_or_base_sha]" >&2
    exit 2
  fi

  _fabro_require_tool fabro

  git -C "$repo_root" fetch origin

  local ref="$branch"
  local review_branch="$branch"
  local remote_branch=""

  if git -C "$repo_root" rev-parse --verify --quiet "refs/remotes/$branch^{commit}" >/dev/null; then
    remote_branch="${branch#origin/}"
    review_branch="$remote_branch"
    ref="$review_branch"
  elif git -C "$repo_root" rev-parse --verify --quiet "refs/remotes/origin/$branch^{commit}" >/dev/null; then
    remote_branch="$branch"
    review_branch="$branch"
    ref="$review_branch"
  elif git -C "$repo_root" rev-parse --verify --quiet "refs/heads/$branch^{commit}" >/dev/null; then
    review_branch="$branch"
    ref="$review_branch"
  elif git -C "$repo_root" rev-parse --verify --quiet "${branch}^{commit}" >/dev/null; then
    echo "Resolved $branch as a commit, tag, or detached ref, but fabro review needs a remote branch Fabro can clone." >&2
    echo "Create and push a review branch first, then retry: git branch <branch-name> $branch && git push -u origin <branch-name>" >&2
    exit 1
  else
    echo "Could not resolve branch/ref: $branch" >&2
    exit 1
  fi

  if [ -n "$remote_branch" ]; then
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$review_branch"; then
      local branch_worktree
      branch_worktree=$(git -C "$repo_root" branch --format='%(worktreepath)' --list "$review_branch")
      if [ -n "$branch_worktree" ]; then
        review_branch="review/tmp/${remote_branch//\//-}-$(date +%Y%m%d%H%M%S)"
        ref="$review_branch"
        git -C "$repo_root" branch "$review_branch" "origin/$remote_branch"
        git -C "$repo_root" push -u origin "$review_branch"
      else
        git -C "$repo_root" branch --set-upstream-to="origin/$remote_branch" "$review_branch" >/dev/null 2>&1 || true
        git -C "$repo_root" branch --force "$review_branch" "origin/$remote_branch"
      fi
    else
      git -C "$repo_root" branch --track "$review_branch" "origin/$remote_branch"
    fi
  fi

  local safe_branch
  safe_branch=$(printf '%s' "$review_branch" | tr '/:' '--' | tr -cd 'A-Za-z0-9._-')

  local worktree_parent="${MEMBA_REVIEW_WORKTREE_ROOT:-$(dirname "$repo_root")}"
  local worktree="$worktree_parent/memba-review-$safe_branch"

  if [ -e "$worktree" ]; then
    echo "Review worktree already exists: $worktree" >&2
    echo "Remove it with: git worktree remove $worktree" >&2
    exit 1
  fi

  git -C "$repo_root" worktree add "$worktree" "$ref"

  local worktree_branch
  worktree_branch=$(git -C "$worktree" branch --show-current)
  if [ -z "$worktree_branch" ]; then
    echo "Review worktree is detached; Fabro would try to clone branch HEAD." >&2
    echo "Requested ref: $branch" >&2
    echo "Resolved ref: $ref" >&2
    echo "HEAD: $(git -C "$worktree" rev-parse HEAD)" >&2
    git -C "$repo_root" worktree remove "$worktree"
    exit 1
  fi

  local base_sha
  if [ -z "$base_ref_or_base_sha" ]; then
    if ! base_sha=$(git -C "$worktree" rev-parse 'HEAD~1^{commit}' 2>/dev/null); then
      echo "Could not infer review base SHA from HEAD~1 for review branch $worktree_branch" >&2
      echo "Pass an explicit base SHA when reviewing a branch that is not a single squashed iteration commit." >&2
      git -C "$repo_root" worktree remove "$worktree"
      exit 1
    fi
  elif [[ "$base_ref_or_base_sha" =~ ^[0-9a-fA-F]{40}$ ]] && git -C "$worktree" cat-file -e "$base_ref_or_base_sha^{commit}" 2>/dev/null; then
    base_sha="$base_ref_or_base_sha"
  else
    if ! git -C "$worktree" rev-parse --verify --quiet "$base_ref_or_base_sha^{commit}" >/dev/null; then
      git -C "$worktree" fetch origin >/dev/null 2>&1 || true
    fi
    if ! base_sha=$(git -C "$worktree" merge-base HEAD "$base_ref_or_base_sha" 2>/dev/null); then
      echo "Could not resolve base SHA from $base_ref_or_base_sha for review branch $worktree_branch" >&2
      echo "Pass an explicit base SHA, or ensure the base ref is visible in the review worktree." >&2
      git -C "$worktree" log --oneline --decorate --max-count=30 --all >&2 || true
      git -C "$repo_root" worktree remove "$worktree"
      exit 1
    fi
  fi

  echo "Running iteration review in isolated worktree: $worktree"
  echo "Review branch: $worktree_branch"
  echo "Review HEAD: $(git -C "$worktree" rev-parse HEAD)"
  echo "Review upstream: $(git -C "$worktree" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  echo "Review base input: $base_ref_or_base_sha"
  echo "Review base sha: $base_sha"
  (
    cd "$worktree"
    command fabro run "$repo_root/.fabro/workflows/iteration-review/workflow.toml" \
      -I "plan_path=$plan_path" \
      -I "base_sha=$base_sha" \
      --auto-approve
  )
}

_fabro_is_review_cleanup_candidate() {
  local name="$1"
  case "$name" in
    review/tmp/*) return 0 ;;
    review/main-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) return 0 ;;
    *) return 1 ;;
  esac
}

_fabro_clean_branches() {
  local force=0
  case "${1:-}" in
    --force) force=1 ;;
    -h|--help)
      echo "Usage: $0 fabro clean-branches [--force]" >&2
      echo "Dry-runs cleanup of safe temporary review branches unless --force is passed." >&2
      exit 0
      ;;
    "") ;;
    *) echo "Usage: $0 fabro clean-branches [--force]" >&2; exit 2 ;;
  esac

  git -C "$repo_root" fetch origin --prune

  local main_ref="origin/main"
  if ! git -C "$repo_root" rev-parse --verify --quiet "$main_ref^{commit}" >/dev/null; then
    echo "Could not resolve $main_ref; refusing to clean review branches." >&2
    exit 1
  fi

  local current_branch
  current_branch=$(git -C "$repo_root" branch --show-current || true)

  local cleaned=0 skipped=0
  echo "Scanning temporary review branches..."
  if [ "$force" -eq 0 ]; then
    echo "Dry run. Pass --force to delete the branches listed as safe."
  fi

  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    local branch_name="${ref#refs/remotes/origin/}"
    _fabro_is_review_cleanup_candidate "$branch_name" || continue

    local remote_ref="origin/$branch_name"
    if ! git -C "$repo_root" merge-base --is-ancestor "$remote_ref" "$main_ref"; then
      echo "skip remote $remote_ref: tip is not an ancestor of $main_ref"
      skipped=$((skipped + 1))
      continue
    fi

    local local_worktree=""
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch_name"; then
      local_worktree=$(git -C "$repo_root" branch --format='%(worktreepath)' --list "$branch_name")
    fi
    if [ -n "$local_worktree" ]; then
      echo "skip $branch_name: checked out at $local_worktree"
      skipped=$((skipped + 1))
      continue
    fi
    if [ "$current_branch" = "$branch_name" ]; then
      echo "skip $branch_name: current branch"
      skipped=$((skipped + 1))
      continue
    fi

    if [ "$force" -eq 1 ]; then
      git -C "$repo_root" push origin --delete "$branch_name"
      if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch_name"; then
        git -C "$repo_root" branch -D "$branch_name"
      fi
      echo "deleted $branch_name"
    else
      echo "would delete $branch_name"
    fi
    cleaned=$((cleaned + 1))
  done < <(git -C "$repo_root" for-each-ref --format='%(refname)' refs/remotes/origin/review)

  echo "Temporary review branch cleanup candidates: $cleaned; skipped: $skipped."
}

case "${1:-}" in
  test)
    shift
    dev_test "$@"
    exit
    ;;
esac

eval "$(argc --argc-eval "$0" "$@")"
